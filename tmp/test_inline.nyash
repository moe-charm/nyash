// inline test

static function MacroBoxSpec.expand(json) {
  local s, out, i, pat, plen, ins
  s = json
  out = ""
  i = 0
  pat = "\"kind\":\"Array\",\"elements\":["
  plen = pat.length()
  ins = "{\"kind\":\"Literal\",\"value\":{\"type\":\"int\",\"value\":0}}"
  loop(i < s.length()) {
    if i + plen <= s.length() && s.substring(i, i + plen) == pat {
      out = out + pat
      if i + plen < s.length() && s.substring(i + plen, i + plen + 1) != "]" {
        out = out + ins + ","
      } else {
        out = out + ins
      }
      i = i + plen
      continue
    }
    if i + 12 <= s.length() && s.substring(i, i + 12) == "\"elements\":[" {
      out = out + "\"elements\":["
      if i + 12 < s.length() && s.substring(i + 12, i + 13) != "]" {
        out = out + ins + ","
      } else {
        out = out + ins
      }
      i = i + 12
      continue
    }
    out = out + s.substring(i, i + 1)
    i = i + 1
  }
  return out
}

function main(args) {
  local j, r
  j = args.get(0)
  r = MacroBoxSpec.expand(j)
  print(r)
  return 0
}
