include "apps/selfhost-compiler/boxes/parser_box.hako"
include "apps/selfhost-compiler/boxes/emitter_box.hako"
static box Main {
  main(args) {
    local s = "// string_p0 – minimal example for JIT smoke (.hako)
static box Main {
  init { }
  main(args) {
    // Placeholder: do nothing, return 0
    return 0
  }
}

"
    local p = new ParserBox()
    p.stage3_enable(1)
    local json = p.parse_program2(s)
    local e = new EmitterBox()
    json = e.emit_program(json, "[]")
    print(json)
    return 0
  }
}
