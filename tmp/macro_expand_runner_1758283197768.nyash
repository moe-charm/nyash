// hang_macro.nyash
// Macro that never returns (infinite loop) to test timeout handling.

static box MacroBoxSpec {
  expand(json) {
    // Busy loop forever
    loop(true) {
      // do nothing
    }
    return json
  }
}


function main(args) {
    if args.length() == 0 { print("{}"); return 0 }
    local j, r
    j = args.get(0)
    r = MacroBoxSpec.expand(j)
    print(r)
    return 0
}
