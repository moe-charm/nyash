using json as JsonParserModule

static box Main {
  main() {
    // Minimal VM roundtrip for a single JSON value (null)
    local p = JsonParserModule.create_parser()
    local r = p.parse("null")
    if (r == null) {
      // Parser returned null (error path); print marker
      print("<parse:null>")
    } else {
      print(r.toString())
    }
    return 0
  }
}
