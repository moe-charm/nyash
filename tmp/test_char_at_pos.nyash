static box Main {
  main(args) {
    local json = "{\"kind\":\"Program\",\"statements\":[{\"kind\":\"Print\",\"expression\":{\"kind\":\"BinaryOp\",\"operator\":\"+\",\"left\":{\"kind\":\"Literal\",\"value\":{\"type\":\"int\",\"value\":12}},\"right\":{\"kind\":\"Literal\",\"value\":{\"type\":\"int\",\"value\":34}}}}]}"
    local k_v = "\"value\":"
    local opos = json.indexOf("\"operator\":\"+\"")
    local p1 = json.indexOf(k_v, opos) // fallback two-arg ignored, wrong; emulate below
    local tail1 = json.substring(opos, json.length())
    local rel1 = tail1.indexOf(k_v)
    p1 = opos + rel1
    local tail2 = json.substring(p1 + k_v.length(), json.length())
    local p2 = p1 + k_v.length() + tail2.indexOf(k_v)
    local idx = p2 + k_v.length()
    print(json.substring(idx, idx+1))
    return 0
  }
}
