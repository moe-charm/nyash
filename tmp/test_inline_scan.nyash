static box MiniJsonCur {
  read_digits_from(s, pos) {
    local out = ""
    local i = pos
    if i == null { return out }
    if i < 0 { return out }
    loop (true) {
      local ch = s.substring(i, i+1)
      if ch == "" { break }
      if ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" || ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9" {
        out = out + ch
        i = i + 1
      } else { break }
    }
    return out
  }
}
static box Main {
  main(args) {
    local json = "{\"kind\":\"Program\",\"statements\":[{\"kind\":\"Print\",\"expression\":{\"kind\":\"BinaryOp\",\"operator\":\"+\",\"left\":{\"kind\":\"Literal\",\"value\":{\"type\":\"int\",\"value\":12}},\"right\":{\"kind\":\"Literal\",\"value\":{\"type\":\"int\",\"value\":34}}}}]}"
    local bpos = json.indexOf("\"BinaryOp\"")
    print(bpos)
    local opos = json.indexOf("\"operator\":\"+\"")
    print(opos)
    local k_v = "\"value\":"
    // emulate index_of_from using substring tail
    local p1 = json.substring(opos, json.length()).indexOf(k_v)
    if p1 < 0 { print(-1)  return 0 }
    p1 = opos + p1
    print(p1)
    local cur = new MiniJsonCur()
    local d1 = cur.read_digits_from(json, p1 + k_v.length())
    print(d1)
    // next
    local tail2 = json.substring(p1 + k_v.length(), json.length())
    local p2_rel = tail2.indexOf(k_v)
    if p2_rel < 0 { print(-2)  return 0 }
    local p2 = p1 + k_v.length() + p2_rel
    print(p2)
    local d2 = cur.read_digits_from(json, p2 + k_v.length())
    print(d2)
    return 0
  }
}
