static box MiniVmTmp {
  index_of_from(hay, needle, pos) {
    local tail = hay.substring(pos, hay.length())
    local rel = tail.indexOf(needle)
    if rel < 0 { return -1 } else { return pos + rel }
  }
}
static box Main {
  main(args) {
    local json = "{\"kind\":\"Program\",\"statements\":[{\"kind\":\"Print\",\"expression\":{\"kind\":\"BinaryOp\",\"operator\":\"+\",\"left\":{\"kind\":\"Literal\",\"value\":{\"type\":\"int\",\"value\":12}},\"right\":{\"kind\":\"Literal\",\"value\":{\"type\":\"int\",\"value\":34}}}}]}"
    local vm = new MiniVmTmp()
    local bpos = json.indexOf("\"BinaryOp\"")
    print(bpos)
    local k_plus = "\"operator\":\"+\""
    local opos = vm.index_of_from(json, k_plus, bpos)
    print(opos)
    local k_v = "\"value\":"
    local p = opos
    p = vm.index_of_from(json, k_v, p)
    print(p)
    p = vm.index_of_from(json, k_v, p + k_v.length())
    print(p)
    local end1 = vm.index_of_from(json, "}", p)
    print(end1)
    local d1 = json.substring(p + k_v.length(), end1)
    print(d1)
    p = vm.index_of_from(json, k_v, p + k_v.length())
    print(p)
    p = vm.index_of_from(json, k_v, p + k_v.length())
    print(p)
    local end2 = vm.index_of_from(json, "}", p)
    print(end2)
    local d2 = json.substring(p + k_v.length(), end2)
    print(d2)
    return 0
  }
}
