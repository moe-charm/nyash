static box Main {
  main(args) {
    local json = "{\"kind\":\"Program\",\"statements\":[{\"kind\":\"Print\",\"expression\":{\"kind\":\"BinaryOp\",\"operator\":\"+\",\"left\":{\"kind\":\"Literal\",\"value\":{\"type\":\"int\",\"value\":12}},\"right\":{\"kind\":\"Literal\",\"value\":{\"type\":\"int\",\"value\":34}}}}]}"
    local k_v = "\"value\":"
    local i = json.indexOf(k_v) + k_v.length()
    local j = json.indexOf("}", i)
    local d = json.substring(i, j)
    print(d)
    return 0
  }
}
