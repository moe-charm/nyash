static box Main {
  main(args) {
    local json = "{\"kind\":\"Program\",\"statements\":[{\"kind\":\"Print\",\"expression\":{\"kind\":\"BinaryOp\",\"operator\":\"+\",\"left\":{\"kind\":\"Literal\",\"value\":{\"type\":\"int\",\"value\":12}},\"right\":{\"kind\":\"Literal\",\"value\":{\"type\":\"int\",\"value\":34}}}}]}"
    local n = json.length()
    print(n)
    local pos = json.indexOf("\"expression\":{")
    print(pos)
    // emulate index_of_from for '{'
    local i0 = pos
    loop (i0 < n) { if json.substring(i0, i0+1) == "{" { break }  i0 = i0 + 1 }
    print(i0)
    // scan braces
    local depth = 0
    local i = i0
    loop (i < n) {
      local ch = json.substring(i, i+1)
      if ch == "{" { depth = depth + 1 }
      if ch == "}" {
        depth = depth - 1
        if depth == 0 { print(i)  break }
      }
      i = i + 1
    }
    return 0
  }
}
