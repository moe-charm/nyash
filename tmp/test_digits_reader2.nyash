static box MiniJsonCur {
  _is_digit(ch) { return ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" || ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9" }
  read_digits_from(s, pos) {
    local out = ""
    local i = pos
    if i == null { return out }
    if i < 0 { return out }
    loop (true) {
      local ch = s.substring(i, i+1)
      if ch == "" { break }
      if _is_digit(ch) { out = out + ch  i = i + 1 } else { break }
    }
    return out
  }
}
static box Main {
  main(args) {
    local s = "value\":12}"
    local pos = s.indexOf("\":") + 2
    local cur = new MiniJsonCur()
    local d = cur.read_digits_from(s, pos)
    print(d.length())
    print(d)
    return 0
  }
}
