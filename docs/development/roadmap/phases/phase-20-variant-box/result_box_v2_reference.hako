// result_box_v2_reference.hako — Result<T,E> Box 完全実装（参照用）
// Version: 2.0 (Phase 1: 基本拡張完了)
//
// このファイルは参照用です。実際の実装は以下を更新：
//   apps/selfhost/vm/boxes/result_box.hako
//
// 設計書: docs/development/roadmap/phases/phase-20-variant-box/RESULT_BOX_COMPLETE_DESIGN.md

// ============================================================================
// ResultBox - Result<T,E> 型の実装
// ============================================================================

box ResultBox {
  // === フィールド ===
  _val: Box          // 成功値（Ok時のみ有効）
  _err: StringBox    // エラーメッセージ（Err時のみ有効）
  _ok: IntegerBox    // 判別フラグ（1=Ok, 0=Err）※BoolBox非依存

  // === 初期化 ===
  birth() {
    me._val = null
    me._err = ""
    me._ok = 0
  }

  // ============================================================================
  // 基本判定メソッド
  // ============================================================================

  // is_ok: 成功判定
  // Returns: 1=Ok, 0=Err
  // 既存互換: ✅
  is_ok() {
    return me._ok
  }

  // is_err: エラー判定
  // Returns: 1=Err, 0=Ok
  // 既存互換: ❌（新規追加）
  is_err() {
    if me._ok == 1 { return 0 }
    return 1
  }

  // ============================================================================
  // 値アクセスメソッド（既存互換）
  // ============================================================================

  // value: 成功値を取得（エラー時はnull）
  // Returns: Ok時の値、Err時はnull
  // 既存互換: ✅
  // 注意: nullチェックが必要。unwrap()の使用を推奨
  value() {
    return me._val
  }

  // error: エラーメッセージを取得
  // Returns: Err時のメッセージ、Ok時は""
  // 既存互換: ✅
  error() {
    return me._err
  }

  // ============================================================================
  // unwrap系メソッド（新規）
  // ============================================================================

  // unwrap: 成功値を取得、エラー時はpanic
  // Returns: Ok時の値
  // Panics: Err時（疑似panic: printしてnull返却）
  // 既存互換: ❌（新規追加）
  //
  // 使用例:
  //   local r = Result.ok(42)
  //   local v = r.unwrap()  // → 42
  //
  //   local r2 = Result.err("oops")
  //   local v2 = r2.unwrap()  // → [PANIC] Result.unwrap() called on Err: oops
  unwrap() {
    if me._ok == 0 {
      local msg = "[PANIC] Result.unwrap() called on Err: " + me._err
      print(msg)
      return null  // Hakoruneにpanic()がないため疑似panic
    }
    return me._val
  }

  // expect: 成功値を取得、エラー時はカスタムメッセージ付きpanic
  // Args:
  //   custom_msg: StringBox - カスタムエラーメッセージ
  // Returns: Ok時の値
  // Panics: Err時（疑似panic）
  // 既存互換: ❌（新規追加）
  //
  // 使用例:
  //   local r = Result.err("file not found")
  //   local v = r.expect("Failed to load config")
  //   // → [PANIC] Failed to load config: file not found
  expect(custom_msg) {
    if me._ok == 0 {
      local msg = "[PANIC] " + custom_msg + ": " + me._err
      print(msg)
      return null
    }
    return me._val
  }

  // unwrap_err: エラーを取得、成功時はpanic
  // Returns: Err時のエラーメッセージ
  // Panics: Ok時（疑似panic）
  // 既存互換: ❌（新規追加）
  //
  // 使用例:
  //   local r = Result.err("not found")
  //   local e = r.unwrap_err()  // → "not found"
  //
  //   local r2 = Result.ok(42)
  //   local e2 = r2.unwrap_err()  // → [PANIC] Result.unwrap_err() called on Ok: 42
  unwrap_err() {
    if me._ok == 1 {
      local msg = "[PANIC] Result.unwrap_err() called on Ok: " + me._val
      print(msg)
      return ""
    }
    return me._err
  }

  // unwrap_or: 成功値を取得、エラー時はデフォルト値を返す
  // Args:
  //   def: Box - デフォルト値
  // Returns: Ok時の値、Err時はdef
  // 既存互換: ✅
  //
  // 使用例:
  //   local r = Result.ok(42)
  //   local v = r.unwrap_or(0)  // → 42
  //
  //   local r2 = Result.err("oops")
  //   local v2 = r2.unwrap_or(0)  // → 0
  unwrap_or(def) {
    if me._ok == 1 { return me._val }
    return def
  }

  // ============================================================================
  // 関数型メソッド（Phase 2: Phase 21完了後に実装）
  // ============================================================================

  // map: 成功値を変換（関数型プログラミング）
  // Args:
  //   fn: FunctionBox - 変換関数 (T -> U)
  // Returns: Ok(fn(v)) または Err(e)
  //
  // 注意: Hakoruneに第一級関数がない場合は実装不可
  // 実装時期: Phase 21（関数型機能）完了後
  //
  // 使用例（将来）:
  //   local r = Result.ok(42)
  //   local r2 = r.map(lambda(x) { return x * 2 })  // → Ok(84)
  //
  // map(fn) {
  //   if me._ok == 0 {
  //     return me  // Errはそのまま伝播
  //   }
  //   local new_val = fn.call(me._val)
  //   return Result.ok(new_val)
  // }

  // map_err: エラー値を変換
  // Args:
  //   fn: FunctionBox - 変換関数 (E -> F)
  // Returns: Ok(v) または Err(fn(e))
  //
  // 実装時期: Phase 21完了後
  //
  // map_err(fn) {
  //   if me._ok == 1 {
  //     return me  // Okはそのまま
  //   }
  //   local new_err = fn.call(me._err)
  //   return Result.err(new_err)
  // }

  // and_then: 成功時に次の処理を実行（flatMap）
  // Args:
  //   fn: FunctionBox - 変換関数 (T -> Result<U,E>)
  // Returns: fn(v) または Err(e)
  //
  // 実装時期: Phase 21完了後
  //
  // and_then(fn) {
  //   if me._ok == 0 {
  //     return me
  //   }
  //   return fn.call(me._val)  // fn は ResultBox を返す想定
  // }

  // or_else: エラー時に代替処理を実行
  // Args:
  //   fn: FunctionBox - 代替関数 (E -> Result<T,F>)
  // Returns: Ok(v) または fn(e)
  //
  // 実装時期: Phase 21完了後
  //
  // or_else(fn) {
  //   if me._ok == 1 {
  //     return me
  //   }
  //   return fn.call(me._err)  // fn は ResultBox を返す想定
  // }

  // ============================================================================
  // デバッグメソッド
  // ============================================================================

  // debug: デバッグ用文字列表現
  // Returns: "Ok(value)" または "Err(error)"
  // 既存互換: ❌（新規追加）
  //
  // 使用例:
  //   local r = Result.ok(42)
  //   print(r.debug())  // → "Ok(42)"
  //
  //   local r2 = Result.err("not found")
  //   print(r2.debug())  // → "Err(not found)"
  debug() {
    if me._ok == 1 {
      return "Ok(" + me._val + ")"
    }
    return "Err(" + me._err + ")"
  }
}

// ============================================================================
// Result - static box（コンストラクタ）
// ============================================================================

static box Result {
  // ok: 成功値を持つResultBoxを生成
  // Args:
  //   v: Box - 成功値
  // Returns: ResultBox（Ok状態）
  // 既存互換: ✅
  //
  // 使用例:
  //   local r = Result.ok(42)
  //   print(r.is_ok())  // → 1
  //   print(r.value())  // → 42
  ok(v) {
    local r = new ResultBox()
    r._val = v
    r._ok = 1
    return r
  }

  // err: エラーメッセージを持つResultBoxを生成
  // Args:
  //   msg: StringBox - エラーメッセージ
  // Returns: ResultBox（Err状態）
  // 既存互換: ✅
  //
  // 使用例:
  //   local r = Result.err("file not found")
  //   print(r.is_err())  // → 1
  //   print(r.error())  // → "file not found"
  err(msg) {
    local r = new ResultBox()
    r._err = msg
    r._ok = 0
    return r
  }
}

// ============================================================================
// 使用例
// ============================================================================

// 例1: 基本的な使い方（既存互換）
static box Example1 {
  main() {
    local a = Result.ok(7)
    local b = Result.err("oops")
    local s = a.unwrap_or(0) + b.unwrap_or(5)
    print("" + s)  // → 12
    return 0
  }
}

// 例2: unwrap()の使用（新機能）
static box Example2 {
  main() {
    local r = Result.ok(42)
    local v = r.unwrap()
    print("" + v)  // → 42

    local r2 = Result.err("error")
    local v2 = r2.unwrap()  // → [PANIC] Result.unwrap() called on Err: error
    return 0
  }
}

// 例3: expect()の使用（新機能）
static box Example3 {
  main() {
    local r = Result.err("file not found")
    local v = r.expect("Failed to load config")
    // → [PANIC] Failed to load config: file not found
    return 0
  }
}

// 例4: is_err()の使用（新機能）
static box Example4 {
  main() {
    local r = Result.ok(42)
    if r.is_err() == 1 {
      print("Error!")
    } else {
      print("Ok: " + r.value())  // → Ok: 42
    }
    return 0
  }
}

// 例5: debug()の使用（新機能）
static box Example5 {
  main() {
    local r1 = Result.ok(42)
    print(r1.debug())  // → Ok(42)

    local r2 = Result.err("not found")
    print(r2.debug())  // → Err(not found)
    return 0
  }
}

// 例6: 実用例（PHI decode）
static box Example6 {
  decode_phi(seg) {
    if seg == null {
      return Result.err("null segment")
    }
    if seg.length() == 0 {
      return Result.err("empty segment")
    }
    // 成功
    return Result.ok(seg)
  }

  main() {
    local r1 = me.decode_phi("valid")
    if r1.is_ok() == 1 {
      print("Success: " + r1.unwrap())  // → Success: valid
    }

    local r2 = me.decode_phi(null)
    if r2.is_err() == 1 {
      print("Error: " + r2.error())  // → Error: null segment
    }
    return 0
  }
}

// ============================================================================
// 移行ガイド
// ============================================================================

// 【移行前】nullチェックパターン
static box OldPattern {
  main() {
    local r = Result.ok(42)
    local v = r.value()
    if v == null {
      print("Error!")
      return 1
    }
    print("Value: " + v)
    return 0
  }
}

// 【移行後】unwrap()パターン（推奨）
static box NewPattern {
  main() {
    local r = Result.ok(42)
    local v = r.unwrap()  // エラー時は自動でパニック
    print("Value: " + v)
    return 0
  }
}

// 【移行後】expect()パターン（エラーメッセージカスタマイズ）
static box NewPatternExpect {
  main() {
    local r = Result.ok(42)
    local v = r.expect("Failed to get value")  // カスタムメッセージ
    print("Value: " + v)
    return 0
  }
}

// ============================================================================
// テストケース（参考）
// ============================================================================

static box ResultBoxTest {
  test_ok() {
    local r = Result.ok(42)
    if r.is_ok() != 1 { print("[FAIL] is_ok") return 1 }
    if r.is_err() != 0 { print("[FAIL] is_err") return 1 }
    if r.value() != 42 { print("[FAIL] value") return 1 }
    if r.unwrap() != 42 { print("[FAIL] unwrap") return 1 }
    print("[PASS] test_ok")
    return 0
  }

  test_err() {
    local r = Result.err("error")
    if r.is_ok() != 0 { print("[FAIL] is_ok") return 1 }
    if r.is_err() != 1 { print("[FAIL] is_err") return 1 }
    if r.error() != "error" { print("[FAIL] error") return 1 }
    if r.unwrap_err() != "error" { print("[FAIL] unwrap_err") return 1 }
    print("[PASS] test_err")
    return 0
  }

  test_unwrap_or() {
    local r1 = Result.ok(42)
    if r1.unwrap_or(0) != 42 { print("[FAIL] unwrap_or ok") return 1 }

    local r2 = Result.err("error")
    if r2.unwrap_or(99) != 99 { print("[FAIL] unwrap_or err") return 1 }

    print("[PASS] test_unwrap_or")
    return 0
  }

  test_debug() {
    local r1 = Result.ok(42)
    if r1.debug() != "Ok(42)" { print("[FAIL] debug ok") return 1 }

    local r2 = Result.err("error")
    if r2.debug() != "Err(error)" { print("[FAIL] debug err") return 1 }

    print("[PASS] test_debug")
    return 0
  }

  main() {
    local fail = 0
    fail = fail + me.test_ok()
    fail = fail + me.test_err()
    fail = fail + me.test_unwrap_or()
    fail = fail + me.test_debug()

    if fail == 0 {
      print("[ALL PASS] ResultBox tests")
    } else {
      print("[FAILED] " + fail + " tests")
    }
    return fail
  }
}

