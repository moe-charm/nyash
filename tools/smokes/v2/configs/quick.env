#!/usr/bin/env bash
# Quick profile defaults to reduce env noise for smokes/benches

# Use LLVM harness (llvmlite) by default
export NYASH_LLVM_USE_HARNESS=${NYASH_LLVM_USE_HARNESS:-1}

# Silence runtime trailing Result: <exit> line for cleaner parsing
export NYASH_NYRT_SILENT_RESULT=${NYASH_NYRT_SILENT_RESULT:-1}

# Disable plugins (deterministic core path)
export NYASH_DISABLE_PLUGINS=${NYASH_DISABLE_PLUGINS:-1}

# Safepoint off by default in harness
export NYASH_LLVM_AUTO_SAFEPOINT=${NYASH_LLVM_AUTO_SAFEPOINT:-0}

# Read-only calls: skip safepoint automatically (keep ON)
export NYASH_LLVM_SAFEPOINT_READONLY_SKIP=${NYASH_LLVM_SAFEPOINT_READONLY_SKIP:-1}


# Enable AST prelude merge for using (required for ModuleFunction availability in VM paths)
export NYASH_USING_AST=${NYASH_USING_AST:-1}
## Resolver strictness: default OFF in quick profile (tests opt-in per case)
export NYASH_USING_STRICT=${NYASH_USING_STRICT:-0}
## Allow namespace alias acceptance (reduces need for prelude scans)
export NYASH_USING_NAMESPACE_ALIAS=${NYASH_USING_NAMESPACE_ALIAS:-1}

# Opt-in dev fallback: directory-as-namespace auto discovery under apps/
# Enabled by default in quick profile only (CI/prod keep OFF unless explicitly set)
export NYASH_USING_DIR_NS=${NYASH_USING_DIR_NS:-1}

# Avoid spawning macro child runner to prevent argv overflow on long JSON
export NYASH_MACRO_BOX_CHILD_RUNNER=${NYASH_MACRO_BOX_CHILD_RUNNER:-0}

## VM auto-register for Dir-as-NS discovered boxes (dev-only)
export NYASH_VM_AUTO_REGISTER_DIR_NS=${NYASH_VM_AUTO_REGISTER_DIR_NS:-1}

# Prefer Module-First namespace policy in quick profile (dev convenience)
export NYASH_NS_POLICY=${NYASH_NS_POLICY:-module-first}

# Disable JSON v1 path by default; enable per-test via SMOKES_ENABLE_JSON_V1=1
export NYASH_PIPELINE_V1=${NYASH_PIPELINE_V1:-0}
