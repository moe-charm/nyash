#!/usr/bin/env bash
# Plugin-on env overlay for smokes

export HAKO_PLUGIN_POLICY=auto
# Optional prefer switches (leave OFF by default; enable per-test if needed)
# export NYASH_VM_PLUGIN_PREFER_STRING=1
# export NYASH_VM_PLUGIN_PREFER_ARRAY=1
# export NYASH_VM_PLUGIN_PREFER_MAP=1

# Keep using enabled for selfhost tests
export NYASH_USING=${NYASH_USING:-1}
export NYASH_ALLOW_USING_FILE=${NYASH_ALLOW_USING_FILE:-1}
