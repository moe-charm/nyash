#!/usr/bin/env bash
# Profile overlay: integration

export NYASH_USING=1
export NYASH_USING_STRATEGY=resolver
export NYASH_USING_AST=${NYASH_USING_AST:-1}
export NYASH_PLUGIN_POLICY=auto
## Silence runtime trailing Result line for clean comparisons
export NYASH_NYRT_SILENT_RESULT=${NYASH_NYRT_SILENT_RESULT:-1}
## For AOT harness runs, enable minimal C kernel semantics (console/string)
export NYASH_HAKO_MIN_SEM=${NYASH_HAKO_MIN_SEM:-1}

# Prefer stricter/dev-off defaults here; quick already sets dev fallbacks
unset NYASH_DEV_FALLBACK || true


# Resolver strictness: disable tail fallbacks to prevent accidental recursion
export NYASH_VM_GLOBAL_TAIL_FALLBACK=0
export NYASH_VM_MODULE_TAIL_WIDE=0
export NYASH_VM_REENTER_LIMIT=${NYASH_VM_REENTER_LIMIT:-2048}
export SMOKES_SKIP_WHEN_PLUGINS_MISSING=1
## Avoid AOT link for harness runs (use VM delegate for output parity)
export NYASH_LLVM_RUN_EMIT_EXE=0
