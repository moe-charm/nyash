#!/bin/bash
# plugins.env — overlay for plugins profile
# Purpose: run through all plugin tests without fast-fail; keep noise low

export SMOKES_FAST_FAIL=0
export SMOKES_SHOW_TIMING=1

# Prefer dynamic plugins; keep runner verbose low to avoid diff noise
export SMOKES_PLUGIN_MODE=dynamic
export HAKO_PLUGIN_POLICY=${HAKO_PLUGIN_POLICY:-auto}
export NYASH_CLI_VERBOSE=0
export NYASH_USING_AST=${NYASH_USING_AST:-1}
export SMOKES_SKIP_WHEN_PLUGINS_MISSING=1
## Silence runtime trailing Result line for clean comparisons
export NYASH_NYRT_SILENT_RESULT=${NYASH_NYRT_SILENT_RESULT:-1}
export SMOKES_ASI_LOOSE_SEMI=${SMOKES_ASI_LOOSE_SEMI:-1}

# Stage-2: always route Map.keys()/values() through ArrayBox HostHandle
export NYASH_PLUGIN_MAP_ARRAY_HANDLE=${NYASH_PLUGIN_MAP_ARRAY_HANDLE:-1}

# Opt-in: reload nyash_box specs when developing plugins (default off)
export NYASH_PLUGIN_CONFIG_RELOAD=${NYASH_PLUGIN_CONFIG_RELOAD:-0}

# Ensure plugin config path is explicit for dynamic plugin runs
if [ -z "${NYASH_PLUGIN_CONFIG:-}" ]; then
  if [ -n "${NYASH_ROOT:-}" ] && [ -f "$NYASH_ROOT/nyash.toml" ]; then
    export NYASH_PLUGIN_CONFIG="$NYASH_ROOT/nyash.toml"
  fi
fi

# Enable plugin debug to surface provider path in logs for plugins profile
# export NYASH_DEBUG_PLUGIN=${NYASH_DEBUG_PLUGIN:-1}

# Avoid rebuild flapping during plugins profile runs
export SMOKES_AUTO_BUILD_PLUGINS=${SMOKES_AUTO_BUILD_PLUGINS:-0}
