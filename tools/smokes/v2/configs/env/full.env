#!/bin/bash
# Full profile defaults
export SMOKES_FAST_FAIL=${SMOKES_FAST_FAIL:-0}
export SMOKES_DEFAULT_TIMEOUT=${SMOKES_DEFAULT_TIMEOUT:-150}
# Keep using strict by default
export NYASH_USING=1
# Prefer to include plugins if present; otherwise SKIP
# (No explicit toggles here; plugin preflight handles availability.)

# Force LLVM harness globally to avoid backend selection drift in aggregated runs
export NYASH_LLVM_USE_HARNESS=1
export NYASH_NY_LLVM_COMPILER="${NYASH_ROOT}/target/release/ny-llvmc"
export NYASH_EMIT_EXE_NYRT="${NYASH_ROOT}/target/release"

# Force parity scripts to run LLVM path rather than skipping
export SMOKES_FORCE_LLVM=1

# Resolver strictness: disable tail fallbacks globally in full suite
export NYASH_VM_GLOBAL_TAIL_FALLBACK=0
export NYASH_VM_MODULE_TAIL_WIDE=0
export NYASH_VM_REENTER_LIMIT=${NYASH_VM_REENTER_LIMIT:-4096}

## Keep runtime result line silent to avoid noise in multi-suite comparisons
export NYASH_NYRT_SILENT_RESULT=${NYASH_NYRT_SILENT_RESULT:-1}
## Allow loose ASI for inline ';' in minimal plugin samples under -c execution
export SMOKES_ASI_LOOSE_SEMI=${SMOKES_ASI_LOOSE_SEMI:-1}
