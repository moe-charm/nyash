#!/usr/bin/env bash
# Plugin-on strict overlay: forbid builtin fallback for core boxes

export HAKO_PLUGIN_POLICY=auto
export NYASH_PLUGIN_CONFIG=${NYASH_PLUGIN_CONFIG:-hako.toml}

# Enforce strict plugin-on: ProviderBox forbids builtin fallback and fail-fast
export NYASH_PLUGIN_ON_STRICT=1

# Keep using resolver
export NYASH_USING=${NYASH_USING:-1}

# Auto-build if needed
export SMOKES_AUTO_BUILD_PLUGINS=${SMOKES_AUTO_BUILD_PLUGINS:-1}
