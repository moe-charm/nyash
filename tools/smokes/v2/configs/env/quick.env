#!/usr/bin/env bash
# Profile overlay: quick

## Using & Plugins (redundant with configs but explicit for clarity)
export NYASH_USING=1
export NYASH_USING_STRATEGY=prelude
export NYASH_PLUGIN_POLICY=auto
## Allow file-path using in quick profile (some core tests rely on it)
export NYASH_ALLOW_USING_FILE=${NYASH_ALLOW_USING_FILE:-1}
## Enable AST prelude merge for using in quick profile
export NYASH_USING_AST=${NYASH_USING_AST:-1}
export NYASH_USING_PROFILE=${NYASH_USING_PROFILE:-dev}
## Dev-only MIR verify: enable strict PHI input coverage to catch builder issues early
export NYASH_VERIFY_PHI_STRICT=${NYASH_VERIFY_PHI_STRICT:-1}

# Dev assist (already set in rust_vm_dynamic.conf; kept here for clarity)
export NYASH_DEV_FALLBACK=1

export NYASH_VM_AUTO_BIRTH_CPP=1
export NYASH_PLUGIN_LOOKUP_LOCAL=1

# Allow plugins to override core types (String/Array/Map) now that builtins are being retired
export NYASH_USE_PLUGIN_BUILTINS=${NYASH_USE_PLUGIN_BUILTINS:-1}
export NYASH_PLUGIN_OVERRIDE_TYPES=${NYASH_PLUGIN_OVERRIDE_TYPES:-"StringBox,ArrayBox,MapBox"}

# Allow dotted ModuleFunction tail fallback for imported static boxes
export NYASH_VM_GLOBAL_TAIL_FALLBACK=0

# Allow wide ModuleFunction tail fallback (alias→declared class)
export NYASH_VM_MODULE_TAIL_WIDE=0


# Reentrancy guard during quick profile (Fail-Fast on deep recursion)
export NYASH_VM_REENTER_LIMIT=2048
