#!/usr/bin/env bash
# Profile overlay: quick-selfhost

export NYASH_USING=1
export NYASH_USING_STRATEGY=prelude
export NYASH_USING_AST=${NYASH_USING_AST:-1}
export NYASH_USING_PROFILE=${NYASH_USING_PROFILE:-dev}
export NYASH_ALLOW_USING_FILE=${NYASH_ALLOW_USING_FILE:-1}

# Keep plugins disabled unless explicitly enabled by tests
export NYASH_DISABLE_PLUGINS=${NYASH_DISABLE_PLUGINS:-1}

# Runner dev aids
export SMOKES_USE_DEV=1
export SMOKES_FAST_FAIL=0
export NYASH_JSON_ONLY=${NYASH_JSON_ONLY:-1}

# Minimal module aliases to keep selfhost tests stable after alias migration
# Provide VM core + JSON scanners via selfhost/shared
export NYASH_MODULES=${NYASH_MODULES:-"selfhost.vm.mir_min=selfhost/vm/boxes/mir_vm_min.hako,selfhost.vm.handlers=selfhost/vm/boxes/op_handlers.hako,selfhost.vm.scanner=selfhost/vm/boxes/instruction_scanner.hako,selfhost.vm.json_cur=selfhost/vm/boxes/json_cur.hako,selfhost.json.core.string_scan=selfhost/shared/json/core/string_scan.hako,selfhost.json.utils.json_frag=selfhost/shared/json/utils/json_frag.hako"}

export HAKO_ALLOW_USING_FILE=${HAKO_ALLOW_USING_FILE:-1}
export HAKO_USING=${HAKO_USING:-1}
export HAKO_USING_STRATEGY=${HAKO_USING_STRATEGY:-prelude}
export HAKO_USING_PROFILE=${HAKO_USING_PROFILE:-dev}

# Suppress and collapse module conflict noise for this profile
export NYASH_SUPPRESS_MODULE_CONFLICT=${NYASH_SUPPRESS_MODULE_CONFLICT:-1}
export HAKO_SUPPRESS_MODULE_CONFLICT=${HAKO_SUPPRESS_MODULE_CONFLICT:-1}
export HAKO_COLLAPSE_MODULE_CONFLICT=${HAKO_COLLAPSE_MODULE_CONFLICT:-1}

# Enable Map.keys/values fallback (keysS/valuesS → Array) during migration
export HAKO_MAP_KEYS_VALUES_FALLBACK=${HAKO_MAP_KEYS_VALUES_FALLBACK:-1}
