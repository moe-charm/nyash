#!/usr/bin/env bash
# Profile overlay: quick-selfhost

export NYASH_USING=1
export NYASH_USING_STRATEGY=prelude
export NYASH_USING_AST=${NYASH_USING_AST:-1}
export NYASH_USING_PROFILE=${NYASH_USING_PROFILE:-dev}
export NYASH_ALLOW_USING_FILE=${NYASH_ALLOW_USING_FILE:-1}

# Keep plugins disabled unless explicitly enabled by tests
export NYASH_DISABLE_PLUGINS=${NYASH_DISABLE_PLUGINS:-1}

# Runner dev aids
export SMOKES_USE_DEV=1
export SMOKES_FAST_FAIL=0

# Collections API migration (local-only): MapBox.get(missing) -> null
export HAKO_MAP_GET_NULL=${HAKO_MAP_GET_NULL:-1}
