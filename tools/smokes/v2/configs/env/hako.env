#!/usr/bin/env bash
# hako.env — alias overlay for Hakorune (plugin-only) profile
# This file intentionally sources the plugins profile to avoid duplication.

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/plugins.env"

# Optional: tag the profile name for logs
export SMOKES_CURRENT_PROFILE_DISPLAY=${SMOKES_CURRENT_PROFILE_DISPLAY:-"hako"}

