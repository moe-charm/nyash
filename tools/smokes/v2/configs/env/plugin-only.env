#!/bin/bash
# plugin-only.env — overlay for running with plugin-first paths and legacy builtins discouraged
# Note: Disables builtin String/Array/Map where possible at runtime. For full isolation,
#       build a plugin-only binary and set NYASH_BIN to its path before running smokes.

export SMOKES_FAST_FAIL=0
export SMOKES_SHOW_TIMING=1
export SMOKES_SKIP_WHEN_PLUGINS_MISSING=1

# Prefer dynamic plugins and plugin-first resolution
export SMOKES_PLUGIN_MODE=dynamic
export HAKO_PLUGIN_POLICY=${HAKO_PLUGIN_POLICY:-auto}
export NYASH_USE_PLUGIN_BUILTINS=${NYASH_USE_PLUGIN_BUILTINS:-1}
export NYASH_PLUGIN_OVERRIDE_TYPES=${NYASH_PLUGIN_OVERRIDE_TYPES:-"StringBox,ArrayBox,MapBox"}

# Disable builtin boxes when possible (runtime switches; compile-time feature gating requires a separate build)
export NYASH_BUILTIN_DISABLE_STRING=${NYASH_BUILTIN_DISABLE_STRING:-1}
export NYASH_BUILTIN_DISABLE_ARRAY=${NYASH_BUILTIN_DISABLE_ARRAY:-1}
export NYASH_BUILTIN_DISABLE_MAP=${NYASH_BUILTIN_DISABLE_MAP:-1}

# Route core collection ops through HostHandleRouter early slots to maximize plugin coverage
export NYASH_MAP_FORCE_HOST=${NYASH_MAP_FORCE_HOST:-1}
export NYASH_ARRAY_FORCE_HOST=${NYASH_ARRAY_FORCE_HOST:-1}
export NYASH_ARRAY_SIZE_FORCE_HOST=${NYASH_ARRAY_SIZE_FORCE_HOST:-1}
export NYASH_STRING_SIZE_FORCE_HOST=${NYASH_STRING_SIZE_FORCE_HOST:-1}

# Quiet trailing result for cleaner diffs in this profile
export NYASH_NYRT_SILENT_RESULT=${NYASH_NYRT_SILENT_RESULT:-1}

# Optional: override NYASH_BIN to a plugin-only build (no legacy-boxes feature)
# export NYASH_BIN="$NYASH_ROOT/target/release/hakorune-plugin-only"

