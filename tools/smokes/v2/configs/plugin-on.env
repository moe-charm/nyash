#!/usr/bin/env bash
# Plugin-on env overlay (profile-level)

export HAKO_PLUGIN_POLICY=auto
# Prefer canonical plugin config to avoid type_id drift
export NYASH_PLUGIN_CONFIG=${NYASH_PLUGIN_CONFIG:-hako.toml}
# Prefer plugin-builtins for core types
export NYASH_USE_PLUGIN_BUILTINS=1
export NYASH_PLUGIN_OVERRIDE_TYPES=${NYASH_PLUGIN_OVERRIDE_TYPES:-"StringBox,ArrayBox,MapBox"}

# Auto-build plugins during smokes if missing
export SMOKES_AUTO_BUILD_PLUGINS=${SMOKES_AUTO_BUILD_PLUGINS:-1}

# Disable builtin core boxes in plugin-on profile to validate plugin parity
export NYASH_BUILTIN_DISABLE_STRING=1
export NYASH_BUILTIN_DISABLE_ARRAY=1
export NYASH_BUILTIN_DISABLE_MAP=1

# Keep using enabled for selfhost tests
export NYASH_USING=${NYASH_USING:-1}
export NYASH_ALLOW_USING_FILE=${NYASH_ALLOW_USING_FILE:-1}
