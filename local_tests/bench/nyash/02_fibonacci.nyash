// Fibonacci Benchmark
// Calculates 10th Fibonacci number (returns 144)

static box Main {
    main() {
        local a
        local b
        local i
        local temp

        a = 0
        b = 1
        i = 0

        loop(i < 10) {
            temp = a + b
            a = b
            b = temp
            i = i + 1
        }

        return b
    }
}
