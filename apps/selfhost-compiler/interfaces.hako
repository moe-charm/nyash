// interfaces.nyash — documentation-only sketch (no runtime effect expected)
// Purpose: make contracts discoverable to tools/AI and readers.

// ParserBox interface (Stage-1 JSON emission)
static box ParserBox {
  stage3_enable(flag) { /* enable Stage-3 grammar acceptance */ }
  parse_program2(src) { /* return JSON (single line when NYASH_JSON_ONLY=1) */ }
}

// EmitterBox interface (Stage-1 JSON -> JSON v0)
static box EmitterBox {
  emit_program(json, opts) { /* return JSON v0 line (header+body) */ }
}

// MirEmitterBox interface (JSON v0 -> MIR(JSON v0))
static box MirEmitterBox {
  emit_min(program_json) { /* minimal MIR: const/binop/compare/branch/jump/ret/phi */ }
}

// Notes:
// - This file is an interface sketch. Concrete methods live under boxes/*.nyash.
// - Fail-Fast policy: on invalid input, implementations must return errors (no silent fallback).
// - Execution policy: Rust VM is default; PyVM is opt-in via NYASH_VM_USE_PY=1.
