using "apps/selfhost-compiler/pipeline_v2/stage1_extract_flow.hako" as Stage1ExtractFlow
using "apps/selfhost-compiler/pipeline_v2/emit_return_box.hako" as EmitReturnBox
using "apps/selfhost-compiler/pipeline_v2/emit_binop_box.hako" as EmitBinopBox
using "apps/selfhost-compiler/pipeline_v2/emit_compare_box.hako" as EmitCompareBox
using "apps/selfhost-compiler/pipeline_v2/regex_flow.hako" as RegexFlow

flow PipelineV2 {
  lower_stage1_to_mir(ast_json, prefer_cfg) {
    if ast_json == null { return EmitReturnBox.emit_return_int(0) }
    // If(...) pattern (prefer CFG form)
    {
      local iq = RegexFlow.find_from(ast_json, "\"type\":\"If\"", 0)
      if iq >= 0 {
        local ic = Stage1ExtractFlow.extract_if_compare(ast_json)
        if ic != null {
          local mat = 0
          if prefer_cfg >= 2 { mat = 1 }
          return EmitCompareBox.emit_compare_cfg2(ic.get("lhs"), ic.get("rhs"), ic.get("cmp"), mat)
        }
      }
    }
    // Try Compare first (avoid mis-detection by 'op' field inside Compare)
    // Guard by raw scan to avoid calling methods on null-like values
    {
      local cq = RegexFlow.find_from(ast_json, "\"type\":\"Compare\"", 0)
      if cq >= 0 {
        local c = Stage1ExtractFlow.extract_return_compare(ast_json)
        if prefer_cfg >= 1 {
          // MapBox access via get("key") for portability
          local lhs = c.get("lhs")
          local rhs = c.get("rhs")
          local cmp = c.get("cmp")
          local mat = 0
          if prefer_cfg >= 2 { mat = 1 }
          return EmitCompareBox.emit_compare_cfg2(lhs, rhs, cmp, mat)
        }
      }
    }
    // Then BinOp (guard by raw scan)
    {
      local bq = RegexFlow.find_from(ast_json, "\"type\":\"BinOp\"", 0)
      if bq >= 0 {
        local b = Stage1ExtractFlow.extract_return_binop(ast_json)
        local lhs = b.get("lhs")
        local rhs = b.get("rhs")
        local kind = b.get("kind")
        return EmitBinopBox.emit_binop(lhs, rhs, kind)
      }
    }
    // Fallback Return(Int)
    local v = Stage1ExtractFlow.extract_return_int(ast_json)
    return EmitReturnBox.emit_return_int(v)
  }
}
