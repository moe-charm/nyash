// map_helpers_box.hako — Pipeline用の軽量ヘルパ（MapBoxの型付き取得）

static box MapHelpersBox {
  _to_i64(v) {
    if v == null { return 0 }
    local s = "" + v
    local i = 0
    local neg = 0
    if s.substring(0,1) == "-" { neg = 1  i = 1 }
    local n = s.length()
    if i >= n { return 0 }
    local acc = 0
    loop (i < n) {
      local ch = s.substring(i, i+1)
      if ch < "0" || ch > "9" { break }
      local d = "0123456789".indexOf(ch)
      if d < 0 { break }
      acc = acc * 10 + d
      i = i + 1
    }
    if neg == 1 { return 0 - acc }
    return acc
  }

  // 基本: 文字列／数値の取得
  get_str(m, key) {
    if m == null { return "" }
    local v = m.get(key)
    if v == null { return "" }
    return "" + v
  }
  get_i64(m, key) {
    if m == null { return 0 }
    return me._to_i64(m.get(key))
  }

  // 必須（Fail‑Fast推奨／当面は空なら既定値0/""を返す）
  expect_str(m, key) { return me.get_str(m, key) }
  expect_i64(m, key) {
    local n = me.get_i64(m, key)
    return n
  }

  // 任意（デフォルト付き）
  opt_str(m, key, def) {
    local s = me.get_str(m, key)
    if s == null || s == "" { return def }
    return s
  }
  opt_i64(m, key, def) {
    local n = me.get_i64(m, key)
    if n == null { return def }
    return n
  }
}

static box MapHelpersStub { main(args) { return 0 } }
