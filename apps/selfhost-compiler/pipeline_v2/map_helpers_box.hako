// map_helpers_box.hako — Pipeline用の軽量ヘルパ（MapBoxの型付き取得）

static box MapHelpersBox {
  _raw_get(m, key) {
    if m == null { return null }
    if m.get == null { return null }
    return m.get(key)
  }

  _to_i64(v) {
    if v == null { return 0 }
    local s = "" + v
    local i = 0
    local neg = 0
    if s.substring(0,1) == "-" { neg = 1  i = 1 }
    local n = s.length()
    if i >= n { return 0 }
    local acc = 0
    loop (i < n) {
      local ch = s.substring(i, i+1)
      if ch < "0" || ch > "9" { break }
      local d = "0123456789".indexOf(ch)
      if d < 0 { break }
      acc = acc * 10 + d
      i = i + 1
    }
    if neg == 1 { return 0 - acc }
    return acc
  }

  get_str(m, key) {
    local v = me._raw_get(m, key)
    if v == null { return "" }
    if v.get != null && v.has != null {
      if v.has("value") { return "" + v.get("value") }
    }
    return "" + v
  }

  get_i64(m, key) {
    local v = me._raw_get(m, key)
    if v == null { return 0 }
    if v.get != null && v.has != null {
      if v.has("value") { return me._to_i64(v.get("value")) }
    }
    return me._to_i64(v)
  }

  expect_str(m, key) { return me.get_str(m, key) }
  expect_i64(m, key) { return me.get_i64(m, key) }

  opt_str(m, key, def) {
    local s = me.get_str(m, key)
    if s == null || s == "" { return def }
    return s
  }

  opt_i64(m, key, def) {
    local n = me.get_i64(m, key)
    if n == null { return def }
    return n
  }
}

static box MapHelpersStub { main(args) { return 0 } }
