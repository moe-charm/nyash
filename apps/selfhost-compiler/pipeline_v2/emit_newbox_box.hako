// EmitNewBoxBox — Return(New class, args[int...]) → MIR(JSON v0)
// 最小形: 各引数を r1..rN; newbox(class, args=r1..rN) → rK; ret rK

using selfhost.common.json.mir_builder_min as MirJsonBuilderMin
using "apps/selfhost-compiler/pipeline_v2/regex_flow.hako" as RegexFlow
using "apps/selfhost-compiler/common/mir_emit_box.hako" as MirEmitBox
using "apps/selfhost-compiler/common/newbox_emit_box.hako" as NewBoxEmitBox
using "apps/selfhost-compiler/common/call_emit_box.hako" as CallEmitBox
using "apps/selfhost-compiler/common/header_emit_box.hako" as HeaderEmitBox
using "apps/selfhost-compiler/common/json_emit_box.hako" as JsonEmitBox

static box EmitNewBoxBox {
  emit_newbox_int_args(class_name, args) {
    class_name = match class_name { null => "", _ => class_name }
    args = match args { null => [], _ => args }
    // parse digits → const r1..rN
    local s = "" + args
    local pos = 0
    local n = 0
    local insts = []
    loop (true) {
      local ds = RegexFlow.digits_from(s, pos)
      if ds == "" { pos = pos + 1 } else {
        local pds = RegexFlow.find_from(s, ds, pos)
        if pds < 0 { pos = pos + 1 } else { insts.push(MirEmitBox.make_const(1 + n, RegexFlow.to_int(ds)))  n = n + 1  pos = pds + ds.length() }
      }
      if pos >= s.length() { break }
    }
    local dst = n + 1
    // args array [1..n]
    local arg_ids = new ArrayBox()
    { local i=0  loop(i<n) { arg_ids.push(1+i)  i=i+1 } }
    insts.push(NewBoxEmitBox.with_args_array(NewBoxEmitBox.make_new(class_name, arg_ids, dst), arg_ids))
    insts.push(MirEmitBox.make_ret(dst))
    // Assemble via header helper
    local blocks = new ArrayBox()
    blocks.push(HeaderEmitBox.make_block(0, insts))
    local fns = new ArrayBox()
    fns.push(HeaderEmitBox.make_function_main(blocks))
    return JsonEmitBox.to_json(HeaderEmitBox.make_module_with_functions(fns))
  }

  // JSON v1 (MirCall) emission — experimental, shape-only
  emit_newbox_int_args_v1(class_name, args) {
    class_name = match class_name { null => "", _ => class_name }
    args = match args { null => [], _ => args }
    local s = "" + args
    local pos = 0
    local n = 0
    local insts = []
    // materialize r1..rN
    loop (true) {
      local ds = RegexFlow.digits_from(s, pos)
      if ds == "" { pos = pos + 1 } else { insts.push(MirEmitBox.make_const(1 + n, RegexFlow.to_int(ds)))  n = n + 1  pos = pos + ds.length() }
      if pos >= s.length() { break }
    }
    local dst = n + 1
    // args array 1..n
    local arg_ids = new ArrayBox()
    { local i=0  loop(i<n) { arg_ids.push(1+i)  i=i+1 } }
    insts.push(CallEmitBox.make_mir_call_constructor(class_name, arg_ids, dst))
    insts.push(MirEmitBox.make_ret(dst))
    local blocks = new ArrayBox()
    blocks.push(HeaderEmitBox.make_block(0, insts))
    local fns = new ArrayBox()
    fns.push(HeaderEmitBox.make_function_main(blocks))
    return JsonEmitBox.to_json(HeaderEmitBox.make_module_with_functions(fns))
  }
}

static box EmitNewBoxStub { main(args) { return 0 } }
