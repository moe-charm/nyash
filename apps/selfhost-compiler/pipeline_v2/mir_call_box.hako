// MirCallBox — JSON v1 unified call emitters（薄い箱）
// 目的: v1（mir_call）を第一級に扱う最小APIを集中させる。実行は含まない（emit-only）。

using selfhost.common.json.mir_builder_min as MirJsonBuilderMin
using "apps/selfhost-compiler/pipeline_v2/regex_flow.hako" as RegexFlow

static box MirCallBox {
  // Global(name, args:int[])
  emit_call_v1(name, args) {
    if name == null { name = "" }
    if args == null { args = [] }
    local s = "" + args
    local pos = 0
    local n = 0
    local b = MirJsonBuilderMin.make()
      |> MirJsonBuilderMin.start_module()
      |> MirJsonBuilderMin.start_function("main")
      |> MirJsonBuilderMin.start_block(0)
    // materialize const args r1..rN
    loop (true) {
      local ds = RegexFlow.digits_from(s, pos)
      if ds == "" { pos = pos + 1 } else {
        b = b |> MirJsonBuilderMin.add_const(1 + n, RegexFlow.to_int(ds))
        n = n + 1
        pos = pos + ds.length()
      }
      if pos >= s.length() { break }
    }
    local dst = n + 1
    b = b |> MirJsonBuilderMin.add_mir_call_global_range(name, 1, n, dst)
      |> MirJsonBuilderMin.add_ret(dst)
      |> MirJsonBuilderMin.end_all()
    return MirJsonBuilderMin.to_string(b)
  }

  // Method(method, recv:int, args:int[])
  emit_method_v1(method, recv_val, args) {
    if method == null { method = "" }
    if args == null { args = [] }
    local s = "" + args
    local pos = 0
    local n = 0
    local b = MirJsonBuilderMin.make()
      |> MirJsonBuilderMin.start_module()
      |> MirJsonBuilderMin.start_function("main")
      |> MirJsonBuilderMin.start_block(0)
      |> MirJsonBuilderMin.add_const(1, recv_val)
    // materialize args r2..r(n+1)
    { local i = 0  loop(true) {
        local ds = RegexFlow.digits_from(s, pos)
        if ds == "" { pos = pos + 1 } else {
          b = b |> MirJsonBuilderMin.add_const(2 + i, RegexFlow.to_int(ds))
          i = i + 1
          n = i
          pos = pos + ds.length()
        }
        if pos >= s.length() { break }
      }
    }
    local dst = n + 2
    b = b |> MirJsonBuilderMin.add_mir_call_method_range(method, 1, 2, n, dst)
      |> MirJsonBuilderMin.add_ret(dst)
      |> MirJsonBuilderMin.end_all()
    return MirJsonBuilderMin.to_string(b)
  }

  // Constructor(class, args:int[])
  emit_newbox_v1(class_name, args) {
    if class_name == null { class_name = "" }
    if args == null { args = [] }
    local s = "" + args
    local pos = 0
    local n = 0
    local b = MirJsonBuilderMin.make()
      |> MirJsonBuilderMin.start_module()
      |> MirJsonBuilderMin.start_function("main")
      |> MirJsonBuilderMin.start_block(0)
    // materialize args r1..rN
    { local i = 0  loop(true) {
        local ds = RegexFlow.digits_from(s, pos)
        if ds == "" { pos = pos + 1 } else {
          b = b |> MirJsonBuilderMin.add_const(1 + i, RegexFlow.to_int(ds))
          i = i + 1
          n = i
          pos = pos + ds.length()
        }
        if pos >= s.length() { break }
      }
    }
    local dst = n + 1
    b = b |> MirJsonBuilderMin.add_mir_call_constructor_range(class_name, 1, n, dst)
      |> MirJsonBuilderMin.add_ret(dst)
      |> MirJsonBuilderMin.end_all()
    return MirJsonBuilderMin.to_string(b)
  }
}

static box MirCallStub { main(args) { return 0 } }

