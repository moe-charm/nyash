using "apps/lib/json_native/stringify.nyash" as JSON
using "apps/selfhost-compiler/pipeline_v2/local_ssa_box.hako" as LocalSSABox

flow EmitMirFlow {
  _int(n) { return "" + n }

  emit_return_int(v) {
    local mir = {
      functions: [{
        name: "main",
        params: [],
        blocks: [{
          id: 0,
          instructions: [
            { op:"const", dst:1, value:{ type:"i64", value: v } },
            { op:"ret", value:1 }
          ]
        }]
      }]
    }
    return JSON.stringify_map(mir)
  }

  _map_binop(opk) {
    if opk == "+" { return "Add" }
    if opk == "-" { return "Sub" }
    if opk == "*" { return "Mul" }
    if opk == "/" { return "Div" }
    if opk == "%" { return "Mod" }
    return opk
  }

  emit_binop(lhs, rhs, opk) {
    local kind = EmitMirFlow._map_binop(opk)
    local mir = {
      functions: [{ name:"main", params: [], blocks: [
        { id:0, instructions: [
          { op:"const", dst:1, value:{ type:"i64", value: lhs } },
          { op:"const", dst:2, value:{ type:"i64", value: rhs } },
          { op:"binop", op_kind: kind, lhs:1, rhs:2, dst:3 },
          { op:"ret", value:3 }
        ] }
      ] }]
    }
    return JSON.stringify_map(mir)
  }

  emit_compare_cfg(lhs, rhs, cmp) {
    return EmitMirFlow.emit_compare_cfg2(lhs, rhs, cmp, 0)
  }

  // emit_compare_cfg2: materialize=1 なら cond を copy して branch する
  emit_compare_cfg2(lhs, rhs, cmp, materialize) {
    // entry: const lhs/rhs; compare→r3; (optional copy r4=copy r3); branch r{3|4} then:1 else:2
    // then: const 1→r6; jump 3 | else: const 0→r6; jump 3 | merge: ret r6
    local insts0 = [
      { op:"const", dst:1, value:{ type:"i64", value: lhs } },
      { op:"const", dst:2, value:{ type:"i64", value: rhs } },
      { op:"compare", cmp: cmp, lhs:1, rhs:2, dst:3 }
    ]
    if materialize == 1 {
      LocalSSABox.ensure_after_phis_copy(insts0, 3, 4)
      insts0.push({ op:"branch", cond:4, "then":1, "else":2 })
    } else {
      insts0.push({ op:"branch", cond:3, "then":1, "else":2 })
    }
    local mir = {
      functions: [{ name:"main", params: [], blocks: [
        { id:0, instructions: insts0 },
        { id:1, instructions: [
          { op:"const", dst:6, value:{ type:"i64", value:1 } },
          { op:"jump", target:3 }
        ] },
        { id:2, instructions: [
          { op:"const", dst:6, value:{ type:"i64", value:0 } },
          { op:"jump", target:3 }
        ] },
        { id:3, instructions: [ { op:"ret", value:6 } ] }
      ] }]
    }
    return JSON.stringify_map(mir)
  }
}
