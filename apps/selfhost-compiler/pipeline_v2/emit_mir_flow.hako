using selfhost.common.json.mir_builder_min as MirJsonBuilderMin
using "apps/selfhost-compiler/pipeline_v2/local_ssa_box.hako" as LocalSSABox

flow EmitMirFlow {
  _int(n) { return "" + n }

  emit_return_int(v) {
    local b = MirJsonBuilderMin.make()
      |> MirJsonBuilderMin.start_module()
      |> MirJsonBuilderMin.start_function("main")
      |> MirJsonBuilderMin.start_block(0)
      |> MirJsonBuilderMin.add_const(1, v)
      |> MirJsonBuilderMin.add_ret(1)
      |> MirJsonBuilderMin.end_all()
    return MirJsonBuilderMin.to_string(b)
  }

  _map_binop(opk) {
    if opk == "+" { return "Add" }
    if opk == "-" { return "Sub" }
    if opk == "*" { return "Mul" }
    if opk == "/" { return "Div" }
    if opk == "%" { return "Mod" }
    return opk
  }

  emit_binop(lhs, rhs, opk) {
    local kind = EmitMirFlow._map_binop(opk)
    local b = MirJsonBuilderMin.make()
      |> MirJsonBuilderMin.start_module()
      |> MirJsonBuilderMin.start_function("main")
      |> MirJsonBuilderMin.start_block(0)
      |> MirJsonBuilderMin.add_const(1, lhs)
      |> MirJsonBuilderMin.add_const(2, rhs)
      |> MirJsonBuilderMin.add_binop(kind, 1, 2, 3)
      |> MirJsonBuilderMin.add_ret(3)
      |> MirJsonBuilderMin.end_all()
    return MirJsonBuilderMin.to_string(b)
  }

  emit_compare_cfg(lhs, rhs, cmp) {
    return EmitMirFlow.emit_compare_cfg2(lhs, rhs, cmp, 0)
  }

  // emit_compare_cfg2: materialize=1 なら cond を copy して branch する
  emit_compare_cfg2(lhs, rhs, cmp, materialize) {
    // entry: const lhs/rhs; compare→r3; (optional copy r4=copy r3); branch r{3|4} then:1 else:2
    // then: const 1→r6; jump 3 | else: const 0→r6; jump 3 | merge: ret r6
    // Builder-based emission
    local b = MirJsonBuilderMin.make()
      |> MirJsonBuilderMin.start_module()
      |> MirJsonBuilderMin.start_function("main")
      |> MirJsonBuilderMin.start_block(0)
      |> MirJsonBuilderMin.add_const(1, lhs)
      |> MirJsonBuilderMin.add_const(2, rhs)
      |> MirJsonBuilderMin.add_compare(cmp, 1, 2, 3)
      |> MirJsonBuilderMin.add_branch(3, 1, 2)
      |> MirJsonBuilderMin.end_block_continue()
      |> MirJsonBuilderMin.start_block(1)
      |> MirJsonBuilderMin.add_const(6, 1)
      |> MirJsonBuilderMin.add_jump(3)
      |> MirJsonBuilderMin.end_block_continue()
      |> MirJsonBuilderMin.start_block(2)
      |> MirJsonBuilderMin.add_const(6, 0)
      |> MirJsonBuilderMin.add_jump(3)
      |> MirJsonBuilderMin.end_block_continue()
      |> MirJsonBuilderMin.start_block(3)
      |> MirJsonBuilderMin.add_ret(6)
      |> MirJsonBuilderMin.end_all()
    return MirJsonBuilderMin.to_string(b)
  }

  // emit_loop_counter: while (i < limit) { i = i + 1 } ; return i
  // Minimal loop CFG without PHI by updating the same dst id for 'i'.
  // Blocks:
  //   0: const i=0 -> r1; const limit -> r2; const one=1 -> r4; jump 1
  //   1: compare lt r1 r2 -> r3; branch r3 then:2 else:3
  //   2: binop add r1 r4 -> r1; jump 1
  //   3: ret r1
  emit_loop_counter(limit) {
    local lim = limit
    local b = MirJsonBuilderMin.make()
      |> MirJsonBuilderMin.start_module()
      |> MirJsonBuilderMin.start_function("main")
      |> MirJsonBuilderMin.start_block(0)
      |> MirJsonBuilderMin.add_const(1, 0)
      |> MirJsonBuilderMin.add_const(2, lim)
      |> MirJsonBuilderMin.add_const(4, 1)
      |> MirJsonBuilderMin.add_jump(1)
      |> MirJsonBuilderMin.end_block_continue()
      |> MirJsonBuilderMin.start_block(1)
      |> MirJsonBuilderMin.add_compare("Lt", 1, 2, 3)
      |> MirJsonBuilderMin.add_branch(3, 2, 3)
      |> MirJsonBuilderMin.end_block_continue()
      |> MirJsonBuilderMin.start_block(2)
      |> MirJsonBuilderMin.add_binop("Add", 1, 4, 1)
      |> MirJsonBuilderMin.add_jump(1)
      |> MirJsonBuilderMin.end_block_continue()
      |> MirJsonBuilderMin.start_block(3)
      |> MirJsonBuilderMin.add_ret(1)
      |> MirJsonBuilderMin.end_all()
    return MirJsonBuilderMin.to_string(b)
  }
}
