using "apps/lib/json_native/stringify.hako" as JSON
using "apps/selfhost-compiler/common/json_emit_box.hako" as JsonEmitBox

flow EmitMirFlowMap {
  _i(n) { return n }

  _empty_arr() { return new ArrayBox() }

  _instr_const(dst, val) {
    local v = {type: "i64", value: EmitMirFlowMap._i(val)}
    return {op: "const", dst: EmitMirFlowMap._i(dst), value: v}
  }
  _instr_ret(val) {
    return {op: "ret", value: EmitMirFlowMap._i(val)}
  }
  _instr_binop(kind, lhs, rhs, dst) {
    return {op: "binop", op_kind: kind, lhs: EmitMirFlowMap._i(lhs), rhs: EmitMirFlowMap._i(rhs), dst: EmitMirFlowMap._i(dst)}
  }
  _instr_compare(cmp, lhs, rhs, dst) {
    return {op: "compare", cmp: cmp, lhs: EmitMirFlowMap._i(lhs), rhs: EmitMirFlowMap._i(rhs), dst: EmitMirFlowMap._i(dst)}
  }
  _instr_branch(cond, then_id, else_id) {
    return {op: "branch", cond: EmitMirFlowMap._i(cond), then: EmitMirFlowMap._i(then_id), else: EmitMirFlowMap._i(else_id)}
  }
  _instr_jump(target) {
    return {op: "jump", target: EmitMirFlowMap._i(target)}
  }
  _block(id, insts) {
    return {id: EmitMirFlowMap._i(id), instructions: insts}
  }
  _single_function_main(blocks) {
    local f = {name: "main", params: [], blocks: blocks}
    local fns = [f]
    return {functions: fns}
  }

  emit_return_int(v) {
    local insts = EmitMirFlowMap._empty_arr()
    insts.push(EmitMirFlowMap._instr_const(1, v))
    insts.push(EmitMirFlowMap._instr_ret(1))
    local blocks = EmitMirFlowMap._empty_arr()
    blocks.push(EmitMirFlowMap._block(0, insts))
    local mod = EmitMirFlowMap._single_function_main(blocks)
    return JsonEmitBox.to_json(mod)
  }

  emit_binop(lhs, rhs, opk) {
    local insts = EmitMirFlowMap._empty_arr()
    insts.push(EmitMirFlowMap._instr_const(1, lhs))
    insts.push(EmitMirFlowMap._instr_const(2, rhs))
    insts.push(EmitMirFlowMap._instr_binop(opk, 1, 2, 3))
    insts.push(EmitMirFlowMap._instr_ret(3))
    local blocks = EmitMirFlowMap._empty_arr()
    blocks.push(EmitMirFlowMap._block(0, insts))
    local mod = EmitMirFlowMap._single_function_main(blocks)
    return JsonEmitBox.to_json(mod)
  }

  // materialize: 0/1 (builder parity)
  emit_compare_cfg2(lhs, rhs, cmp, materialize) {
    local b0 = [
      EmitMirFlowMap._instr_const(1, lhs),
      EmitMirFlowMap._instr_const(2, rhs),
      EmitMirFlowMap._instr_compare(cmp, 1, 2, 3),
      EmitMirFlowMap._instr_branch(3, 1, 2)
    ]

    local b1 = [EmitMirFlowMap._instr_const(6, 1), EmitMirFlowMap._instr_jump(3)]

    local b2 = [EmitMirFlowMap._instr_const(6, 0), EmitMirFlowMap._instr_jump(3)]

    local b3 = [EmitMirFlowMap._instr_ret(6)]

    local blocks = [
      EmitMirFlowMap._block(0, b0),
      EmitMirFlowMap._block(1, b1),
      EmitMirFlowMap._block(2, b2),
      EmitMirFlowMap._block(3, b3)
    ]
    local mod = EmitMirFlowMap._single_function_main(blocks)
    return JsonEmitBox.to_json(mod)
  }

  emit_loop_counter(limit) {
    local b0 = [
      EmitMirFlowMap._instr_const(1, 0),
      EmitMirFlowMap._instr_const(2, limit),
      EmitMirFlowMap._instr_const(4, 1),
      EmitMirFlowMap._instr_jump(1)
    ]

    local b1 = [EmitMirFlowMap._instr_compare("Lt", 1, 2, 3), EmitMirFlowMap._instr_branch(3, 2, 3)]

    local b2 = [EmitMirFlowMap._instr_binop("Add", 1, 4, 1), EmitMirFlowMap._instr_jump(1)]

    local b3 = [EmitMirFlowMap._instr_ret(1)]

    local blocks = [
      EmitMirFlowMap._block(0, b0),
      EmitMirFlowMap._block(1, b1),
      EmitMirFlowMap._block(2, b2),
      EmitMirFlowMap._block(3, b3)
    ]
    local mod = EmitMirFlowMap._single_function_main(blocks)
    return JsonEmitBox.to_json(mod)
  }
}
