// ParserNumberScanBox — scan integer literal starting at index i
// Returns: "{"type":"Int","value":<digits>}@<pos>"

static box ParserNumberScanBox {
  _i2s(v) { return "" + v }
  _is_digit(ch) { return ch >= "0" && ch <= "9" }

  scan_int(src, i) {
    if src == null { return "{"type":"Int","value":0}@" + me._i2s(i) }
    local n = src.length()
    local j = i
    local cont = 1
    local guard = 0
    local max = 100000
    loop(cont == 1) {
      if guard > max { cont = 0 } else { guard = guard + 1 }
      if j < n {
        if me._is_digit(src.substring(j, j+1)) { j = j + 1 } else { cont = 0 }
      } else { cont = 0 }
    }
    local s = src.substring(i, j)
    if s.length() == 0 { s = "0" }
    return "{"type":"Int","value":" + s + "}@" + me._i2s(j)
  }
}
