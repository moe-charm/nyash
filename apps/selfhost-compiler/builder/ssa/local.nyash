// builder/ssa/local.nyash — LocalSSA minimal（安全：挙動不変）
// 目的:
// - Stage‑1 JSON / MIR(JSON v0) のうち、既知の最小パターンで
//   「ブロック内にオペランドが材化されている（LocalSSA）」ことを軽く検証・整形する。
// - 既定では再配線（Copy挿入）等は行わず、将来の拡張に備えた安全な足場のみを提供する。

static box LocalSSA {
  // --- 内部ヘルパ ---
  // trace fields are created on demand (dynamic properties)
  _index_of(hay, needle) { return hay.indexOf(needle) }
  _last_index_of(hay, needle) { return hay.lastIndexOf(needle) }
  _index_of_from(hay, needle, pos) {
    if pos < 0 { pos = 0 }
    local n = hay.length()
    if pos >= n { return -1 }
    local m = needle.length()
    if m <= 0 { return pos }
    local i = pos
    local limit = n - m
    loop (i <= limit) {
      local seg = hay.substring(i, i + m)
      if seg == needle { return i }
      i = i + 1
    }
    return -1
  }
  _read_digits(text, pos) {
    local out = ""
    local i = pos
    loop(true) {
      local ch = text.substring(i, i+1)
      if ch == "" { break }
      if ch >= "0" && ch <= "9" { out = out + ch  i = i + 1 } else { break }
    }
    return out
  }
  _count_occurs(hay, needle) {
    if hay == null { return 0 }
    if needle == null { return 0 }
    local n = 0
    local i = 0
    loop(true) {
      local p = hay.indexOf(needle)
      if p < 0 { break }
      n = n + 1
      hay = hay.substring(p + needle.length(), hay.length())
    }
    return n
  }
  _to_int(digits) {
    if digits == null { return 0 }
    local n = digits.length()
    if n == 0 { return 0 }
    local i = 0
    local acc = 0
    loop(i < n) {
      local ch = digits.substring(i, i+1)
      // map '0'..'9' to 0..9 without match (Stage‑1 friendly)
      local idxs = "0123456789"
      local d = idxs.indexOf(ch)
      if d < 0 { break }
      acc = acc * 10 + d
      i = i + 1
    }
    return acc
  }
  _seek_obj_start(text, from_pos) {
    local i = from_pos
    local start = from_pos
    loop(i >= 0) {
      local ch = text.substring(i, i+1)
      if ch == "{" { start = i  break }
      i = i - 1
    }
    return start
  }
  _seek_obj_end(text, obj_start) {
    local i = obj_start
    local depth = 0
    loop(true) {
      local ch = text.substring(i, i+1)
      if ch == "" { break }
      if ch == "{" { depth = depth + 1 } else { if ch == "}" { depth = depth - 1 } }
      if depth == 0 { return i + 1 }
      i = i + 1
    }
    return i
  }
  _block_insts_start(mjson, before_pos) {
    // find the nearest instructions array start that encloses before_pos
    local prefix = mjson.substring(0, before_pos)
    local p = prefix.lastIndexOf("\"instructions\":[")
    if p < 0 { return -1 }
    return p + 16 // len of "\"instructions\":["
  }
  _block_insts_end(mjson, insts_start) {
    // matching bracket for this instructions array
    local i = insts_start
    local depth = 1
    loop(true) {
      local ch = mjson.substring(i, i+1)
      if ch == "" { break }
      if ch == "[" { depth = depth + 1 } else { if ch == "]" { depth = depth - 1 } }
      if depth == 0 { return i }
      i = i + 1
    }
    return i
  }
  _max_dst_id(mjson) {
    local pos = 0
    local maxv = 0
    loop(true) {
      local p = me._index_of_from(mjson, "\"dst\":", pos)
      if p < 0 { break }
      local digits = me._read_digits(mjson, p + 6)
      if digits != "" {
        local acc = me._to_int(digits)
        if acc > maxv { maxv = acc }
      }
      pos = p + 6
    }
    return maxv
  }
  _is_mir_json(text) {
    if text == null { return 0 }
    // ごく簡易判定（"functions" を含む）
    if text.indexOf("\"functions\"") >= 0 { return 1 }
    return 0
  }
  _is_stage1_json(text) {
    if text == null { return 0 }
    // ごく簡易判定（"version" と "kind" を含む）
    if text.indexOf("\"version\"") >= 0 && text.indexOf("\"kind\"") >= 0 { return 1 }
    return 0
  }

  // MIR(JSON v0) 向けの軽量サニタイズ（挙動不変）
  _sanitize_mir_local(text) {
    // Trace locals (per-call)
    local t_branches = 0
    local t_copies = 0
    // Block-id trace accumulator (per-call, persisted back at end)
    local bid_csv = me._trace_copy_blocks_csv
    if bid_csv == null { bid_csv = "" }
    // LocalSSA: ensure branch(cond) is materialized in the same block by inserting a copy
    if text == null { return text }
    local cur = 0
    local out = text
    loop(true) {
      local op_pos = me._index_of_from(out, "\"op\":\"branch\"", cur)
      if op_pos < 0 { break }
      t_branches = t_branches + 1
      // Identify instruction object bounds
      local obj_start = me._seek_obj_start(out, op_pos)
      local obj_end = me._seek_obj_end(out, obj_start)
      // Parse cond id
      local cond_key = "\"cond\":"
      local cpos = me._index_of_from(out, cond_key, obj_start)
      if cpos < 0 || cpos >= obj_end { cur = obj_end  continue }
      local digits = me._read_digits(out, cpos + cond_key.length())
      if digits == "" { cur = obj_end  continue }
      // Detect whether dst:<cond> exists within this block before branch
      local insts_start = me._block_insts_start(out, obj_start)
      if insts_start < 0 { cur = obj_end  continue }
      local has_def = 0
      local def_pat = "\"dst\":" + digits
      // Search between insts_start..obj_start
      local scan = insts_start
      loop(true) {
        local p = me._index_of_from(out, def_pat, scan)
        if p < 0 || p >= obj_start { break }
        has_def = 1
        break
      }
      if has_def == 1 {
        cur = obj_end
        continue
      }
      // Insert copy after PHI cluster at block head
      // Trace: capture block id of this branch's block
      local bid = 0
      // Find nearest '"id":<n>' before this block's instructions
      local id_pos = me._last_index_of(out.substring(0, insts_start), "\"id\":")
      if id_pos >= 0 {
        local id_digits = me._read_digits(out, id_pos + 6)
        if id_digits != "" { bid = me._to_int(id_digits)
          if bid_csv == "" { bid_csv = "" + bid } else { bid_csv = bid_csv + "," + bid }
        }
      }
      // Compute insertion point just after contiguous PHI nodes
      local insert_at = insts_start
      {
        local scan = insts_start
        loop(true) {
          local pphi = me._index_of_from(out, "\"op\":\"phi\"", scan)
          if pphi < 0 || pphi >= obj_start { break }
          local sphi = me._seek_obj_start(out, pphi)
          local ephi = me._seek_obj_end(out, sphi)
          insert_at = ephi
          scan = ephi
        }
      }
      local new_id = me._max_dst_id(out) + 1
      local copy_inst = "{\\\"op\\\":\\\"copy\\\",\\\"src\\\":" + digits + ",\\\"dst\\\":" + new_id + "},"
      out = out.substring(0, insert_at) + copy_inst + out.substring(insert_at, out.length())
      t_copies = t_copies + 1
      // Rewrite branch cond to new_id within obj segment (adjust obj positions by insertion)
      local delta = copy_inst.length()
      obj_start = obj_start + delta
      obj_end = obj_end + delta
      cpos = me._index_of_from(out, cond_key, obj_start)
      if cpos >= 0 && cpos < obj_end {
        // rebuild: prefix + key + new_id + suffix (skip old digits)
        local head = out.substring(0, cpos + cond_key.length())
        // skip old digits
        local di = cpos + cond_key.length()
        loop(true) {
          local ch = out.substring(di, di+1)
          if ch >= "0" && ch <= "9" { di = di + 1 } else { break }
        }
        local tail = out.substring(di, out.length())
        out = head + new_id + tail
        // adjust obj_end for digit length delta
        local old_len = digits.length()
        local new_len = 0
        local tmp = "" + new_id
        new_len = tmp.length()
        obj_end = obj_end - old_len + new_len
      }
      cur = obj_end
    }
    // Store last trace (always recorded, emission gated by _trace_on)
    me._trace_last_branches = t_branches
    me._trace_last_copies = t_copies
    me._trace_copy_blocks_csv = bid_csv
    return out
  }

  // Stage‑1 JSON 向けの軽量整形（挙動不変）
  _sanitize_stage1_local(text) {
    // Return(BinOp/Compare) の最小形は、そのまま MIR 側で const 展開されるため、
    // ここでは現状変更なし。将来、式列の中間結果を 
    //   - 局所的に Let 相当へ正規化
    // する足場をここに追加する。
    return text
  }

  // --- 公開API（CompilerBuilder.apply_all から呼ばれる） ---
  ensure_recv(json_text) {
    if me._is_mir_json(json_text) == 1 { return me._sanitize_mir_local(json_text) }
    if me._is_stage1_json(json_text) == 1 { return me._sanitize_stage1_local(json_text) }
    return json_text
  }

  ensure_args(json_text) {
    if me._is_mir_json(json_text) == 1 { return me._sanitize_mir_local(json_text) }
    if me._is_stage1_json(json_text) == 1 { return me._sanitize_stage1_local(json_text) }
    return json_text
  }

  ensure_cond(json_text) {
    // 将来: branch(cond) の cond を同一ブロック内に必ず材化する（いまは整形のみ）
    if me._is_mir_json(json_text) == 1 { return me._sanitize_mir_local(json_text) }
    if me._is_stage1_json(json_text) == 1 { return me._sanitize_stage1_local(json_text) }
    return json_text
  }

  ensure_cmp(json_text) {
    if me._is_mir_json(json_text) == 1 { return me._sanitize_mir_local(json_text) }
    if me._is_stage1_json(json_text) == 1 { return me._sanitize_stage1_local(json_text) }
    return json_text
  }

  // Experimental: call-site operand materialization (minimal)
  // Insert copy instructions after the PHI cluster of a block when call/method/new operands
  // (recv/args) are not defined earlier in the same block. This keeps operands locally materialized
  // without changing semantics. JSON is manipulated textually to avoid adding heavy dependencies.
  ensure_calls(json_text) {
    if json_text == null { return json_text }
    // Only operate on MIR(JSON) text; Stage‑1 remains unchanged
    if me._is_mir_json(json_text) == 0 { return json_text }
    local out = json_text
    local cur = 0
    loop(true) {
      // Find next call-like instruction (v0 and v1 tolerant)
      local p1 = me._index_of_from(out, "\"op\":\"call\"", cur)
      local p2 = me._index_of_from(out, "\"op\":\"boxcall\"", cur)
      local p3 = me._index_of_from(out, "\"op\":\"newbox\"", cur)
      local p4 = me._index_of_from(out, "\"op\":\"mir_call\"", cur)
      // choose earliest >=0
      local op_pos = -1
      local kind = 0 // 1=call,2=boxcall,3=newbox,4=mir_call
      if p1 >= 0 { op_pos = p1  kind = 1 }
      if p2 >= 0 && (op_pos < 0 || p2 < op_pos) { op_pos = p2  kind = 2 }
      if p3 >= 0 && (op_pos < 0 || p3 < op_pos) { op_pos = p3  kind = 3 }
      if p4 >= 0 && (op_pos < 0 || p4 < op_pos) { op_pos = p4  kind = 4 }
      if op_pos < 0 { break }

      // Determine instruction object and enclosing block bounds
      local obj_start = me._seek_obj_start(out, op_pos)
      local obj_end = me._seek_obj_end(out, obj_start)
      local insts_start = me._block_insts_start(out, obj_start)
      if insts_start < 0 { cur = obj_end  continue }

      // Compute insertion point: after the contiguous PHI cluster at the block head
      local insert_at = insts_start
      local scan = insts_start
      loop(true) {
        local pphi = me._index_of_from(out, "\"op\":\"phi\"", scan)
        if pphi < 0 || pphi >= obj_start { break }
        local sphi = me._seek_obj_start(out, pphi)
        local ephi = me._seek_obj_end(out, sphi)
        insert_at = ephi
        scan = ephi
      }

      // Inline helpers are expanded where needed（Nyash: avoid nested func capture for portability）

      // V0: args array inside the instruction object
      if kind == 1 || kind == 2 || kind == 3 {
        // Receiver for boxcall
        if kind == 2 {
          local bk = "\"box\":"
          local bp = me._index_of_from(out, bk, obj_start)
          if bp >= 0 && bp < obj_end {
            local digits = me._read_digits(out, bp + bk.length())
            // Check if dst:<digits> exists before this instruction in the block
            local has_def = 0
            if digits != "" {
              local def_pat = "\"dst\":" + digits
              local s = insts_start
              loop(true) {
                local p = me._index_of_from(out, def_pat, s)
                if p < 0 || p >= obj_start { break }
                has_def = 1
                break
              }
            }
            if digits != "" && has_def == 0 {
              // Insert copy and rewrite box id
              local new_id = me._max_dst_id(out) + 1
              local copy_inst = "{\\\"op\\\":\\\"copy\\\",\\\"src\\\":" + digits + ",\\\"dst\\\":" + new_id + "},"
              out = out.substring(0, insert_at) + copy_inst + out.substring(insert_at, out.length())
              local delta = copy_inst.length()
              if insert_at <= obj_start { obj_start = obj_start + delta  obj_end = obj_end + delta }
              // rewrite digits at bp
              local head = out.substring(0, bp + bk.length())
              local di = bp + bk.length()
              loop(true) {
                local ch = out.substring(di, di+1)
                if ch >= "0" && ch <= "9" { di = di + 1 } else { break }
              }
              local tail = out.substring(di, out.length())
              out = head + new_id + tail
            }
          }
        }
        // Args list
        local ak = me._index_of_from(out, "\"args\":[", obj_start)
        if ak >= 0 && ak < obj_end {
          // find end of args list (first closing ']' after ak)
          local i = ak + 8
          local rb = i
          loop(true) {
            local ch = out.substring(i, i+1)
            if ch == "]" || ch == "" { rb = i  break }
            i = i + 1
          }
          // iterate over digits inside args
          local pos = ak + 8
          loop(pos < rb) {
            local ch = out.substring(pos, pos+1)
            if ch >= "0" && ch <= "9" {
              local digits = me._read_digits(out, pos)
              // materialize this operand if needed
              if digits != "" {
                // Check local def
                local has_def = 0
                local def_pat = "\"dst\":" + digits
                local s = insts_start
                loop(true) {
                  local p = me._index_of_from(out, def_pat, s)
                  if p < 0 || p >= obj_start { break }
                  has_def = 1
                  break
                }
                if has_def == 0 {
                  local new_id = me._max_dst_id(out) + 1
                  local copy_inst = "{\\\"op\\\":\\\"copy\\\",\\\"src\\\":" + digits + ",\\\"dst\\\":" + new_id + "},"
                  out = out.substring(0, insert_at) + copy_inst + out.substring(insert_at, out.length())
                  local delta = copy_inst.length()
                  if insert_at <= obj_start { obj_start = obj_start + delta  obj_end = obj_end + delta }
                  // rewrite occurrence inside [ak..rb)
                  local head = out.substring(0, ak)
                  local mid = out.substring(ak, rb)
                  local q = mid.indexOf(digits)
                  if q >= 0 {
                    mid = mid.substring(0, q) + new_id + mid.substring(q + digits.length(), mid.length())
                    out = head + mid + out.substring(rb, out.length())
                    // recompute bounds
                    insts_start = me._block_insts_start(out, obj_start)
                    insert_at = insts_start
                    scan = insts_start
                    loop(true) {
                      local pphi2 = me._index_of_from(out, "\"op\":\"phi\"", scan)
                      if pphi2 < 0 || pphi2 >= obj_start { break }
                      local sphi2 = me._seek_obj_start(out, pphi2)
                      local ephi2 = me._seek_obj_end(out, sphi2)
                      insert_at = ephi2
                      scan = ephi2
                    }
                    // refresh rb & pos relative to new string
                    rb = me._index_of_from(out, "]", ak + 8)
                    if rb < 0 { rb = obj_end }
                    pos = ak + 8
                    continue
                  }
                }
              }
              // Move after this number (recompute rb due to potential rewrite)
              rb = me._index_of_from(out, "]", ak + 8)
              if rb < 0 { rb = obj_end }
              pos = ak + 8
              // advance to next non-digit to avoid infinite loop
              loop(true) {
                local c2 = out.substring(pos, pos+1)
                if !(c2 >= "0" && c2 <= "9") { break }
                pos = pos + 1
              }
            } else {
              pos = pos + 1
            }
          }
        }
      } else {
        // V1: mir_call has args in nested object
        local mk = "\"mir_call\":{"
        local mp = me._index_of_from(out, mk, obj_start)
        if mp >= 0 && mp < obj_end {
          local ak = me._index_of_from(out, "\"args\":[", mp)
          if ak >= 0 && ak < obj_end {
            local i = ak + 8
            local rb = i
            loop(true) {
              local ch = out.substring(i, i+1)
              if ch == "]" || ch == "" { rb = i  break }
              i = i + 1
            }
            local pos = ak + 8
            loop(pos < rb) {
              local ch = out.substring(pos, pos+1)
              if ch >= "0" && ch <= "9" {
                local digits = me._read_digits(out, pos)
                // materialize this operand if needed
                if digits != "" {
                  local has_def = 0
                  local def_pat = "\"dst\":" + digits
                  local s = insts_start
                  loop(true) {
                    local p = me._index_of_from(out, def_pat, s)
                    if p < 0 || p >= obj_start { break }
                    has_def = 1
                    break
                  }
                  if has_def == 0 {
                    local new_id = me._max_dst_id(out) + 1
                    local copy_inst = "{\\\"op\\\":\\\"copy\\\",\\\"src\\\":" + digits + ",\\\"dst\\\":" + new_id + "},"
                    out = out.substring(0, insert_at) + copy_inst + out.substring(insert_at, out.length())
                    local delta = copy_inst.length()
                    if insert_at <= obj_start { obj_start = obj_start + delta  obj_end = obj_end + delta }
                    local head = out.substring(0, ak)
                    local mid = out.substring(ak, rb)
                    local q = mid.indexOf(digits)
                    if q >= 0 {
                      mid = mid.substring(0, q) + new_id + mid.substring(q + digits.length(), mid.length())
                      out = head + mid + out.substring(rb, out.length())
                      insts_start = me._block_insts_start(out, obj_start)
                      insert_at = insts_start
                      scan = insts_start
                      loop(true) {
                        local pphi2 = me._index_of_from(out, "\"op\":\"phi\"", scan)
                        if pphi2 < 0 || pphi2 >= obj_start { break }
                        local sphi2 = me._seek_obj_start(out, pphi2)
                        local ephi2 = me._seek_obj_end(out, sphi2)
                        insert_at = ephi2
                        scan = ephi2
                      }
                      rb = me._index_of_from(out, "]", ak + 8)
                      if rb < 0 { rb = obj_end }
                      pos = ak + 8
                      continue
                    }
                  }
                }
                rb = me._index_of_from(out, "]", ak + 8)
                if rb < 0 { rb = obj_end }
                pos = ak + 8
                loop(true) {
                  local c2 = out.substring(pos, pos+1)
                  if !(c2 >= "0" && c2 <= "9") { break }
                  pos = pos + 1
                }
              } else {
                pos = pos + 1
              }
            }
          }
        }
      }

      // advance cursor beyond this instruction object
      cur = obj_end
    }
    return out
  }

  // --- Trace API (既定OFF) ---
  trace_enable(on) {
    if on { me._trace_on = 1 } else { me._trace_on = 0 }
    return me._trace_on
  }
  // Return MapBox { branches: <int>, copies: <int> }
  trace_get_map() {
    local m = new MapBox()
    m.set("branches", me._trace_last_branches)
    m.set("copies", me._trace_last_copies)
    m.set("copy_blocks", me._trace_copy_blocks_csv)
    return m
  }
  // Compact string summary (for ad-hoc dev prints)
  trace_summary() {
    local b = me._trace_last_branches
    local c = me._trace_last_copies
    local blk = me._trace_copy_blocks_csv
    return "branches=" + b + ", copies=" + c + ", blocks=[" + blk + "]"
  }

  // Post-hoc summary computed from a given JSON text (stateless helper)
  trace_summary_after(text) {
    if text == null { return "branches=0, copies=0, blocks=[]" }
    local b = me._count_occurs(text, "\"op\":\"branch\"")
    // handle both properly-quoted and over-escaped variants for copy op
    local c = me._count_occurs(text, "\"op\":\"copy\"") + me._count_occurs(text, "\\\"op\\\":\\\"copy\\\"")
    return "branches=" + b + ", copies=" + c + ", blocks=[]"
  }
}
