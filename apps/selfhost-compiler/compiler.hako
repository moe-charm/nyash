// Selfhost Compiler MVP (Phase 15.3)
// Reads tmp/ny_parser_input.ny and prints a minimal JSON v0 program.
// Components are split under boxes/ and included here.

// Prefer using for module declaration (Runner strips and registers)
using "apps/selfhost-compiler/boxes/parser/parser_box.hako" as ParserBoxMod
// Parser dependencies (Phase 2 refactoring: hierarchical structure)
using "apps/selfhost-compiler/boxes/parser/scan/parser_string_utils_box.hako"
using "apps/selfhost-compiler/boxes/parser/scan/parser_ident_scan_box.hako"
using "apps/selfhost-compiler/boxes/parser/scan/parser_number_scan_box.hako"
using "apps/selfhost-compiler/boxes/parser/scan/parser_string_scan_box.hako"
using "apps/selfhost-compiler/boxes/parser/using/using_collector_box.hako"
using "apps/selfhost-compiler/boxes/parser/expr/parser_expr_box.hako"
using "apps/selfhost-compiler/boxes/parser/expr/parser_peek_box.hako"
using "apps/selfhost-compiler/boxes/parser/expr/parser_literal_box.hako"
using "apps/selfhost-compiler/boxes/parser/stmt/parser_stmt_box.hako"
using "apps/selfhost-compiler/boxes/parser/stmt/parser_control_box.hako"
using "apps/selfhost-compiler/boxes/parser/stmt/parser_exception_box.hako"
using "apps/selfhost-compiler/boxes/json_program_box.hako"
using "apps/selfhost-compiler/boxes/emitter_box.hako" as EmitterBoxMod
// Pipeline v2 (emit-only; Box-First architecture; --pipeline-v2)
using "apps/selfhost-compiler/pipeline_v2/execution_pipeline_box.hako" as PipelineMod
using "apps/selfhost-compiler/pipeline_v2/pipeline.hako" as PipelineV2
using "apps/selfhost-compiler/pipeline_v2/header_emit_box.hako" as HeaderEmitBox
// Note (Phase 15.7): keep includes minimal for --min-json path

// (removed) Transitional duplicate using lines to avoid resolver duplicate-import error

// Local helper box: minimal Stage​‑1 header emitter (prelude​‑free)
// (removed) Local helper was replaced by pipeline_v2/HeaderEmitBox

static box Main {
  // ---- Arg helper ----
  has_arg(args, name) {
    if args == null { return 0 }
    local n = args.length()
    local i = 0
    loop(i < n) {
      if args.get(i) == name { return 1 }
      i = i + 1
    }
    return 0
  }
  // ---- IO helper ----
  read_all(path) {
    if path == null { return "return 1+2*3" }
    local fb = null
    // FileBox lives behind the plugin boundary; guard against absence.
    fb = new FileBox()
    if fb != null {
      local opened = fb.open(path, "r")
      if opened == 1 {
        local content = fb.read()
        fb.close()
        if content != null { return content }
      } else {
        // Ensure handle is closed even when open fails
        fb.close()
      }
    }
    // Fallback: keep legacy sample source (fail-fast path still returns valid Ny)
    return "return 1+2*3"
  }

  hex_digit(ch) {
    if ch == "0" { return 0 }
    if ch == "1" { return 1 }
    if ch == "2" { return 2 }
    if ch == "3" { return 3 }
    if ch == "4" { return 4 }
    if ch == "5" { return 5 }
    if ch == "6" { return 6 }
    if ch == "7" { return 7 }
    if ch == "8" { return 8 }
    if ch == "9" { return 9 }
    if ch == "a" { return 10 }
    if ch == "A" { return 10 }
    if ch == "b" { return 11 }
    if ch == "B" { return 11 }
    if ch == "c" { return 12 }
    if ch == "C" { return 12 }
    if ch == "d" { return 13 }
    if ch == "D" { return 13 }
    if ch == "e" { return 14 }
    if ch == "E" { return 14 }
    if ch == "f" { return 15 }
    if ch == "F" { return 15 }
    return -1
  }

  byte_to_char(v) {
    if v == 10 { return "\n" }
    if v == 13 { return "\r" }
    if v == 9 { return "\t" }
    if v >= 32 && v <= 126 {
      local ascii = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
      local idx = v - 32
      return ascii.substring(idx, idx + 1)
    }
    if v == 0 { return "" }
    return null
  }

  decode_hex_inline(hex) {
    if hex == null { return null }
    local n = hex.length()
    if n % 2 == 1 { return null }
    local out = ""
    local i = 0
    loop(i < n) {
      local hi = me.hex_digit(hex.substring(i, i + 1))
      local lo = me.hex_digit(hex.substring(i + 1, i + 2))
      if hi < 0 || lo < 0 { return null }
      local value = hi * 16 + lo
      local ch = me.byte_to_char(value)
      if ch == null { return null }
      out = out + ch
      i = i + 2
    }
    return out
  }

  // ---- JSON helpers ----
  esc_json(s) {
    local out = ""
    local i = 0
    local n = s.length()
    loop(i < n) {
      local ch = s.substring(i, i+1)
      if ch == "\\" { out = out + "\\\\" } else {
        if ch == "\"" { out = out + "\\\"" } else { out = out + ch }
      }
      i = i + 1
    }
    return out
  }

  // Parser delegation
  parse_program(src, stage3_flag) {
    local parser = new ParserBox()
    if stage3_flag == 1 { parser.stage3_enable(1) }
    // Collect using metadata (no-op acceptance in Stage‑15)
    parser.extract_usings(src)
    me._usings = parser.get_usings_json()
    return parser.parse_program2(src)
  }

  main(args) {
    // Early exit: when --min-json is requested, emit a minimal JSON header and return.
    // This avoids touching using/prelude and keeps child pipelines stable.
    local early_min = 0
    if args != null {
      local alen = args.length()
      local i = 0
      loop(i < alen) { if args.get(i) == "--min-json" { early_min = 1 } i = i + 1 }
    }
    if early_min == 1 {
      print("{\"version\":0,\"kind\":\"Program\"}")
      return 0
    }
    // Debug setup (dev-only; avoid DebugBox dependency in fallback VM)
    // me.dbg = new DebugBox()
    // me.dbg.set_enabled(0)

    // Source selection (EXE-first friendly)
    // - default: safe constant
    // - positional arg: treat as input file path
    // - --read-tmp: use tmp/ny_parser_input.ny (requires FileBox plugin)
    local src = "return 1+2*3"
    local read_tmp = 0
    local input_path = null
    local stage3_mode = 0
    local inline_hex = null
    // Phase A: compiler-track/ssa-trace are not used (min-json only)
    if args != null {
      local alen = args.length()
      local i = 0
      loop(i < alen) {
        local a = args.get(i)
        if a == "--" {
          // delimiter between runner args and child args
        } else if a == "--read-tmp" {
          read_tmp = 1
        } else {
          if a == "--source-inline" {
            if i + 1 < alen {
              inline_hex = args.get(i + 1)
              i = i + 1
            }
          } else {
            // (removed) compiler-track/ssa-trace
            if a == "--min-json" {
              /* handled later */
            } else {
              if a == "--emit-mir" {
                /* handled later */
              } else {
                if a == "--stage3" {
                  stage3_mode = 1
                } else {
                  if input_path == null { input_path = a }
                }
              }
            }
          }
        }
        i = i + 1
      }
    }
    local inline_src = null
    if inline_hex != null { inline_src = me.decode_hex_inline(inline_hex) }
    if inline_src != null {
      src = inline_src
    } else {
      if input_path != null {
        // Prefer explicit file when provided (requires FileBox plugin)
        local s1 = me.read_all(input_path)
        if s1 != null { src = s1 }
      } else {
        if read_tmp == 1 {
          // Optional: read tmp/ny_parser_input.ny (requires FileBox plugin; do not use in CI)
          local s2 = me.read_all("tmp/ny_parser_input.ny")
          if s2 != null { src = s2 }
        }
      }
    }

    // Gate: minimal JSON when requested via script arg
    local min_mode = me.has_arg(args, "--min-json")
    local emit_mir = me.has_arg(args, "--emit-mir")
    local emit_trace = me.has_arg(args, "--emit-trace")
    local json = null
    local pipeline_v2 = me.has_arg(args, "--pipeline-v2")
    // prefer_cfg: 0=Return-only, 1=CFG(no copy), 2=CFG(materialize copy)
    local prefer_cfg = 0
    if me.has_arg(args, "--prefer-cfg2") == 1 { prefer_cfg = 2 } else { if me.has_arg(args, "--prefer-cfg") == 1 { prefer_cfg = 1 } }
    local ast_json = null
    if min_mode == 1 {
      // Optional: pipeline v2 (emit-only). When enabled and not emitting MIR,
      // delegate parse→emit to ExecutionPipelineBox to keep flow explicit.
      if pipeline_v2 == 1 && emit_mir == 0 {
        local px = new PipelineMod()
        if stage3_mode == 1 { /* Parser stage3 is handled inside run_source via ParserBox */ }
        return px.run_source(src, stage3_mode)
      }
      // Default minimal AST JSON (Return(Int 0)); optional samples for dev
      // Flags: --min-json-binop, --min-json-cmp
      local has_binop = 0
      local has_cmp = 0
      if me.has_arg(args, "--min-json-binop") == 1 { has_binop = 1 }
      if me.has_arg(args, "--min-json-cmp") == 1 { has_cmp = 1 }
      // Fast path: when emit-mir is also requested
      if emit_mir == 1 {
        if pipeline_v2 == 1 {
          // Build minimal AST JSON according to flags, then lower via PipelineV2 with trace
          if has_binop == 1 {
            ast_json = "{\"version\":0,\"kind\":\"Program\",\"body\":[{\"type\":\"Return\",\"expr\":{\"type\":\"BinOp\",\"op\":\"Add\",\"lhs\":{\"type\":\"Int\",\"value\":2},\"rhs\":{\"type\":\"Int\",\"value\":5}}}]}"
          } else {
            if has_cmp == 1 {
              ast_json = "{\"version\":0,\"kind\":\"Program\",\"body\":[{\"type\":\"Return\",\"expr\":{\"type\":\"Compare\",\"op\":\"Gt\",\"lhs\":{\"type\":\"Int\",\"value\":5},\"rhs\":{\"type\":\"Int\",\"value\":4}}}]}"
            } else {
              ast_json = "{\"version\":0,\"kind\":\"Program\",\"body\":[{\"type\":\"Return\",\"expr\":{\"type\":\"Int\",\"value\":0}}]}"
            }
          }
          local trace = 0
          if emit_trace == 1 { trace = 1 }
          if trace == 1 {
            // dev-only: dump stage-1 json used for lowering
            print("[trace] ast_json=" + ast_json)
          }
          local out = PipelineV2.lower_stage1_to_mir_trace(ast_json, prefer_cfg, trace)
          if out != null { print(out) } else { print("{}") }
          return 0
        } else {
          // Legacy inline payloads (kept for stability)
          local out = null
          if has_cmp == 1 {
            out = "{\"functions\":[{\"name\":\"main\",\"params\":[],\"blocks\":[{\"id\":0,\"instructions\":[{\"op\":\"const\",\"value\":{\"type\":\"i64\",\"value\":5},\"dst\":1},{\"op\":\"const\",\"value\":{\"type\":\"i64\",\"value\":4},\"dst\":2},{\"op\":\"compare\",\"cmp\":\"Gt\",\"lhs\":1,\"rhs\":2,\"dst\":3},{\"op\":\"branch\",\"cond\":3,\"then\":1,\"else\":2}]},{\"id\":1,\"instructions\":[{\"op\":\"const\",\"value\":{\"type\":\"i64\",\"value\":1},\"dst\":6},{\"op\":\"jump\",\"target\":3}]},{\"id\":2,\"instructions\":[{\"op\":\"const\",\"value\":{\"type\":\"i64\",\"value\":0},\"dst\":6},{\"op\":\"jump\",\"target\":3}]},{\"id\":3,\"instructions\":[{\"op\":\"ret\",\"value\":6}]}]}]}"
          } else {
            if has_binop == 1 {
              out = "{\"functions\":[{\"name\":\"main\",\"params\":[],\"blocks\":[{\"id\":0,\"instructions\":[{\"op\":\"const\",\"value\":{\"type\":\"i64\",\"value\":2},\"dst\":1},{\"op\":\"const\",\"value\":{\"type\":\"i64\",\"value\":5},\"dst\":2},{\"op\":\"binop\",\"op_kind\":\"Add\",\"lhs\":1,\"rhs\":2,\"dst\":3},{\"op\":\"ret\",\"value\":3}]}]}]}"
            } else {
              out = "{\"functions\":[{\"name\":\"main\",\"params\":[],\"blocks\":[{\"id\":0,\"instructions\":[{\"op\":\"const\",\"value\":{\"type\":\"i64\",\"value\":0},\"dst\":1},{\"op\":\"ret\",\"value\":1}]}]}]}"
            }
          }
          if out != null { print(out) } else { print("{}") }
          return 0
        }
      }
      if has_binop == 1 {
        // Return(BinOp(Int 2, Int 5) op:"Add")
        ast_json = "{\"version\":0,\"kind\":\"Program\",\"body\":[{\"type\":\"Return\",\"expr\":{\"type\":\"BinOp\",\"op\":\"Add\",\"lhs\":{\"type\":\"Int\",\"value\":2},\"rhs\":{\"type\":\"Int\",\"value\":5}}}]}"
      } else {
        if has_cmp == 1 {
          // Return(Compare(Int 5, Int 4) op:"Gt")
          ast_json = "{\"version\":0,\"kind\":\"Program\",\"body\":[{\"type\":\"Return\",\"expr\":{\"type\":\"Compare\",\"op\":\"Gt\",\"lhs\":{\"type\":\"Int\",\"value\":5},\"rhs\":{\"type\":\"Int\",\"value\":4}}}]}"
        } else {
          ast_json = "{\"version\":0,\"kind\":\"Program\",\"body\":[{\"type\":\"Return\",\"expr\":{\"type\":\"Int\",\"value\":0}}]}"
        }
      }
    } else {
      ast_json = me.parse_program(src, stage3_mode)
    }

    // Dev debug (opt-in): show ast_json size and head
    if me.has_arg(args, "--debug") == 1 {
      if ast_json != null {
        print("DBG ast_len=" + ast_json.length())
        local dbg_head = ast_json.substring(0, 100)
        print("DBG ast_head=" + dbg_head)
      } else {
        print("DBG ast_len=0")
      }
    }

    if min_mode == 1 && emit_mir == 0 {
      // Safety: when --min-json is requested without --emit-mir,
      // return the minimal AST JSON as-is to avoid heavier emitter paths.
      json = ast_json
    } else {
      if emit_mir == 1 {
        // Phase A: emit_mir path is disabled in minimal compiler
        // Future phases will re-enable via MirEmitterBox/PipelineV2.
        json = "{\"version\":0,\"kind\":\"Program\",\"body\":[]}" // placeholder
      } else {
        // Emit Stage‑1 JSON with metadata (requires parser-produced AST)
        json = EmitterBox.emit_program(ast_json, me._usings)
      }
    }

    // Output JSON (avoid ConsoleBox to prevent undefined/birth warnings)
    if json != null { print(json) } else { print("{}") }
    return 0
  }
}
