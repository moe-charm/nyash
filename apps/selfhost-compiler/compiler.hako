// Selfhost Compiler MVP (Phase 15.3)
// Reads tmp/ny_parser_input.ny and prints a minimal JSON v0 program.
// Components are split under boxes/ and included here.

// Prefer using for module declaration (Runner strips and registers)
using "apps/selfhost-compiler/boxes/parser_box.hako" as ParserBoxMod
using "apps/selfhost-compiler/boxes/emitter_box.hako" as EmitterBoxMod
// Pipeline v2 (emit-only; Box-First architecture; --pipeline-v2)
using "apps/selfhost-compiler/pipeline_v2/execution_pipeline_box.hako" as PipelineMod
// Note (Phase 15.7): keep includes minimal for --min-json path

// (removed) Transitional duplicate using lines to avoid resolver duplicate-import error

static box Main {
  // ---- Arg helper ----
  has_arg(args, name) {
    if args == null { return 0 }
    local n = args.length()
    local i = 0
    loop(i < n) {
      if args.get(i) == name { return 1 }
      i = i + 1
    }
    return 0
  }
  // ---- IO helper ----
  read_all(path) {
    // Quick-profile friendly stub: avoid FileBox in fallback VM
    // Return a safe sample source when file I/O is unavailable
    return "return 1+2*3"
  }

  // ---- JSON helpers ----
  esc_json(s) {
    local out = ""
    local i = 0
    local n = s.length()
    loop(i < n) {
      local ch = s.substring(i, i+1)
      if ch == "\\" { out = out + "\\\\" } else {
        if ch == "\"" { out = out + "\\\"" } else { out = out + ch }
      }
      i = i + 1
    }
    return out
  }

  // Parser delegation
  parse_program(src, stage3_flag) {
    local parser = new ParserBox()
    if stage3_flag == 1 { parser.stage3_enable(1) }
    // Collect using metadata (no-op acceptance in Stage‑15)
    parser.extract_usings(src)
    me._usings = parser.get_usings_json()
    return parser.parse_program2(src)
  }

  main(args) {
    // Debug setup (dev-only; avoid DebugBox dependency in fallback VM)
    // me.dbg = new DebugBox()
    // me.dbg.set_enabled(0)

    // Source selection (EXE-first friendly)
    // - default: safe constant
    // - positional arg: treat as input file path
    // - --read-tmp: use tmp/ny_parser_input.ny (requires FileBox plugin)
    local src = "return 1+2*3"
    local read_tmp = 0
    local input_path = null
    local stage3_mode = 0
    // Phase A: compiler-track/ssa-trace are not used (min-json only)
    if args != null {
      local alen = args.length()
      local i = 0
      loop(i < alen) {
        local a = args.get(i)
        if a == "--read-tmp" {
          read_tmp = 1
        } else {
          // (removed) compiler-track/ssa-trace
          if a == "--min-json" {
            /* handled later */
          } else {
            if a == "--emit-mir" {
              /* handled later */
            } else {
              if a == "--stage3" {
                stage3_mode = 1
              } else {
                if input_path == null { input_path = a }
              }
            }
          }
        }
        i = i + 1
      }
    }
    if input_path != null {
      // Prefer explicit file when provided (requires FileBox plugin)
      local s1 = me.read_all(input_path)
      if s1 != null { src = s1 }
    } else {
      if read_tmp == 1 {
        // Optional: read tmp/ny_parser_input.ny (requires FileBox plugin; do not use in CI)
        local s2 = me.read_all("tmp/ny_parser_input.ny")
        if s2 != null { src = s2 }
      }
    }

    // Gate: minimal JSON when requested via script arg
    local min_mode = me.has_arg(args, "--min-json")
    local emit_mir = me.has_arg(args, "--emit-mir")
    local json = null
    local pipeline_v2 = me.has_arg(args, "--pipeline-v2")
    local ast_json = null
    if min_mode == 1 {
      // Optional: pipeline v2 (emit-only). When enabled and not emitting MIR,
      // delegate parse→emit to ExecutionPipelineBox to keep flow explicit.
      if pipeline_v2 == 1 && emit_mir == 0 {
        local px = new PipelineMod()
        if stage3_mode == 1 { /* Parser stage3 is handled inside run_source via ParserBox */ }
        return px.run_source(src, stage3_mode)
      }
      // Default minimal AST JSON (Return(Int 0)); optional samples for dev
      // Flags: --min-json-binop, --min-json-cmp
      local has_binop = 0
      local has_cmp = 0
      if me.has_arg(args, "--min-json-binop") == 1 { has_binop = 1 }
      if me.has_arg(args, "--min-json-cmp") == 1 { has_cmp = 1 }
      // Fast path: when emit-mir is also requested, emit MIR(JSON) directly without emitter
      if emit_mir == 1 {
        local out = null
        if has_cmp == 1 {
          // Return(Compare(5,4) Gt) → minimal CFG
          out = "{\"functions\":[{\"name\":\"main\",\"params\":[],\"blocks\":[{\"id\":0,\"instructions\":[{\"op\":\"const\",\"value\":{\"type\":\"i64\",\"value\":5},\"dst\":1},{\"op\":\"const\",\"value\":{\"type\":\"i64\",\"value\":4},\"dst\":2},{\"op\":\"compare\",\"cmp\":\"Gt\",\"lhs\":1,\"rhs\":2,\"dst\":3},{\"op\":\"branch\",\"cond\":3,\"then\":1,\"else\":2}]},{\"id\":1,\"instructions\":[{\"op\":\"const\",\"value\":{\"type\":\"i64\",\"value\":1},\"dst\":6},{\"op\":\"jump\",\"target\":3}]},{\"id\":2,\"instructions\":[{\"op\":\"const\",\"value\":{\"type\":\"i64\",\"value\":0},\"dst\":6},{\"op\":\"jump\",\"target\":3}]},{\"id\":3,\"instructions\":[{\"op\":\"ret\",\"value\":6}]}]}]}"
        } else {
          if has_binop == 1 {
            // Return(BinOp(2,5) Add)
            out = "{\"functions\":[{\"name\":\"main\",\"params\":[],\"blocks\":[{\"id\":0,\"instructions\":[{\"op\":\"const\",\"value\":{\"type\":\"i64\",\"value\":2},\"dst\":1},{\"op\":\"const\",\"value\":{\"type\":\"i64\",\"value\":5},\"dst\":2},{\"op\":\"binop\",\"op_kind\":\"Add\",\"lhs\":1,\"rhs\":2,\"dst\":3},{\"op\":\"ret\",\"value\":3}]}]}]}"
          } else {
            // Return(Int 0)
            out = "{\"functions\":[{\"name\":\"main\",\"params\":[],\"blocks\":[{\"id\":0,\"instructions\":[{\"op\":\"const\",\"value\":{\"type\":\"i64\",\"value\":0},\"dst\":1},{\"op\":\"ret\",\"value\":1}]}]}]}"
          }
        }
        if out != null { print(out) } else { print("{}") }
        return 0
      }
      if has_binop == 1 {
        // Return(BinOp(Int 2, Int 5) op:"Add")
        ast_json = "{\"version\":0,\"kind\":\"Program\",\"body\":[{\"type\":\"Return\",\"expr\":{\"type\":\"BinOp\",\"op\":\"Add\",\"lhs\":{\"type\":\"Int\",\"value\":2},\"rhs\":{\"type\":\"Int\",\"value\":5}}}]}"
      } else {
        if has_cmp == 1 {
          // Return(Compare(Int 5, Int 4) op:"Gt")
          ast_json = "{\"version\":0,\"kind\":\"Program\",\"body\":[{\"type\":\"Return\",\"expr\":{\"type\":\"Compare\",\"op\":\"Gt\",\"lhs\":{\"type\":\"Int\",\"value\":5},\"rhs\":{\"type\":\"Int\",\"value\":4}}}]}"
        } else {
          ast_json = "{\"version\":0,\"kind\":\"Program\",\"body\":[{\"type\":\"Return\",\"expr\":{\"type\":\"Int\",\"value\":0}}]}"
        }
      }
    } else {
      ast_json = me.parse_program(src, stage3_mode)
    }

    // Dev debug (opt-in): show ast_json size and head
    if me.has_arg(args, "--debug") == 1 {
      if ast_json != null {
        print("DBG ast_len=" + ast_json.length())
        local dbg_head = ast_json.substring(0, 100)
        print("DBG ast_head=" + dbg_head)
      } else {
        print("DBG ast_len=0")
      }
    }

    if min_mode == 1 && emit_mir == 0 {
      // Safety: when --min-json is requested without --emit-mir,
      // return the minimal AST JSON as-is to avoid heavier emitter paths.
      json = ast_json
    } else {
      if emit_mir == 1 {
        // Phase A: emit_mir path is disabled in minimal compiler
        // Future phases will re-enable via MirEmitterBox/PipelineV2.
        json = "{\"version\":0,\"kind\":\"Program\",\"body\":[]}" // placeholder
      } else {
        // Emit Stage‑1 JSON with metadata (requires parser-produced AST)
        json = EmitterBox.emit_program(ast_json, me._usings)
      }
    }

    // Output JSON (avoid ConsoleBox to prevent undefined/birth warnings)
    if json != null { print(json) } else { print("{}") }
    return 0
  }
}
