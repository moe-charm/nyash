// dep_tree.nyash — Build dependency info for a Nyash script (include + using/module)

using selfhost.tools.dep_tree_core as Core
using "apps/selfhost/tools/dep_tree_annotator.hako" as DepTreeAnnotatorBox

static box DepTree {
  init { visited }

  // Public API: build tree for entry path
  build(entry_path) {
    me.visited = map({})
    return me.node(entry_path)
  }

  // Extract include paths from source: include "./path.nyash"
  extract_includes(src) {
    local out = new ArrayBox()
    if src == null { return out }
    local i = 0
    local n = src.size()
    loop(i < n) {
      local j = new StringStd().index_of_from(src, "include \"", i)
      if j < 0 { break }
      local k = j + 9 // after include "
      local q = new StringStd().index_of_from(src, "\"", k)
      if q < 0 { break }
      out.push(src.substring(k, q))
      i = q + 1
    }
    return out
  }

  // Extract using directives (script lines):
  //  using ns
  //  using ns as Alias
  //  using "path" as Name
  // and comment form: // @using ns[ as Alias]
  extract_usings(src) {
    local out = new ArrayBox()
    if src == null { return out }
    local lines = me.split_lines(src)
    local i = 0
    loop(i < lines.size()) {
      local line = lines.get(i).trim()
      local t = line
      local matched = false
      if t.startsWith("// @using ") { t = t.substring(10, t.size()).trim() matched = true }
      else if t.startsWith("using ") { t = t.substring(6, t.size()).trim() matched = true }

      if matched {
        // optional trailing semicolon
        if t.endsWith(";") { t = t.substring(0, t.size()-1).trim() }

        local rec = map({})
        // Split alias
        local as_pos = new StringStd().index_of_from(t, " as ", 0)
        local target = t
        local alias = null
        if as_pos >= 0 {
          target = t.substring(0, as_pos).trim()
          alias = t.substring(as_pos+4, t.size()).trim()
        }
        rec.set("target", target)
        if alias != null { rec.set("alias", alias) }
        // classify
        if target.startsWith("\"") || target.startsWith("./") || target.startsWith("/") || target.endsWith(".nyash") {
          rec.set("kind", "path")
          // strip quotes
          if target.startsWith("\"") { rec.set("target", target.substring(1, target.size()-1)) }
        } else {
          rec.set("kind", "ns")
        }
        out.push(rec)
      }
      i = i + 1
    }
    return out
  }

  // Extract modules mapping from // @module ns=path
  extract_modules(src) {
    local out = new ArrayBox()
    if src != null {
      local lines = me.split_lines(src)
      local i = 0
      loop(i < lines.size()) {
        local line = lines.get(i).trim()
        if line.startsWith("// @module ") {
          local rest = line.substring(11, line.size()).trim()
          local eq = new StringStd().index_of_from(rest, "=", 0)
          if eq > 0 {
            local ns = rest.substring(0, eq).trim()
            local path = rest.substring(eq+1, rest.size()).trim()
            path = me.strip_quotes(path)
            local m = map({ ns: ns, path: path })
            out.push(m)
          }
        }
        i = i + 1
      }
    }
    return out
  }

  // Build a node: { path, includes:[...], using:[...], modules:[...], children:[...] }
  node(path) {
    if me.visited.has(path) { return me.leaf(path) }
    me.visited.set(path, true)

    local m = map({ path: path, includes: new ArrayBox(), using: new ArrayBox(), modules: new ArrayBox(), children: new ArrayBox() })
    local src = Core.read_all(path)
    if src == null { m.set("error", "read_fail")  return m }

    local base_dir = Core.dirname(path)

    // includes
    local incs = me.extract_includes(src)
    m.set("includes", incs)
    // usings
    local us = me.extract_usings(src)
    m.set("using", us)
    // modules mapping (script-level)
    local mods = me.extract_modules(src)
    m.set("modules", mods)

    // children = includes + resolved using(path) + resolved using(ns via search paths)
    local children = new ArrayBox()
    // include children
    local i = 0
    loop(i < incs.size()) {
      local p = incs.get(i)
      local child_path = me.resolve_path(base_dir, p)
      if Core.file_exists(child_path) { DepTreeAnnotatorBox.annotate_include_resolved(m, p, child_path) }
      else { DepTreeAnnotatorBox.annotate_include_missing(m, p, child_path) }
      children.push(me.node(child_path))
      i = i + 1
    }
    // using(path) children
    i = 0
    loop(i < us.size()) {
      local u = us.get(i)
      if u.get("kind") == "path" {
        local p = u.get(\"target\")
        local child_path = me.resolve_path(base_dir, p)
        if Core.file_exists(child_path) { DepTreeAnnotatorBox.annotate_resolved_using(u, child_path)  children.push(me.node(child_path)) } else { DepTreeAnnotatorBox.annotate_path_missing(u, child_path) }
      }
      i = i + 1
    }
    // using(ns) children resolved via search paths
    local search = me.default_using_paths()
    i = 0
    loop(i < us.size()) {
      local u = us.get(i)
      if u.get("kind") == "ns" {
        local ns = u.get("target")
        local rel = ns.replace(".", "/") + ".nyash"
        local found = me.search_in_paths(base_dir, search, rel)
        if found != null { DepTreeAnnotatorBox.annotate_resolved_using(u, found)  children.push(me.node(found)) }
        else {
          // annotate unresolved
          u.set("unresolved", true)
          u.set("hint", rel)
        }
      }
      i = i + 1
    }

    m.set("children", children)
    return m
  }

  // Helpers
  ensure_arrays(m) {
    m.set("includes", new ArrayBox())
    m.set("using", new ArrayBox())
    m.set("modules", new ArrayBox())
    m.set("children", new ArrayBox())
    return m
  }

  default_using_paths() {
    // Best-effort defaults prioritized for selfhost
    local arr = new ArrayBox()
    arr.push("apps/selfhost")
    arr.push("apps")
    arr.push("lib")
    arr.push(".")
    return arr
  }

  split_lines(src) {
    local out = new ArrayBox()
    local i = 0
    local n = src.size()
    local start = 0
    loop(i <= n) {
      if i == n || src.substring(i, i+1) == "\n" {
        out.push(src.substring(start, i))
        start = i + 1
      }
      i = i + 1
    }
    return out
  }

  strip_quotes(s) {
    if s == null { return null }
    if s.size() >= 2 && s.substring(0,1) == "\"" && s.substring(s.size()-1, s.size()) == "\"" {
      return s.substring(1, s.size()-1)
    }
    return s
  }

  resolve_path(base, rel) {
    if rel.indexOf("/") == 0 { return rel }
    if rel.startsWith("./") || rel.startsWith("../") {
      return Core.join(base, rel)
    }
    return rel
  }

  search_in_paths(base, paths, rel) {
    // try relative to file first
    local j = Core.join(base, rel)
    if Core.file_exists(j) { return j }
    // then search list
    local i = 0
    loop(i < paths.size()) {
      local p = paths.get(i)
      local cand = Core.join(p, rel)
      if Core.file_exists(cand) { return cand }
      i = i + 1
    }
    return null
  }

  leaf(path) {
    return map({ path: path, children: new ArrayBox(), includes: new ArrayBox(), using: new ArrayBox(), modules: new ArrayBox(), note: "visited" })
  })
  }
}
