// mir_vm_min.hako — Ny製の最小MIR(JSON v0)実行器（const/compare/copy/branch/jump/ret の最小）
using "apps/selfhost/vm/boxes/op_handlers.hako" as OpHandlersBox
using "apps/selfhost/common/string_helpers.hako" as StringHelpers
using "apps/selfhost/common/string_ops.hako" as StringOps
using "apps/selfhost/common/json/utils/json_frag.hako" as JsonFragBox
using "apps/selfhost/vm/boxes/operator_box.hako" as OperatorBox
using "apps/selfhost/vm/boxes/compare_ops.hako" as CompareOpsBox
using "apps/selfhost/vm/boxes/phi_apply_box.hako" as PhiApplyBox
using "apps/selfhost/vm/boxes/guard_box.hako" as GuardBox
using "apps/selfhost/vm/boxes/result_box.hako" as Result
using "apps/selfhost/vm/boxes/phi_decode_box.hako" as PhiDecodeBox
using "apps/selfhost/vm/boxes/instruction_scanner.hako" as InstructionScannerBox

static box MirVmMin {
  _tprint(msg) {
    // Only emit hard errors by default; avoid env dependencies in Mini‑VM
    if msg.indexOf("[ERROR]") >= 0 { print(msg) }
    if msg.indexOf("[DEBUG]") >= 0 { print(msg) }
  }
  // Compatibility runner (prints and returns). Prefer run_min for quiet return-only.
  run(mjson) { local v = me._run_min(mjson) print(me._int_to_str(v)) return v }
  // New: quiet entry that returns the result without printing.
  run_min(mjson) { return me._run_min(mjson) }
  // Thin-mode runner (ret resolution simplified)
  run_thin(mjson) {
    // Inject a lightweight marker into JSON to toggle thin mode inside _run_min
    if mjson.substring(0,1) == "{" {
      local payload = mjson.substring(1, mjson.length())
      local j2 = "{\"__thin__\":1," + payload
      local v = me._run_min(j2)
      print(me._int_to_str(v))
      return v
    }
    // Fallback: no-op when input is unexpected
    local v = me._run_min(mjson)
    print(me._int_to_str(v))
    return v
  }

  // helpers
  _int_to_str(n) { return StringHelpers.int_to_str(n) }
  _is_numeric_str(s){ if s==null {return 0} local n=s.length() if n==0 {return 0} local i=0 if s.substring(0,1)=="-" { if n==1 {return 0} i=1 } loop(i<n){ local ch=s.substring(i,i+1) if ch<"0"||ch>"9" {return 0} i=i+1 } return 1 }
  _load_reg(regs,id){ local v=regs.get(""+id) if v==null {return 0} local s=""+v if me._is_numeric_str(s)==1 { return JsonFragBox._str_to_int(s) } return 0 }

  // block helpers
  _block_insts_start(mjson,bid){ local key="\"id\":"+me._int_to_str(bid) local p=mjson.indexOf(key) if p<0 {return -1} local q=StringOps.index_of_from(mjson,"\"instructions\":[",p) if q<0 {return -1} return q+16 }
  _seek_array_end(text, pos){ local i=pos local depth=1 loop(i < text.length()){ local ch=text.substring(i,i+1) if ch=="" {break} if ch=="[" {depth=depth+1} else { if ch=="]" {depth=depth-1} } if depth==0 {return i} i=i+1 } return i }
  _block_insts_end(mjson,insts_start){ return me._seek_array_end(mjson,insts_start) }
  _seek_obj_end(text, obj_start) { local i=obj_start local depth=0 local in_str=0 loop(i < text.length()){ local ch=text.substring(i,i+1) if ch=="" {break} if in_str==1 { if ch=="\\" { i=i+2 continue } if ch=="\"" { in_str=0 i=i+1 continue } i=i+1 continue } if ch=="\"" { in_str=1 i=i+1 continue } if ch=="{" { depth=depth+1 } else { if ch=="}" { depth=depth-1 } } if depth==0 { return i+1 } i=i+1 } return i }

  // local copy handler
  _handle_copy(seg, regs){ local dst=JsonFragBox.get_int(seg,"dst") local src=JsonFragBox.get_int(seg,"src") if dst==null || src==null {return} local v=regs.get(""+src) regs.set(""+dst, v) }

  _run_min(mjson) {
    // thin_mode=0: legacy heuristics（互換）; thin_mode=1: simplified ret
    local thin_mode = 0
    if mjson.indexOf("\"__thin__\":1") >= 0 { thin_mode = 1 }
    local regs = new MapBox()
    local last_cmp_dst = -1
    local last_cmp_val = 0
    // Optional: adopt OperatorBox for parity checks when JSON has a special marker
    local op_adopt = 0
    if mjson.indexOf("\"__op_adopt__\":1") >= 0 { op_adopt = 1 }
    // Track last binop materialization within the current scan window
    local last_binop_dst = -1
    local last_binop_val = 0
    local bb = 0
    local prev_bb = -1
    local steps = 0
    local max_steps = 200000
    loop(true){
      steps = steps + 1
      if steps > max_steps { return 0 }
      local start = me._block_insts_start(mjson, bb)
      me._tprint("[minivm] start="+me._int_to_str(start))
      if start < 0 { return 0 }
      local endp = me._block_insts_end(mjson, start)
      me._tprint("[minivm] endp="+me._int_to_str(endp))
      if endp <= start { return 0 }
      local inst_seg = mjson.substring(start, endp)
      me._tprint("[minivm] seglen="+me._int_to_str(inst_seg.length()))
      // scan objects in this block
      local scan_pos = 0
      local inst_count = 0
      local moved = 0
      loop(true){
        if scan_pos >= inst_seg.length() { break }
        local nxt = InstructionScannerBox.next(inst_seg, scan_pos)
        if nxt == null { break }
        local obj_start = nxt.get("start")
        local obj_end = nxt.get("end")
        local op = nxt.get("op")
        local seg = inst_seg.substring(obj_start, obj_end)
        if op == null { op = "" } if op == "null" { op = "" } if op == 0 { op = "" }
        if op == "" {
          if seg.indexOf("op_kind") >= 0 { op = "binop" } else {
            if seg.indexOf("lhs") >= 0 and seg.indexOf("rhs") >= 0 { op = "compare" } else {
              if seg.indexOf("cond") >= 0 { op = "branch" } else {
                if seg.indexOf("target") >= 0 { op = "jump" } else {
                  if seg.indexOf("src") >= 0 and seg.indexOf("dst") >= 0 { op = "copy" } else { op = "const" }
                }
              }
            }
          }
        }
        if op == "const" { OpHandlersBox.handle_const(seg, regs) }
        else if op == "copy" { me._handle_copy(seg, regs) }
        else if op == "binop" {
          OpHandlersBox.handle_binop(seg, regs)
          local bdst = JsonFragBox.get_int(seg, "dst")
          if bdst != null { last_binop_dst = bdst  last_binop_val = me._load_reg(regs, bdst) }
        }
        else if op == "compare" {
          me._tprint("[DEBUG] compare seg=" + seg)
          OpHandlersBox.handle_compare(seg, regs)
          local kdst = JsonFragBox.get_int(seg, "dst")
          me._tprint("[DEBUG] compare kdst=" + me._int_to_str(kdst))
          if kdst != null {
            last_cmp_dst = kdst
            last_cmp_val = me._load_reg(regs, kdst)
            me._tprint("[DEBUG] compare last_cmp_dst=" + me._int_to_str(last_cmp_dst) + " last_cmp_val=" + me._int_to_str(last_cmp_val))
            me._tprint("[DEBUG] compare reg["+me._int_to_str(kdst)+"]=" + regs.get(""+kdst))
          }
          // Early-return optimization for simple compare→ret in same block
          local tail = inst_seg.substring(obj_end, inst_seg.length())
          if tail.indexOf("\"op\":\"ret\"") >= 0 {
            me._tprint("[DEBUG] compare found ret in tail")
            local ridt = JsonFragBox.get_int(tail, "value")
            me._tprint("[DEBUG] compare ridt=" + me._int_to_str(ridt))
            if ridt != null {
              if ridt == last_cmp_dst {
                me._tprint("[DEBUG] compare early return with val=" + me._int_to_str(last_cmp_val))
                return last_cmp_val
              }
            }
          }
        }
        else if op == "branch" {
          local c = JsonFragBox.get_int(seg, "cond")
          local t = JsonFragBox.get_int(seg, "then")
          local e = JsonFragBox.get_int(seg, "else")
          local cv = 0
          if c != null {
            if c == last_cmp_dst { cv = last_cmp_val } else { cv = me._load_reg(regs, c) }
          }
          prev_bb = bb
          if cv != 0 { bb = t } else { bb = e }
          moved = 1
          scan_pos = obj_end
          break
        }
        else if op == "jump" {
          local tgt = JsonFragBox.get_int(seg, "target")
          if tgt == null { return 0 }
          prev_bb = bb
          bb = tgt
          moved = 1
          scan_pos = obj_end
          break
        }
        else if op == "phi" {
          local res = PhiDecodeBox.decode_result(seg, prev_bb)
          if res.is_ok() == 1 {
            local pair = res.value()
            PhiApplyBox.apply(pair.get(0), pair.get(1), regs)
          }
        }
                else if op == "throw" {
          me._tprint("[ERROR] Throw terminator encountered")
          return -2
        }
else if op == "ret" {
          local v = JsonFragBox.get_int(seg, "value")
          if v == null { me._tprint("[ERROR] Undefined ret value field") return -1 }
          if v == last_cmp_dst { return last_cmp_val }
          local sval = "" + regs.get(""+v)
          if me._is_numeric_str(sval) == 1 { return me._load_reg(regs, v) }
          me._tprint("[ERROR] Undefined register ret: r"+me._int_to_str(v))
          return -1
        }
        // advance
        inst_count = inst_count + 1
        scan_pos = obj_end
      }
      if moved == 1 { continue }
      // Prefer precise compare→ret recompute when both are present in the block
      // (typed const ×2 + cmp) before falling back to last_cmp
      if inst_seg.indexOf("\"op\":\"compare\"") >= 0 && inst_seg.indexOf("\"op\":\"ret\"") >= 0 {
        // Grab first two "value":{"type":"i64","value":X}
        local vals = new ArrayBox()
        local search = inst_seg
        local key = "\"value\":{\"type\":\"i64\",\"value\":"
        local pos = 0
        loop(true) {
          local k = StringOps.index_of_from(search, key, pos)
          if k < 0 { break }
          local ds = search.substring(k + key.length(), search.length())
          // read consecutive digits as number
          local i = 0
          local out = ""
          loop(true) {
            local ch = ds.substring(i, i+1)
            if ch == "" { break }
            if ch >= "0" && ch <= "9" { out = out + ch  i = i + 1 } else { break }
          }
          if out != "" { vals.push(out) }
          if vals.size() >= 2 { break }
          pos = k + key.length() + i
        }
        if vals.size() >= 2 {
          local lv = 0
          local rv = 0
          // simple to_i64
          local i0 = 0
          loop(i0 < vals.get(0).length()) { lv = lv * 10 + ("0123456789".indexOf(vals.get(0).substring(i0,i0+1)))  i0 = i0 + 1 }
          local i1 = 0
          loop(i1 < vals.get(1).length()) { rv = rv * 10 + ("0123456789".indexOf(vals.get(1).substring(i1,i1+1)))  i1 = i1 + 1 }
          // cmp: parse cmp op
          local cmp_key = "\"cmp\":\""
          local pk = inst_seg.indexOf(cmp_key)
          local cmp = "Eq"
          if pk >= 0 {
            local i = pk + cmp_key.length()
            local j = StringOps.index_of_from(inst_seg, "\"", i)
            if j > i { cmp = inst_seg.substring(i, j) }
          }
          local cv = CompareOpsBox.eval(cmp, lv, rv)
          // ret id (ensure it's the compare result or still return computed cv as final)
          local rstart4 = inst_seg.indexOf("\"op\":\"ret\"")
          local rseg4 = inst_seg.substring(rstart4, inst_seg.length())
          local rid4 = JsonFragBox.get_int(rseg4, "value")
          if rid4 != null {
            if rid4 == last_cmp_dst { return cv }
          }
          // If compare+ret exist but aliasing prevents id match, still return computed cv
          return cv
        }
      }
      // Fallbacks: prefer recent compare result, else decode explicit ret if present, else first const
      if last_cmp_dst >= 0 { return last_cmp_val }
      // Detect explicit ret in this block and resolve
      if inst_seg.indexOf("\"op\":\"ret\"") >= 0 {
        local rstart = inst_seg.indexOf("\"op\":\"ret\"")
        local rseg = inst_seg.substring(rstart, inst_seg.length())
        local rid = JsonFragBox.get_int(rseg, "value")
        if rid != null {
          if rid == last_cmp_dst { return last_cmp_val }
          local rv = me._load_reg(regs, rid)
          return rv
        }
      }
            # (typed const fallback moved above)
      if false {
        // Grab first two "value":{"type":"i64","value":X}
        local vals = new ArrayBox()
        local search = inst_seg
        local key = "\"value\":{\"type\":\"i64\",\"value\":"
        local pos = 0
        loop(true) {
          local k = StringOps.index_of_from(search, key, pos)
          if k < 0 { break }
          local ds = search.substring(k + key.length(), search.length())
          // read consecutive digits as number
          local i = 0
          local out = ""
          loop(true) {
            local ch = ds.substring(i, i+1)
            if ch == "" { break }
            if ch >= "0" && ch <= "9" { out = out + ch  i = i + 1 } else { break }
          }
          if out != "" { vals.push(out) }
          if vals.size() >= 2 { break }
          pos = k + key.length() + i
        }
        if vals.size() >= 2 {
          local lv = 0
          local rv = 0
          // simple to_i64
          local i0 = 0
          loop(i0 < vals.get(0).length()) { lv = lv * 10 + ("0123456789".indexOf(vals.get(0).substring(i0,i0+1)))  i0 = i0 + 1 }
          local i1 = 0
          loop(i1 < vals.get(1).length()) { rv = rv * 10 + ("0123456789".indexOf(vals.get(1).substring(i1,i1+1)))  i1 = i1 + 1 }
          // cmp: parse cmp op
          local cmp_key = "\"cmp\":\""
          local pk = inst_seg.indexOf(cmp_key)
          local cmp = "Eq"
          if pk >= 0 {
            local i = pk + cmp_key.length()
            local j = StringOps.index_of_from(inst_seg, "\"", i)
            if j > i { cmp = inst_seg.substring(i, j) }
          }
          local cv = CompareOpsBox.eval(cmp, lv, rv)
          // ret id
          local rstart4 = inst_seg.indexOf("\"op\":\"ret\"")
          local rseg4 = inst_seg.substring(rstart4, inst_seg.length())
          local rid4 = JsonFragBox.get_int(rseg4, "value")
          if rid4 != null { return cv }
        }
      }
      // Final fallback: return first const (dst=1) if present
      local first = me._load_reg(regs, 1)
      return first
    }
    return 0
  }

}
