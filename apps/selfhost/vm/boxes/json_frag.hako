// json_frag.hako — JSON v0 断片抽出ユーティリティ（Box）
// 責務: 文字列JSONから key:int / key:str を簡便に取り出す。
// 非責務: 実行・評価（構造検査やVM実行は他箱に委譲）。

using "apps/selfhost/vm/boxes/string_scan.hako" as StringScanBox
using "apps/selfhost/vm/boxes/json_scan.hako" as JsonScanBox
using "apps/selfhost/common/string_helpers.hako" as StringHelpers

static box JsonFragBox {
  // 基本ヘルパ
  index_of_from(hay, needle, pos) { if pos < 0 { pos = 0 } local n = hay.length() local m = needle.length() if pos > n { return -1 } if m <= 0 { return pos } local i = pos local limit = n - m loop(i <= limit) { local ok = 1 local j = 0 loop(j < m) { local ch = hay.substring(i+j, i+j+1) local nh = needle.substring(j, j+1) if ch != nh { ok = 0 break } j = j + 1 } if ok == 1 { return i } i = i + 1 } return -1 }
  read_digits(text, pos) { return StringHelpers.read_digits(text, pos) }
  _str_to_int(s) { return StringHelpers.to_i64(s) }

  // key に続く数値（最初の一致）を返す。見つからなければ null。
  get_int(seg, key) {
    local pat1 = "\"" + key + "\":"
    local p = me.index_of_from(seg, pat1, 0)
    if p >= 0 {
      local v = me.read_digits(seg, p + pat1.length())
      if v != "" { return me._str_to_int(v) }
    }
    return null
  }

  // key に続く "..." の文字列（最初の一致）を返す。見つからなければ空文字。
  get_str(seg, key) {
    local pat = "\"" + key + "\":\""
    local p = me.index_of_from(seg, pat, 0)
    if p >= 0 {
      local vstart = p + pat.length()              // start of value (right after opening quote)
      local vend = StringScanBox.scan_string_end(seg, vstart - 1)
      if vend > vstart { return seg.substring(vstart, vend) }
    }
    return ""
  }

  // ブロック0の instructions を丸ごと返す（配列の中身のみ返す）。
  block0_segment(mjson) {
    if mjson == null { return "" }
    // Find the instructions array start reliably
    local key = "\"instructions\":["
    local pk = mjson.indexOf(key)
    if pk < 0 { return "" }
    // '[' position
    local arr_bracket = pk + key.length() - 1
    // Use escape-aware scanner to find matching ']'
    local endp = JsonScanBox.seek_array_end(mjson, arr_bracket)
    if endp < 0 { return "" }
    return mjson.substring(arr_bracket + 1, endp)
  }
}
