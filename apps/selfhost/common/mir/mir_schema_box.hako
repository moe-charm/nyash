// apps/selfhost/common/mir/mir_schema_box.hako
// MirSchemaBox — minimal MIR(JSON v0) constructors (P1 scope)

static box MirSchemaBox {
  // Scalars (normalize to i64 for P1)
  i(x) { return { type: "i64", value: x } }

  // Instructions
  inst_const(dst, val) { return { op: "const", dst: this.i(dst), value: this.i(val) } }
  inst_ret(val)       { return { op: "ret",   value: this.i(val) } }
  inst_compare(cmp, lhs, rhs, dst) {
    return { op: "compare", cmp: cmp, lhs: this.i(lhs), rhs: this.i(rhs), dst: this.i(dst) }
  }
  inst_binop(kind, lhs, rhs, dst) {
    return { op: "binop", op_kind: kind, lhs: this.i(lhs), rhs: this.i(rhs), dst: this.i(dst) }
  }
  inst_branch(cond, then_id, else_id) {
    return { op: "branch", cond: this.i(cond), then: this.i(then_id), else: this.i(else_id) }
  }
  inst_jump(target) { return { op: "jump", target: this.i(target) } }

  // Unified call (mir_call) variants — minimal P3
  _wrap_ids(arr) {
    local out = new ArrayBox()
    if arr == null { return out }
    local i = 0
    loop(i < arr.size()) { out.push(this.i(arr.get(i))); i = i + 1 }
    return out
  }
  inst_mir_call_extern(name, arg_ids, dst) {
    local callee = { type: "Extern", name: name }
    return { op: "mir_call", dst: this.i(dst), callee: callee, args: this._wrap_ids(arg_ids) }
  }
  inst_mir_call_global(name, arg_ids, dst) {
    local callee = { type: "Global", name: name }
    return { op: "mir_call", dst: this.i(dst), callee: callee, args: this._wrap_ids(arg_ids) }
  }
  inst_mir_call_method(method, recv_id, arg_ids, dst) {
    local callee = { type: "Method", method: method, receiver: this.i(recv_id) }
    return { op: "mir_call", dst: this.i(dst), callee: callee, args: this._wrap_ids(arg_ids) }
  }
  inst_mir_call_constructor(box_type, arg_ids, dst) {
    local callee = { type: "Constructor", box_type: box_type }
    return { op: "mir_call", dst: this.i(dst), callee: callee, args: this._wrap_ids(arg_ids) }
  }

  // Block/Module
  block(id, insts) { return { id: this.i(id), instructions: insts } }
  fn_main(blocks)  { return { name: "main", blocks: blocks } }
  module(fn_main)  { return { version: 0, kind: "MIR", functions: [fn_main] } }
}
