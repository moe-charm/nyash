// json_inst_encode_box.hako — Encode one MIR instruction Map -> JSON text (single return)

static box JsonInstEncodeBox {
  _i(n) { return "" + n }
  _q(s) { return s }

  encode(node) {
    if node == null { return "{}" }
    local op = node.get("op")
    local s = "{}"
    if op == "const" {
      s = "{\"op\":\"const\",\"dst\":" + me._i(node.get("dst")) + ",\"value\":{\"type\":\"i64\",\"value\":" + me._i(node.get("value").get("value")) + "}}"
    } else {
      if op == "compare" {
        s = "{\"op\":\"compare\",\"cmp\":" + me._q(node.get("cmp")) + ",\"lhs\":" + me._i(node.get("lhs")) + ",\"rhs\":" + me._i(node.get("rhs")) + ",\"dst\":" + me._i(node.get("dst")) + "}"
      } else {
        if op == "binop" {
          s = "{\"op\":\"binop\",\"op_kind\":" + me._q(node.get("op_kind")) + ",\"lhs\":" + me._i(node.get("lhs")) + ",\"rhs\":" + me._i(node.get("rhs")) + ",\"dst\":" + me._i(node.get("dst")) + "}"
        } else {
          if op == "branch" {
            s = "{\"op\":\"branch\",\"cond\":" + me._i(node.get("cond")) + ",\"then\":" + me._i(node.get("then")) + ",\"else\":" + me._i(node.get("else_id")) + "}"
          } else {
            if op == "jump" {
              s = "{\"op\":\"jump\",\"target\":" + me._i(node.get("target")) + "}"
            } else {
              if op == "ret" {
                s = "{\"op\":\"ret\",\"value\":" + me._i(node.get("value")) + "}"
              } else {
                if op == "copy" {
                  s = "{\"op\":\"copy\",\"dst\":" + me._i(node.get("dst")) + ",\"src\":" + me._i(node.get("src")) + "}"
                } else {
                  if op == "call" {
                    s = "{\"op\":\"call\",\"name\":" + me._q(node.get("name")) + ",\"args\":" + node.get("args_text") + ",\"dst\":" + me._i(node.get("dst")) + "}"
                  } else {
                    if op == "boxcall" {
                      s = "{\"op\":\"boxcall\",\"method\":" + me._q(node.get("method")) + ",\"recv\":" + me._i(node.get("recv")) + ",\"args\":" + node.get("args_text") + ",\"dst\":" + me._i(node.get("dst")) + "}"
                    } else {
                      if op == "newbox" {
                        s = "{\"op\":\"newbox\",\"box_type\":" + me._q(node.get("box_type")) + ",\"args\":" + node.get("args_text") + ",\"dst\":" + me._i(node.get("dst")) + "}"
                      } else {
                        if op == "mir_call" { s = "{\"op\":\"mir_call\"}" } else { s = "{}" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    return s
  }
}
