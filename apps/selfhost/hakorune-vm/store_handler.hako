// StoreHandlerBox - Store instruction handler
// Handles: store %value -> %ptr (store to memory)

using "apps/selfhost/common/string_helpers.hako" as StringHelpers
using "apps/selfhost/vm/boxes/result_box.hako" as Result
using "apps/selfhost/hakorune-vm/value_manager.hako" as ValueManagerBox
using "apps/selfhost/hakorune-vm/json_field_extractor.hako" as JsonFieldExtractor

static box StoreHandlerBox {
  // Handle store instruction
  // inst_json: {"op":"store","value":2,"ptr":1}
  // mem: memory MapBox
  // Returns: Result.Ok(0) or Result.Err(message)
  handle(inst_json, regs, mem) {
    // Extract value
    local value_id = JsonFieldExtractor.extract_int(inst_json, "value")
    if value_id == null {
      return Result.Err("store: value field not found")
    }

    // Extract ptr
    local ptr = JsonFieldExtractor.extract_int(inst_json, "ptr")
    if ptr == null {
      return Result.Err("store: ptr field not found")
    }

    // Load value from register
    local value = ValueManagerBox.get(regs, value_id)

    // Store to memory: regs[value] → mem[ptr]
    local ptr_key = StringHelpers.int_to_str(ptr)
    mem.set(ptr_key, value)

    return Result.Ok(0)
  }
}
