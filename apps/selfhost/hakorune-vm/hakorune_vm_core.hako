// hakorune_vm_core.hako — Phase 1: 最小動作VM（Const/BinOp/Ret）
// Strategy: @match 最大限活用、Result @enum でエラーハンドリング
// Reference: INSTRUCTION_SET.md, LLVM Python, Rust VM
// Phase 1 Day 3: 制御フロー実装（Branch/Jump/Phi）- 箱化モジュール化

using "apps/selfhost/common/json/json_cursor.hako" as JsonCursorBox
using "apps/selfhost/common/string_helpers.hako" as StringHelpers
using "apps/selfhost/common/string_ops.hako" as StringOps
using "apps/selfhost/vm/boxes/result_box.hako" as Result

// Phase 1 Day 3: 箱化モジュール化
using "apps/selfhost/hakorune-vm/block_mapper.hako" as BlockMapperBox
using "apps/selfhost/hakorune-vm/terminator_handler.hako" as TerminatorHandlerBox
using "apps/selfhost/hakorune-vm/phi_handler.hako" as PhiHandlerBox

static box HakoruneVmCore {
  // Main entry point
  run(mir_json) {
    // Initialize registers
    local regs = new MapBox()

    // Execute from block 0 (Phase 1 Day 3: multiple blocks support)
    local result = me._execute_blocks(mir_json, regs)

    // @match Result for error handling
    if result.is_Ok() {
      return result.as_Ok()
    } else {
      print("[ERROR] Hakorune-VM: " + result.as_Err())
      return -1
    }
  }

  // Phase 1 Day 3: Execute multiple blocks with control flow
  _execute_blocks(mir_json, regs) {
    // Build block map
    local block_map_result = BlockMapperBox.build_map(mir_json)
    if block_map_result.is_Err() {
      return block_map_result
    }
    local block_map = block_map_result.as_Ok()

    // Start from block 0
    local current_bb = 0
    local predecessor = -1
    local max_iterations = 1000
    local iterations = 0

    loop(current_bb >= 0 && iterations < max_iterations) {
      iterations = iterations + 1

      // Get current block
      local block_json = block_map.get(StringHelpers.int_to_str(current_bb))
      if block_json == null {
        return Result.Err("block not found: " + StringHelpers.int_to_str(current_bb))
      }

      // Execute PHI instructions first
      local phi_result = PhiHandlerBox.handle_phi_instructions(block_json, regs, predecessor)
      if phi_result.is_Err() {
        return phi_result
      }

      // Execute normal instructions (non-PHI)
      local exec_result = me._execute_instructions_in_block(block_json, regs)
      if exec_result.is_Err() {
        return exec_result
      }

      // Execute terminator
      local term_result = TerminatorHandlerBox.handle_terminator(block_json, regs)
      if term_result.is_Err() {
        return term_result
      }

      local term_map = term_result.as_Ok()
      local term_type = term_map.get("type")

      if term_type == "ret" {
        return Result.Ok(term_map.get("value"))
      }

      if term_type == "jump" || term_type == "branch" {
        predecessor = current_bb
        current_bb = term_map.get("next_bb")
        continue
      }

      return Result.Err("unknown terminator type: " + term_type)
    }

    if iterations >= max_iterations {
      return Result.Err("max iterations reached (infinite loop?)")
    }

    return Result.Ok(0)
  }

  // Execute instructions in a block (excluding PHI)
  _execute_instructions_in_block(block_json, regs) {
    // Find instructions array
    local key_insts = "\"instructions\":["
    local insts_start = block_json.indexOf(key_insts)
    if insts_start < 0 {
      // No instructions (empty block)
      return Result.Ok(0)
    }
    insts_start = insts_start + key_insts.length()

    // Find instructions array end
    local insts_end = JsonCursorBox.seek_array_end(block_json, insts_start - 1)
    if insts_end < 0 {
      return Result.Err("instructions array end not found")
    }

    local insts_json = block_json.substring(insts_start, insts_end)

    // Execute instructions sequentially
    return me._execute_instructions(insts_json, regs)
  }

  // Phase 1: Block 0 only (simplified control flow)
  _execute_block0(mir_json, regs) {
    // Find block 0's instructions array
    local key_blocks = "\"blocks\":["
    local blocks_start = mir_json.indexOf(key_blocks)
    if blocks_start < 0 {
      return Result.Err("blocks array not found")
    }

    // Find block 0's instructions
    local key_id0 = "\"id\":0"
    local block0_start = mir_json.indexOf(key_id0)
    if block0_start < 0 {
      return Result.Err("block 0 not found")
    }

    local key_insts = "\"instructions\":["
    local insts_start = StringOps.index_of_from(mir_json, key_insts, block0_start)
    if insts_start < 0 {
      return Result.Err("block 0 instructions not found")
    }
    insts_start = insts_start + key_insts.length()

    // Find instructions array end
    local insts_end = JsonCursorBox.seek_array_end(mir_json, insts_start - 1)
    if insts_end < 0 {
      return Result.Err("instructions array end not found")
    }

    local insts_json = mir_json.substring(insts_start, insts_end)

    // Execute instructions
    return me._execute_instructions(insts_json, regs)
  }

  // Execute instructions sequentially
  _execute_instructions(insts_json, regs) {
    local pos = 0
    local len = insts_json.length()
    local last_ret_value = 0

    loop(pos < len) {
      // Skip whitespace
      local ch = insts_json.substring(pos, pos + 1)
      if ch == " " || ch == "\n" || ch == "\r" || ch == "\t" {
        pos = pos + 1
        continue
      }

      // Skip comma
      if ch == "," {
        pos = pos + 1
        continue
      }

      // Find instruction object
      if ch == "{" {
        local inst_end = JsonCursorBox.seek_obj_end(insts_json, pos)
        if inst_end < 0 {
          return Result.Err("instruction object end not found")
        }

        local inst_json = insts_json.substring(pos, inst_end + 1)

        // Dispatch instruction
        local result = me._dispatch_instruction(inst_json, regs)

        // Check for errors or return value
        if result.is_Err() {
          return result
        }

        // Check if instruction is Ret (store return value)
        if inst_json.indexOf("\"op\":\"ret\"") >= 0 {
          last_ret_value = result.as_Ok()
          // Early exit on ret
          return Result.Ok(last_ret_value)
        }

        pos = inst_end + 1
        continue
      }

      // Skip other characters
      pos = pos + 1
    }

    return Result.Ok(last_ret_value)
  }

  // Dispatch instruction based on op field (@match)
  _dispatch_instruction(inst_json, regs) {
    // Extract op field
    local key_op = "\"op\":\""
    local op_start = inst_json.indexOf(key_op)
    if op_start < 0 {
      return Result.Err("op field not found")
    }
    op_start = op_start + key_op.length()

    local op_end = StringOps.index_of_from(inst_json, "\"", op_start)
    if op_end < 0 {
      return Result.Err("op field end not found")
    }

    local op = inst_json.substring(op_start, op_end)

    // Skip PHI (handled separately at block start)
    if op == "phi" {
      return Result.Ok(0)
    }

    // @match instruction dispatch
    return match op {
      "const" => me._handle_const(inst_json, regs)
      "binop" => me._handle_binop(inst_json, regs)
      "compare" => me._handle_compare(inst_json, regs)
      "ret" => me._handle_ret(inst_json, regs)
      "copy" => me._handle_copy(inst_json, regs)
      _ => Result.Err("unsupported instruction: " + op)
    }
  }

  // Const instruction handler
  _handle_const(inst_json, regs) {
    // Extract dst
    local dst = me._extract_int_field(inst_json, "dst")
    if dst == null {
      return Result.Err("const: dst field not found")
    }

    // Extract value (typed: i64 only for Phase 1)
    local key_val = "\"value\":{\"type\":\"i64\",\"value\":"
    local val_start = inst_json.indexOf(key_val)
    if val_start < 0 {
      return Result.Err("const: i64 value not found")
    }
    val_start = val_start + key_val.length()

    local digits = StringHelpers.read_digits(inst_json, val_start)
    if digits == "" {
      return Result.Err("const: invalid value")
    }

    local value = StringHelpers.to_i64(digits)

    // Store in registers
    regs.set(StringHelpers.int_to_str(dst), value)

    return Result.Ok(0)
  }

  // BinOp instruction handler (Phase 1 Day 2: All arithmetic ops)
  _handle_binop(inst_json, regs) {
    // Extract dst
    local dst = me._extract_int_field(inst_json, "dst")
    if dst == null {
      return Result.Err("binop: dst field not found")
    }

    // Extract lhs
    local lhs_id = me._extract_int_field(inst_json, "lhs")
    if lhs_id == null {
      return Result.Err("binop: lhs field not found")
    }

    // Extract rhs
    local rhs_id = me._extract_int_field(inst_json, "rhs")
    if rhs_id == null {
      return Result.Err("binop: rhs field not found")
    }

    // Extract op_kind
    local key_kind = "\"op_kind\":\""
    local kind_start = inst_json.indexOf(key_kind)
    if kind_start < 0 {
      return Result.Err("binop: op_kind not found")
    }
    kind_start = kind_start + key_kind.length()

    local kind_end = StringOps.index_of_from(inst_json, "\"", kind_start)
    if kind_end < 0 {
      return Result.Err("binop: op_kind end not found")
    }

    local kind = inst_json.substring(kind_start, kind_end)

    // Load operands from registers
    local lhs_val = me._load_reg(regs, lhs_id)
    local rhs_val = me._load_reg(regs, rhs_id)

    // Execute arithmetic operation
    local result_val = 0
    if kind == "Add" {
      result_val = lhs_val + rhs_val
    } else if kind == "Sub" {
      result_val = lhs_val - rhs_val
    } else if kind == "Mul" {
      result_val = lhs_val * rhs_val
    } else if kind == "Div" {
      if rhs_val == 0 {
        return Result.Err("binop: division by zero")
      }
      result_val = lhs_val / rhs_val
    } else if kind == "Mod" {
      if rhs_val == 0 {
        return Result.Err("binop: modulo by zero")
      }
      result_val = lhs_val % rhs_val
    } else {
      return Result.Err("binop: unsupported op_kind: " + kind)
    }

    // Store result
    regs.set(StringHelpers.int_to_str(dst), result_val)

    return Result.Ok(0)
  }

  // Compare instruction handler (Phase 1 Day 2: All comparison ops)
  _handle_compare(inst_json, regs) {
    // Extract dst
    local dst = me._extract_int_field(inst_json, "dst")
    if dst == null {
      return Result.Err("compare: dst field not found")
    }

    // Extract lhs
    local lhs_id = me._extract_int_field(inst_json, "lhs")
    if lhs_id == null {
      return Result.Err("compare: lhs field not found")
    }

    // Extract rhs
    local rhs_id = me._extract_int_field(inst_json, "rhs")
    if rhs_id == null {
      return Result.Err("compare: rhs field not found")
    }

    // Extract kind (Eq/Ne/Lt/Le/Gt/Ge)
    local key_kind = "\"kind\":\""
    local kind_start = inst_json.indexOf(key_kind)
    if kind_start < 0 {
      return Result.Err("compare: kind field not found")
    }
    kind_start = kind_start + key_kind.length()

    local kind_end = StringOps.index_of_from(inst_json, "\"", kind_start)
    if kind_end < 0 {
      return Result.Err("compare: kind end not found")
    }

    local kind = inst_json.substring(kind_start, kind_end)

    // Load operands from registers
    local lhs_val = me._load_reg(regs, lhs_id)
    local rhs_val = me._load_reg(regs, rhs_id)

    // Execute comparison operation (result: 1=true, 0=false)
    local result_val = 0
    if kind == "Eq" {
      if lhs_val == rhs_val {
        result_val = 1
      } else {
        result_val = 0
      }
    } else if kind == "Ne" {
      if lhs_val != rhs_val {
        result_val = 1
      } else {
        result_val = 0
      }
    } else if kind == "Lt" {
      if lhs_val < rhs_val {
        result_val = 1
      } else {
        result_val = 0
      }
    } else if kind == "Le" {
      if lhs_val <= rhs_val {
        result_val = 1
      } else {
        result_val = 0
      }
    } else if kind == "Gt" {
      if lhs_val > rhs_val {
        result_val = 1
      } else {
        result_val = 0
      }
    } else if kind == "Ge" {
      if lhs_val >= rhs_val {
        result_val = 1
      } else {
        result_val = 0
      }
    } else {
      return Result.Err("compare: unsupported kind: " + kind)
    }

    // Store result (0 or 1)
    regs.set(StringHelpers.int_to_str(dst), result_val)

    return Result.Ok(0)
  }

  // Ret instruction handler
  _handle_ret(inst_json, regs) {
    // Extract value field
    local val_id = me._extract_int_field(inst_json, "value")
    if val_id == null {
      // No value field → return 0
      return Result.Ok(0)
    }

    // Load from registers
    local ret_val = me._load_reg(regs, val_id)

    return Result.Ok(ret_val)
  }

  // Copy instruction handler
  _handle_copy(inst_json, regs) {
    local dst = me._extract_int_field(inst_json, "dst")
    local src = me._extract_int_field(inst_json, "src")

    if dst == null || src == null {
      return Result.Err("copy: dst or src field not found")
    }

    local val = regs.get(StringHelpers.int_to_str(src))
    if val == null {
      val = 0
    }

    regs.set(StringHelpers.int_to_str(dst), val)

    return Result.Ok(0)
  }

  // Helper: extract integer field from JSON
  _extract_int_field(json, field_name) {
    local key = "\"" + field_name + "\":"
    local start = json.indexOf(key)
    if start < 0 {
      return null
    }
    start = start + key.length()

    local digits = StringHelpers.read_digits(json, start)
    if digits == "" {
      return null
    }

    return StringHelpers.to_i64(digits)
  }

  // Helper: load register value (default 0 if not found)
  _load_reg(regs, reg_id) {
    local key = StringHelpers.int_to_str(reg_id)
    local val = regs.get(key)
    if val == null {
      return 0
    }
    return val
  }
}
