// NewBoxHandlerBox - Handle newbox instruction (Box instantiation)
// Single Responsibility: Create Box instances (ArrayBox, MapBox, etc.)

using "apps/selfhost/vm/boxes/result_box.hako" as Result
using "apps/selfhost/hakorune-vm/value_manager.hako" as ValueManagerBox
using "apps/selfhost/hakorune-vm/json_field_extractor.hako" as JsonFieldExtractor
using "apps/selfhost/common/string_ops.hako" as StringOps

static box NewBoxHandlerBox {
  // Handle newbox instruction
  // inst_json: {"op":"newbox","dst":X,"box_type":"ArrayBox","args":[]}
  // regs: register MapBox
  // Returns: Result.Ok(0) or Result.Err(message)
  handle(inst_json, regs) {
    // Extract dst
    local dst = JsonFieldExtractor.extract_int(inst_json, "dst")
    if dst == null {
      return Result.Err("newbox: dst field not found")
    }

    // Extract box_type
    local key_type = "\"box_type\":\""
    local type_start = inst_json.indexOf(key_type)
    if type_start < 0 {
      return Result.Err("newbox: box_type field not found")
    }
    type_start = type_start + key_type.size()

    local type_end = StringOps.index_of_from(inst_json, "\"", type_start)
    if type_end < 0 {
      return Result.Err("newbox: box_type field end not found")
    }

    local box_type = inst_json.substring(type_start, type_end)

    // Create Box instance based on type
    local box_instance = null
    if box_type == "ArrayBox" {
      box_instance = new ArrayBox()
    } else if box_type == "MapBox" {
      box_instance = new MapBox()
    } else {
      return Result.Err("newbox: unsupported box_type: " + box_type)
    }

    // Debug trace (TEMPORARY)
    print("[DEBUG-NEWBOX] dst=" + dst + " box_type=" + box_type + " instance=" + box_instance)

    // Store Box instance in destination register
    ValueManagerBox.set(regs, dst, box_instance)

    // Debug trace after set (TEMPORARY)
    local verify = ValueManagerBox.get(regs, dst)
    print("[DEBUG-NEWBOX-VERIFY] dst=" + dst + " retrieved=" + verify)

    return Result.Ok(0)
  }
}
