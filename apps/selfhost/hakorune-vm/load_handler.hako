// LoadHandlerBox - Load instruction handler
// Handles: %dst = load %ptr (load from memory)

using "apps/selfhost/common/string_helpers.hako" as StringHelpers
using "apps/selfhost/vm/boxes/result_box.hako" as Result
using "apps/selfhost/hakorune-vm/value_manager.hako" as ValueManagerBox
using "apps/selfhost/hakorune-vm/json_field_extractor.hako" as JsonFieldExtractor

static box LoadHandlerBox {
  // Handle load instruction
  // inst_json: {"op":"load","dst":3,"ptr":1}
  // mem: memory MapBox
  // Returns: Result.Ok(0) or Result.Err(message)
  handle(inst_json, regs, mem) {
    // Extract dst
    local dst = JsonFieldExtractor.extract_int(inst_json, "dst")
    if dst == null {
      return Result.Err("load: dst field not found")
    }

    // Extract ptr
    local ptr = JsonFieldExtractor.extract_int(inst_json, "ptr")
    if ptr == null {
      return Result.Err("load: ptr field not found")
    }

    // Load from memory: mem[ptr] → regs[dst]
    local ptr_key = StringHelpers.int_to_str(ptr)

    // Default to 0 for uninitialized memory
    local value = 0
    local mem_value = mem.get(ptr_key)
    if mem_value != null {
      value = mem_value
    }

    // Store to destination register
    ValueManagerBox.set(regs, dst, value)

    return Result.Ok(0)
  }
}
