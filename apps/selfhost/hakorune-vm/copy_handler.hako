// CopyHandlerBox - Copy instruction handler
// Handles: %dst = copy %src

using "selfhost/shared/common/string_helpers.hako" as StringHelpers
using "selfhost/vm/boxes/result_box.hako" as Result
using "apps/selfhost/hakorune-vm/value_manager.hako" as ValueManagerBox
using "apps/selfhost/hakorune-vm/json_field_extractor.hako" as JsonFieldExtractor

static box CopyHandlerBox {
  // Handle copy instruction
  // inst_json: {"op":"copy","dst":2,"src":1}
  // Returns: Result.Ok(0) or Result.Err(message)
  handle(inst_json, regs) {
    // Extract dst and src
    local dst = JsonFieldExtractor.extract_int(inst_json, "dst")
    local src = JsonFieldExtractor.extract_int(inst_json, "src")

    if dst == null || src == null {
      return Result.Err("copy: dst or src field not found")
    }

    // Load value from src register using ValueManagerBox
    local val = ValueManagerBox.get(regs, src)

    // Store value in dst register using ValueManagerBox
    ValueManagerBox.set(regs, dst, val)

    return Result.Ok(0)
  }
}
