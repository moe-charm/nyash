// MirCallHandlerBox - Unified call instruction handler
// Single Responsibility: Dispatch MirCall to appropriate handler based on callee type

using "selfhost/vm/boxes/result_box.hako" as Result
using "apps/selfhost/common/string_ops.hako" as StringOps
using "apps/selfhost/common/json/json_cursor.hako" as JsonCursorBox
using "apps/selfhost/hakorune-vm/json_field_extractor.hako" as JsonFieldExtractor
using "apps/selfhost/hakorune-vm/callee_parser.hako" as CalleeParserBox
using "apps/selfhost/hakorune-vm/args_extractor.hako" as ArgsExtractorBox
using "apps/selfhost/hakorune-vm/global_call_handler.hako" as GlobalCallHandlerBox
using "apps/selfhost/hakorune-vm/extern_call_handler.hako" as ExternCallHandlerBox
using "apps/selfhost/hakorune-vm/module_function_call_handler.hako" as ModuleFunctionCallHandlerBox
using "apps/selfhost/hakorune-vm/method_call_handler.hako" as MethodCallHandlerBox
using "apps/selfhost/hakorune-vm/constructor_call_handler.hako" as ConstructorCallHandlerBox
using "apps/selfhost/hakorune-vm/closure_call_handler.hako" as ClosureCallHandlerBox

static box MirCallHandlerBox {
  // Handle MirCall instruction
  // inst_json: {"op":"mir_call","mir_call":{...},"dst":X}
  // regs: register MapBox
  // mem: memory MapBox
  // Returns: Result.Ok(0) or Result.Err(message)
  handle(inst_json, regs, mem) {
    // Extract mir_call field
    local mir_call_key = "\"mir_call\":"
    local mir_call_start = inst_json.indexOf(mir_call_key)
    if mir_call_start < 0 {
      return Result.Err("mir_call: mir_call field not found")
    }
    mir_call_start = mir_call_start + mir_call_key.size()

    // Find mir_call object end (using balanced bracket matching)
    // mir_call_start now points to '{' (first char of mir_call object)
    local mir_call_end = JsonCursorBox.seek_obj_end(inst_json, mir_call_start)
    if mir_call_end < 0 {
      return Result.Err("mir_call: mir_call object end not found")
    }

    // Extract mir_call object
    local mir_call_json = inst_json.substring(mir_call_start, mir_call_end + 1)

    // Extract callee type
    local callee_type = CalleeParserBox.extract_type(mir_call_json)
    if callee_type == null {
      return Result.Err("mir_call: failed to extract callee type")
    }

    // Extract destination register (may be null)
    local dst_reg = JsonFieldExtractor.extract_int(inst_json, "dst")
    // Note: dst can be null for void functions, JsonFieldExtractor returns null

    // Extract arguments (common for all callee types)
    local args_array = ArgsExtractorBox.extract_and_load(mir_call_json, regs)

    // Method: Dispatch directly (receiver/method handled in MethodCallHandlerBox)
    if callee_type == "Method" {
      return MethodCallHandlerBox.handle(mir_call_json, dst_reg, regs)
    }

    // Constructor: Dispatch directly (box_type handled in ConstructorCallHandlerBox)
    if callee_type == "Constructor" {
      local box_type = CalleeParserBox.extract_box_type(mir_call_json)
      if box_type == null {
        return Result.Err("mir_call: failed to extract box_type from Constructor")
      }
      return ConstructorCallHandlerBox.handle(box_type, args_array, dst_reg, regs)
    }

    // Closure: Dispatch directly (params/captures handled in ClosureCallHandlerBox)
    if callee_type == "Closure" {
      return ClosureCallHandlerBox.handle(mir_call_json, dst_reg, regs)
    }

    // For other callee types: Extract name
    local callee_name = CalleeParserBox.extract_name(mir_call_json)
    if callee_name == null {
      return Result.Err("mir_call: failed to extract callee name")
    }

    // Dispatch based on callee type
    if callee_type == "Global" {
      return GlobalCallHandlerBox.handle(callee_name, args_array, dst_reg, regs)
    }

    if callee_type == "Extern" {
      return ExternCallHandlerBox.handle(callee_name, args_array, dst_reg, regs, mem)
    }

    // Phase 2: ModuleFunction, Value
    if callee_type == "ModuleFunction" {
      return ModuleFunctionCallHandlerBox.handle(callee_name, args_array, dst_reg, regs)
    }

    if callee_type == "Value" {
      return Result.Err("mir_call: Value call not yet implemented (Phase 2)")
    }

    return Result.Err("mir_call: unknown callee type: " + callee_type)
  }
}
