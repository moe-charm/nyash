// BinOpHandlerBox - BinOp instruction handler
// Handles: %dst = %lhs op_kind %rhs (Add/Sub/Mul/Div/Mod)

using "apps/selfhost/common/string_helpers.hako" as StringHelpers
using "apps/selfhost/common/string_ops.hako" as StringOps
using "apps/selfhost/vm/boxes/result_box.hako" as Result
using "apps/selfhost/hakorune-vm/value_manager.hako" as ValueManagerBox
using "apps/selfhost/hakorune-vm/json_field_extractor.hako" as JsonFieldExtractor

static box BinOpHandlerBox {
  // Handle binop instruction
  // inst_json: {"op":"binop","dst":3,"op_kind":"Add","lhs":1,"rhs":2}
  // Returns: Result.Ok(0) or Result.Err(message)
  handle(inst_json, regs) {
    // Extract dst, lhs, rhs
    local dst = JsonFieldExtractor.extract_int(inst_json, "dst")
    if dst == null {
      return Result.Err("binop: dst field not found")
    }

    local lhs_id = JsonFieldExtractor.extract_int(inst_json, "lhs")
    if lhs_id == null {
      return Result.Err("binop: lhs field not found")
    }

    local rhs_id = JsonFieldExtractor.extract_int(inst_json, "rhs")
    if rhs_id == null {
      return Result.Err("binop: rhs field not found")
    }

    // Extract op_kind
    local kind = JsonFieldExtractor.extract_string(inst_json, "op_kind")
    if kind == null {
      return Result.Err("binop: op_kind not found")
    }

    // Load operands from registers using ValueManagerBox
    local lhs_val = ValueManagerBox.get(regs, lhs_id)
    local rhs_val = ValueManagerBox.get(regs, rhs_id)

    // Execute arithmetic operation
    local result_val = 0
    if kind == "Add" {
      result_val = lhs_val + rhs_val
    } else if kind == "Sub" {
      result_val = lhs_val - rhs_val
    } else if kind == "Mul" {
      result_val = lhs_val * rhs_val
    } else if kind == "Div" {
      if rhs_val == 0 {
        return Result.Err("binop: division by zero")
      }
      result_val = lhs_val / rhs_val
    } else if kind == "Mod" {
      if rhs_val == 0 {
        return Result.Err("binop: modulo by zero")
      }
      result_val = lhs_val % rhs_val
    } else {
      return Result.Err("binop: unsupported op_kind: " + kind)
    }

    // Store result using ValueManagerBox
    ValueManagerBox.set(regs, dst, result_val)

    return Result.Ok(0)
  }
}
