            if j < src.size() { j = j + 1 } else { j = src.size() }
            me.gpos_set(j)
          }
          // consume optional semicolons (ASI minimal)
          local done = 0
          local guard = 0
          local max = 100000
          loop(done == 0) {
            if guard > max { done = 1 } else { guard = guard + 1 }
