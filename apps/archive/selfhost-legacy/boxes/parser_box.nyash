  parse_block2(src, i) {
    local j = me.skip_ws(src, i)
    if src.substring(j, j+1) != "{" { return "[]@" + me.i2s(j) }
    j = j + 1
    local body = "["
    local first = 1
    local cont_block = 1
    loop(cont_block == 1) {
      j = me.skip_ws(src, j)
      if j >= src.size() { cont_block = 0 } else {
        if src.substring(j, j+1) == "}" { j = j + 1 cont_block = 0 } else {
