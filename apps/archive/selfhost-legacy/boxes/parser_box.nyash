            j = me.skip_ws(src, j)
            if j < src.size() && src.substring(j, j+1) == ";" { j = j + 1 } else { done = 1 }
            if j == before { done = 1 }
          }
          if s.size() > 0 { if first == 1 { body = body + s first = 0 } else { body = body + "," + s } }
        }
      }
    }
    body = body + "]"
    return body + "@" + me.i2s(j)
  }
  parse_program2(src) {
    local i = me.skip_ws(src, 0)
