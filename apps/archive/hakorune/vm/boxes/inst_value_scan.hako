// inst_value_scan.hako — InstValueScanBox
// Responsibility: extract typed i64 const values from a MIR(JSON) instruction segment
// Minimal and escape-safe enough for scanning numbers.

using "selfhost/shared/json/core/string_scan.hako" as StringScanBox
using "apps/hakorune/common/json/json_cursor_alias.hako" as HakoruneJsonCursorBox

static box InstValueScanBox {
  // Find up to `limit` i64 values under key pattern: "value":{"type":"i64","value":"<digits>"}
  find_i64_values(seg, limit) {
    local key = "\"value\":{\"type\":\"i64\",\"value\":\""
    local pos = 0
    local found = new ArrayBox()
    loop(true) {
      if found.size() >= limit { break }
      local k = HakoruneJsonCursorBox.index_of_from(seg, key, pos)
      if k < 0 { break }
      local ds = seg.substring(k + key.size(), seg.size())
      // Consume consecutive digits safely (stop at first non-digit)
      local i = 0
      local out = ""
      loop(true) {
        local ch = ds.substring(i, i+1)
        if ch == "" { break }
        if ch >= "0" && ch <= "9" { out = out + ch  i = i + 1 } else { break }
      }
      if out != "" { found.push(out) }
      pos = k + key.size() + i
    }
    return found
  }
}

