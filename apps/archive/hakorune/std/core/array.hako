// hakorune-std/core/array.hako — ArrayBox (WASM-ABI ready)
// Responsibility: growable i64 array over nykernel.* memory ops.
// Non-responsibility: allocator policy or GC (handled by nykernel/host).

box ArrayBox {
  ptr: Integer
  len: Integer
  cap: Integer

  birth() {
    local env = 0
    me.ptr = env.nykernel.malloc(128)  // 16 elements * 8 bytes
    if me.ptr == 0 { me.ptr = 8 } // dev-stub fallback
    me.len = 0
    me.cap = 16
    return 0
  }

  size() { return me.len }

  _grow_if_full() {
    local env = 0
    if me.len < me.cap { return 0 }
    local new_cap = me.cap * 2
    local bytes = new_cap * 8
    local new_ptr = env.nykernel.malloc(bytes)
    if new_ptr == 0 { new_ptr = 8 } // dev-stub fallback
    // copy [0..len)
    local i = 0
    loop(i < me.len) {
      local v = env.nykernel.load_i64(me.ptr + i * 8)
      env.nykernel.store_i64(new_ptr + i * 8, v)
      i = i + 1
    }
    me.ptr = new_ptr
    me.cap = new_cap
    return 0
  }

  push(v) {
    local env = 0
    me._grow_if_full()
    env.nykernel.store_i64(me.ptr + me.len * 8, v)
    me.len = me.len + 1
    return 0
  }

  get(idx) {
    local env = 0
    if idx < 0 { return 0 }
    if idx >= me.len { return 0 }
    return env.nykernel.load_i64(me.ptr + idx * 8)
  }
}

static box ArrayBoxStub { main(args) { return 0 } }
