// string_helpers_alias.hako — HakoruneStringHelpers (alias to selfhost StringHelpers)

using "apps/selfhost/common/string_helpers.hako" as StringHelpers

static box HakoruneStringHelpers {
  int_to_str(n) { return StringHelpers.int_to_str(n) }
  is_numeric_str(s) { return StringHelpers.is_numeric_str(s) }
}

