// inst_scan.hako — InstScanBox (minimal helpers for instruction-segment scanning)
// Responsibility: thin helpers to extract simple fields from a MIR(JSON) instruction segment
// Notes: escape-aware quote search delegates to StringScanBox; structural seek to JsonCursorBox.

using "apps/selfhost/common/json/core/string_scan.hako" as StringScanBox
using "apps/hakorune/common/json/json_cursor_alias.hako" as HakoruneJsonCursorBox

static box InstScanBox {
  // Extract compare kind (e.g., "Eq","Ne","Gt"...) from an instruction segment
  extract_cmp(inst_seg) {
    local cmp_key = "\"cmp\":\""
    local pk = HakoruneJsonCursorBox.index_of_from(inst_seg, cmp_key, 0)
    if pk < 0 { return "Eq" } // default
    local i = pk + cmp_key.length()
    local j = StringScanBox.find_quote(inst_seg, i)
    if j > i { return inst_seg.substring(i, j) }
    return "Eq"
  }
}

