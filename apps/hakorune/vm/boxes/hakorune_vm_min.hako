// hakorune_vm_min.hako — Hakorune最小MIR(JSON v0)実行器（const/compare/copy/branch/jump/ret の最小）
// 互換性のため、当面は selfhost 側の既存Boxへ依存するよ（スリムな差分で段階移行）
using "apps/selfhost/vm/boxes/op_handlers.hako" as OpHandlersBox
using "apps/selfhost/common/json/utils/json_frag.hako" as JsonFragBox
using "apps/selfhost/vm/boxes/operator_box.hako" as OperatorBox
using "apps/selfhost/vm/boxes/compare_ops.hako" as CompareOpsBox
using "apps/selfhost/vm/boxes/compare_scan_box.hako" as CompareScanBox
using "apps/hakorune/vm/boxes/instr_decoder.hako" as InstrDecoderBox
using "apps/hakorune/vm/boxes/phi_wiring.hako" as PhiWiringBox
using "apps/hakorune/vm/boxes/program_state.hako" as ProgramStateBox
using "apps/hakorune/vm/boxes/diagnostics.hako" as DiagnosticsBox
using "apps/hakorune/vm/boxes/cfg_navigator.hako" as CfgNavigatorBox
using "apps/selfhost/common/json/json_cursor.hako" as JsonCursorBox
using "apps/hakorune/vm/boxes/ret_resolver.hako" as RetResolverBox
using "apps/selfhost/vm/boxes/phi_apply_box.hako" as PhiApplyBox
using "apps/selfhost/vm/boxes/guard_box.hako" as GuardBox
using "apps/selfhost/vm/boxes/result_box.hako" as Result
using "apps/selfhost/vm/boxes/phi_decode_box.hako" as PhiDecodeBox
using "apps/selfhost/common/json/core/string_scan.hako" as StringScanBox
using "apps/hakorune/common/strings/string_helpers_alias.hako" as HakoruneStringHelpers
using "apps/hakorune/vm/boxes/inst_scan.hako" as InstScanBox
using "apps/hakorune/vm/boxes/inst_value_scan.hako" as InstValueScanBox

static box HakoruneVmMin {
  _tprint(msg) {
    if me.index_of_from(msg, "[ERROR]", 0) >= 0 { print(msg) }
  }
  // 入口は run_min を標準にする（printは run が担当）
  run(mjson) { local v = me._run_min(mjson) print(me._int_to_str(v)) return v }
  run_min(mjson) { return me._run_min(mjson) }
  run_thin(mjson) {
    if mjson.substring(0,1) == "{" {
      local payload = mjson.substring(1, mjson.size())
      local j2 = "{\"__thin__\":1," + payload
      local v = me._run_min(j2)
      print(me._int_to_str(v))
      return v
    }
    local v = me._run_min(mjson)
    print(me._int_to_str(v))
    return v
  }

  // helpers
  _int_to_str(n) { return HakoruneStringHelpers.int_to_str(n) }
  _is_numeric_str(s){ return HakoruneStringHelpers.is_numeric_str(s) }
  _load_reg(regs,id){ local v=regs.get(""+id) if v==null {return 0} local s=""+v if me._is_numeric_str(s)==1 { return JsonFragBox._str_to_int(s) } return 0 }

  // block helpers（selfhost版と同等の簡易スキャナ）
  index_of_from(hay,needle,pos){ return CfgNavigatorBox.index_of_from(hay,needle,pos) }
  _block_insts_start(mjson,bid){ local key="\"id\":"+me._int_to_str(bid) local p=me.index_of_from(mjson, key, 0) if p<0 {return -1} local q=me.index_of_from(mjson,"\"instructions\":[",p) if q<0 {return -1} return q+16 }
  _seek_array_end(text, pos){ return JsonCursorBox.seek_array_end(text, pos) }
  _block_insts_end(mjson,insts_start){ return me._seek_array_end(mjson,insts_start) }
  _seek_obj_end(text, obj_start) { return JsonCursorBox.seek_obj_end(text, obj_start) }

  _handle_copy(seg, regs){ local dst=JsonFragBox.get_int(seg,"dst") local src=JsonFragBox.get_int(seg,"src") if dst==null || src==null {return} local v=regs.get(""+src) regs.set(""+dst, v) }

  _run_min(mjson) {
    local thin_mode = 0
    if me.index_of_from(mjson, "\"__thin__\":1", 0) >= 0 { thin_mode = 1 }
    if me.index_of_from(mjson, "\"__dev__\":1", 0) >= 0 { DiagnosticsBox.enable_dev() }
    // Use ProgramStateBox for state/regs (thin introduction)
    // regs is obtained from ProgramStateBox; other counters remain local for now
    local last_cmp_dst = -1
    local last_cmp_val = 0
    local op_adopt = 0
    if me.index_of_from(mjson, "\"__op_adopt__\":1", 0) >= 0 { op_adopt = 1 }
    local last_binop_dst = -1
    local last_binop_val = 0
    local bb = 0
    // steps now tracked in ProgramStateBox
    local max_steps = 200000
    // Initialize program state (only regs used for now)
    local st = ProgramStateBox.new_state(max_steps)
    local regs = ProgramStateBox.regs(st)
    // keep state in sync (setter only routing for now)
    ProgramStateBox.set_bb(st, bb)
    ProgramStateBox.set_prev_bb(st, -1)
    loop(true){
      ProgramStateBox.inc_steps(st)
      if ProgramStateBox.over_limit(st) == 1 { return 0 }
      local start = CfgNavigatorBox.block_insts_start(mjson, ProgramStateBox.bb(st))
      DiagnosticsBox.debug("[minivm] bb=" + me._int_to_str(ProgramStateBox.bb(st)) + ", prev=" + me._int_to_str(ProgramStateBox.prev_bb(st)) + ", start=" + me._int_to_str(start))
      if start < 0 { return 0 }
      local endp = CfgNavigatorBox.block_insts_end(mjson, start)
      DiagnosticsBox.debug("[minivm] endp=" + me._int_to_str(endp))
      if endp <= start { return 0 }
      local inst_seg = mjson.substring(start, endp)
      DiagnosticsBox.debug("[minivm] seglen=" + me._int_to_str(inst_seg.size()))
      // Eager minimal resolver for compare→ret when ret targets compare dst
      if me.index_of_from(inst_seg, "\"op\":\"compare\"", 0) >= 0 {
        local cdst0 = JsonFragBox.get_int(inst_seg, "dst")
        local rid0 = JsonFragBox.get_int(inst_seg, "value")
        if cdst0 != null { if rid0 != null { if rid0 == cdst0 {
          // parse first two typed const values (escape-aware)
          local vals0 = InstValueScanBox.find_i64_values(inst_seg, 2)
          if vals0.size() >= 2 {
            local lv0 = JsonFragBox._str_to_int(vals0.get(0))
            local rv0 = JsonFragBox._str_to_int(vals0.get(1))
            // compare op (escape-aware via InstScanBox)
            local cmp0 = InstScanBox.extract_cmp(inst_seg)
            if cmp0 == "Eq" { if lv0 == rv0 { return 1 } else { return 0 } }
            if cmp0 == "Ne" { if lv0 != rv0 { return 1 } else { return 0 } }
            if cmp0 == "Gt" { if lv0 > rv0 { return 1 } else { return 0 } }
            if cmp0 == "Ge" { if lv0 >= rv0 { return 1 } else { return 0 } }
            if cmp0 == "Lt" { if lv0 < rv0 { return 1 } else { return 0 } }
            if cmp0 == "Le" { if lv0 <= rv0 { return 1 } else { return 0 } }
            return 0
          }
        } } }
      }
      // Fast-path: simple compare→ret in a single block (robust)
      if me.index_of_from(inst_seg, "\"op\":\"compare\"", 0) >= 0 && me.index_of_from(inst_seg, "\"op\":\"ret\"", 0) >= 0 {
        local vals = InstValueScanBox.find_i64_values(inst_seg, 2)
        if vals.size() >= 2 {
          local lv = JsonFragBox._str_to_int(vals.get(0))
          local rv = JsonFragBox._str_to_int(vals.get(1))
          // compare op
          local cmp = InstScanBox.extract_cmp(inst_seg)
          local cv = 0
          if cmp == "Eq" { if lv == rv { cv = 1 } else { cv = 0 } }
          else if cmp == "Ne" { if lv != rv { cv = 1 } else { cv = 0 } }
          else if cmp == "Gt" { if lv > rv { cv = 1 } else { cv = 0 } }
          else if cmp == "Ge" { if lv >= rv { cv = 1 } else { cv = 0 } }
          else if cmp == "Lt" { if lv < rv { cv = 1 } else { cv = 0 } }
          else if cmp == "Le" { if lv <= rv { cv = 1 } else { cv = 0 } }
          return cv
        }
      }
      // Fast-path: simple compare→ret in a single block (robust to scanner quirks)
      if me.index_of_from(inst_seg, "\"op\":\"compare\"", 0) >= 0 && me.index_of_from(inst_seg, "\"op\":\"ret\"", 0) >= 0 {
        // Grab first two typed const values
        local vals = new ArrayBox()
        local search = inst_seg
        local key = "\"value\":{\"type\":\"i64\",\"value\":"
        local pos = 0
        loop(true) {
          local k = me.index_of_from(search, key, pos)
          if k < 0 { break }
          local ds = search.substring(k + key.size(), search.size())
          local i = 0
          local out = ""
          loop(true) {
            local ch = ds.substring(i, i+1)
            if ch == "" { break }
            if ch >= "0" && ch <= "9" { out = out + ch  i = i + 1 } else { break }
          }
          if out != "" { vals.push(out) }
          if vals.size() >= 2 { break }
          pos = k + key.size() + i
        }
        if vals.size() >= 2 {
          local lv = 0
          local rv = 0
          local i0 = 0
          loop(i0 < vals.get(0).size()) { lv = lv * 10 + ("0123456789".indexOf(vals.get(0).substring(i0,i0+1)))  i0 = i0 + 1 }
          local i1 = 0
          loop(i1 < vals.get(1).size()) { rv = rv * 10 + ("0123456789".indexOf(vals.get(1).substring(i1,i1+1)))  i1 = i1 + 1 }
          // compare op
          local cmp = InstScanBox.extract_cmp(inst_seg)
          local cv = 0
          if cmp == "Eq" { if lv == rv { cv = 1 } else { cv = 0 } }
          else if cmp == "Ne" { if lv != rv { cv = 1 } else { cv = 0 } }
          else if cmp == "Gt" { if lv > rv { cv = 1 } else { cv = 0 } }
          else if cmp == "Ge" { if lv >= rv { cv = 1 } else { cv = 0 } }
          else if cmp == "Lt" { if lv < rv { cv = 1 } else { cv = 0 } }
          else if cmp == "Le" { if lv <= rv { cv = 1 } else { cv = 0 } }
          return cv
        }
      }
      local scan_pos = 0
      local moved = 0
      loop(true){
        if scan_pos >= inst_seg.size() { break }
        // Delegate object decode to InstrDecoderBox (thin wrapper over InstructionScannerBox)
        local nxt = InstrDecoderBox.next(inst_seg, scan_pos)
        if nxt == null { break }
        local obj_start = nxt.get("start")
        local obj_end = nxt.get("end")
        local op = nxt.get("op")
        local seg = inst_seg.substring(obj_start, obj_end)
        if op == null { op = "" }
        if op == "null" { op = "" }
        if op == 0 { op = "" }
        DiagnosticsBox.debug("[minivm] op=" + op)
        if op == "" {
          if me.index_of_from(seg, "\"op_kind\"", 0) >= 0 { op = "binop" } else {
            if me.index_of_from(seg, "\"lhs\"", 0) >= 0 and me.index_of_from(seg, "\"rhs\"", 0) >= 0 { op = "compare" } else {
            if me.index_of_from(seg, "\"cond\"", 0) >= 0 { op = "branch" } else {
              if me.index_of_from(seg, "\"target\"", 0) >= 0 { op = "jump" } else {
                if me.index_of_from(seg, "\"src\"", 0) >= 0 and me.index_of_from(seg, "\"dst\"", 0) >= 0 { op = "copy" } else { op = "const" }
              }
            }
          } }
        }
        if op == "const" { OpHandlersBox.handle_const(seg, regs) }
        else if op == "copy" { me._handle_copy(seg, regs) }
        else if op == "binop" {
          OpHandlersBox.handle_binop(seg, regs)
          local bdst = JsonFragBox.get_int(seg, "dst")
          if bdst != null { last_binop_dst = bdst  last_binop_val = me._load_reg(regs, bdst) }
        }        else if op == "compare" {
          // Normalize v0/v1 compare via scanner box
          local rec = CompareScanBox.parse(seg)
          OpHandlersBox.handle_compare(seg, regs)
          local kdst = (rec != null ? rec.get("dst") : JsonFragBox.get_int(seg, "dst"))
          if kdst != null { last_cmp_dst = kdst  last_cmp_val = me._load_reg(regs, kdst) }
          // Early-return optimization for simple compare→ret in same block
          local tail = inst_seg.substring(obj_end, inst_seg.size())
          if me.index_of_from(tail, "\"op\":\"ret\"", 0) >= 0 {
            local ridt = JsonFragBox.get_int(tail, "value")
            if ridt != null { if ridt == last_cmp_dst { return last_cmp_val } }
          }
        }
        else if op == "branch" {
          local c = JsonFragBox.get_int(seg, "cond")
          local t = JsonFragBox.get_int(seg, "then")
          local e = JsonFragBox.get_int(seg, "else")
          local cv = 0
          if c != null {
            if c == last_cmp_dst { cv = last_cmp_val } else { cv = me._load_reg(regs, c) }
          }
          ProgramStateBox.set_prev_bb(st, bb)
          if cv != 0 { bb = t } else { bb = e }
          ProgramStateBox.set_bb(st, bb)
          moved = 1
          scan_pos = obj_end
          break
        }
        else if op == "jump" {
          local tgt = JsonFragBox.get_int(seg, "target")
          if tgt == null { return 0 }
          ProgramStateBox.set_prev_bb(st, bb)
          bb = tgt
          ProgramStateBox.set_bb(st, bb)
          moved = 1
          scan_pos = obj_end
          break
        }
        else if op == "phi" {
          local res = PhiDecodeBox.decode_result(seg, ProgramStateBox.prev_bb(st))
          if res.is_ok() == 1 {
            local pair = res.value()
            // Route wiring via PhiWiringBox (thin layer), maintaining existing behavior
            PhiWiringBox.wire(pair, regs)
          }
        }
        else if op == "throw" {
          me._tprint("[ERROR] Throw terminator encountered")
          return -2
        }
        else if op == "ret" {
          local v = JsonFragBox.get_int(seg, "value")
          return RetResolverBox.resolve(regs, v, last_cmp_dst, last_cmp_val)
        }
        // advance
        scan_pos = obj_end
      }
      if moved == 1 { continue }
      // Fallback: if a ret exists in this block but was not processed (scanner miss), decode directly
      // Detect explicit op:"ret"
      if me.index_of_from(inst_seg, "\"op\":\"ret\"", 0) >= 0 {
        local rstart = me.index_of_from(inst_seg, "\"op\":\"ret\"", 0)
        local rseg = inst_seg.substring(rstart, inst_seg.size())
        local rid = JsonFragBox.get_int(rseg, "value")
        if rid != null { return RetResolverBox.resolve(regs, rid, last_cmp_dst, last_cmp_val) }
      }
      // Detect v1 style {"kind":"Ret"} or object with only value
      if me.index_of_from(inst_seg, "\"kind\":\"Ret\"", 0) >= 0 || (me.index_of_from(inst_seg, "\"value\"", 0) >= 0 && me.index_of_from(inst_seg, "\"lhs\"", 0) < 0 && me.index_of_from(inst_seg, "\"rhs\"", 0) < 0 && me.index_of_from(inst_seg, "\"cond\"", 0) < 0 && me.index_of_from(inst_seg, "\"target\"", 0) < 0 && me.index_of_from(inst_seg, "\"src\"", 0) < 0) {
        local rid2 = JsonFragBox.get_int(inst_seg, "value")
        if rid2 != null { return RetResolverBox.resolve(regs, rid2, last_cmp_dst, last_cmp_val) }
      }
      // Robust fallback: if both compare and ret exist, recompute compare result and return it when ret targets compare dst
      if me.index_of_from(inst_seg, "\"op\":\"compare\"", 0) >= 0 && me.index_of_from(inst_seg, "\"op\":\"ret\"", 0) >= 0 {
        // Extract compare segment (from first compare occurrence)
        local cstart = me.index_of_from(inst_seg, "\"op\":\"compare\"", 0)
        local cseg = inst_seg.substring(cstart, inst_seg.size())
        // Normalize fields via CompareScanBox (v0/v1 tolerant)
        local rec = CompareScanBox.parse(cseg)
        // Fallback to direct ints only if parse failed
        local cdst = (rec != null ? rec.get("dst") : JsonFragBox.get_int(cseg, "dst"))
        local clhs = (rec != null ? rec.get("lhs") : JsonFragBox.get_int(cseg, "lhs"))
        local crhs = (rec != null ? rec.get("rhs") : JsonFragBox.get_int(cseg, "rhs"))
        local kind = (rec != null ? rec.get("kind") : "Eq")
        // Resolve lhs/rhs values from regs
        local lv = me._load_reg(regs, clhs)
        local rv = me._load_reg(regs, crhs)
        if lv == null { lv = 0 }
        if rv == null { rv = 0 }
        // Compute compare via CompareOpsBox
        local cv = CompareOpsBox.eval(kind, lv, rv)
        // Read fields
        // Read fields
        // Extract ret id
        local rstart3 = me.index_of_from(inst_seg, "\"op\":\"ret\"", 0)
        local rseg3 = inst_seg.substring(rstart3, inst_seg.size())
        local rid3 = JsonFragBox.get_int(rseg3, "value")
        if rid3 != null {
          if rid3 == cdst { return cv }
          // else return the register content if available
          local rv3 = me._load_reg(regs, rid3)
          if rv3 != null { return rv3 }
        }
      }
      // Default: if a recent compare produced a value, prefer that as ret
      if last_cmp_dst >= 0 { return last_cmp_val }
      // Fallback: return first register when no terminator is found
      local first = me._load_reg(regs, 1)
      return first
    }
    return 0
  }
}
