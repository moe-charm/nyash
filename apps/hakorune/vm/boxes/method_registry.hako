// method_registry.hako — MethodRegistryBox (built-ins, minimal)
// Responsibility: expose known (Box, method, arity) signatures for compile-time checks.

static box MethodRegistryBox {
  // Return 1 if known, else 0
  is_known(box_name, method, arity) {
    local b = "" + box_name
    local m = "" + method
    local a = ("" + arity) + ""
    // StringBox
    if b == "StringBox" {
      if m == "len" && a == "0" { return 1 }
      if m == "substring" && a == "2" { return 1 }
      if m == "concat" && a == "1" { return 1 }
      if m == "indexOf" && a == "1" { return 1 }
      if m == "replace" && a == "2" { return 1 }
      if m == "trim" && a == "0" { return 1 }
      if m == "toUpper" && a == "0" { return 1 }
      if m == "toLower" && a == "0" { return 1 }
    if m == "toString" && a == "0" { return 1 }
    if m == "stringify" && a == "0" { return 1 }
    if m == "startsWith" && a == "1" { return 1 }
    if m == "endsWith" && a == "1" { return 1 }
      if m == "toString" && a == "0" { return 1 }
      if m == "stringify" && a == "0" { return 1 }
      if m == "startsWith" && a == "1" { return 1 }
      if m == "endsWith" && a == "1" { return 1 }
      return 0
    }
    // ArrayBox
    if b == "ArrayBox" {
      if m == "get" && a == "1" { return 1 }
      if m == "set" && a == "2" { return 1 }
      if m == "len" && a == "0" { return 1 }
      if m == "length" && a == "0" { return 1 }
      if m == "push" && a == "1" { return 1 }
      if m == "pop" && a == "0" { return 1 }
      if m == "clear" && a == "0" { return 1 }
      if m == "contains" && a == "1" { return 1 }
      if m == "indexOf" && a == "1" { return 1 }
      if m == "join" && a == "1" { return 1 }
      if m == "sort" && a == "0" { return 1 }
      if m == "reverse" && a == "0" { return 1 }
      if m == "slice" && a == "2" { return 1 }
      if m == "toJSON" && a == "0" { return 1 }
      if m == "toString" && a == "0" { return 1 }
      if m == "stringify" && a == "0" { return 1 }
      return 0
    }
    // MapBox
    if b == "MapBox" {
      if m == "size" && a == "0" { return 1 }
      if m == "len" && a == "0" { return 1 }
      if m == "has" && a == "1" { return 1 }
      if m == "get" && a == "1" { return 1 }
      if m == "set" && a == "2" { return 1 }
      if m == "delete" && a == "1" { return 1 }
      if m == "remove" && a == "1" { return 1 }
      if m == "keys" && a == "0" { return 1 }
      if m == "values" && a == "0" { return 1 }
      if m == "clear" && a == "0" { return 1 }
      if m == "toJSON" && a == "0" { return 1 }
      if m == "toString" && a == "0" { return 1 }
      if m == "stringify" && a == "0" { return 1 }
      return 0
    }
    return 0
  }

  // Name-only arity check for verifier (when receiver type is unknown).
  // Returns 1 if (method, arity) is known for at least one built‑in box.
  is_name_arity_known(method, arity) {
    local m = "" + method
    local a = ("" + arity) + ""
    // String‑like
    if m == "len" && a == "0" { return 1 }
    if m == "length" && a == "0" { return 1 }
    if m == "substring" && a == "2" { return 1 }
    if m == "concat" && a == "1" { return 1 }
    if m == "indexOf" && a == "1" { return 1 }
    if m == "replace" && a == "2" { return 1 }
    if m == "trim" && a == "0" { return 1 }
    if m == "toUpper" && a == "0" { return 1 }
    if m == "toLower" && a == "0" { return 1 }
    if m == "toString" && a == "0" { return 1 }
    if m == "stringify" && a == "0" { return 1 }
    if m == "startsWith" && a == "1" { return 1 }
    if m == "endsWith" && a == "1" { return 1 }
    // Array‑like
    if m == "get" && a == "1" { return 1 }
    if m == "set" && a == "2" { return 1 }
    if m == "push" && a == "1" { return 1 }
    if m == "pop" && a == "0" { return 1 }
    if m == "clear" && a == "0" { return 1 }
    if m == "contains" && a == "1" { return 1 }
    if m == "indexOf" && a == "1" { return 1 }
    if m == "join" && a == "1" { return 1 }
    if m == "sort" && a == "0" { return 1 }
    if m == "reverse" && a == "0" { return 1 }
    if m == "slice" && a == "2" { return 1 }
    if m == "toJSON" && a == "0" { return 1 }
    // Map‑like
    if m == "size" && a == "0" { return 1 }
    if m == "has" && a == "1" { return 1 }
    if m == "get" && a == "1" { return 1 }
    if m == "set" && a == "2" { return 1 }
    if m == "delete" && a == "1" { return 1 }
    if m == "remove" && a == "1" { return 1 }
    if m == "keys" && a == "0" { return 1 }
    if m == "values" && a == "0" { return 1 }
    if m == "clear" && a == "0" { return 1 }
    if m == "toJSON" && a == "0" { return 1 }
    return 0
  }

}
