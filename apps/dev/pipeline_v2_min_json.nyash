// Dev sample: run pipeline v2 (emit-only) with a tiny source
using "selfhost/compiler/pipeline_v2/execution_pipeline_box.hako" as PipelineMod

static box Main {
  main(args) {
    local src = "return 0"
    if args != null && args.size() > 0 { src = args.get(0) }
    local p = new ExecutionPipelineBox()
    // Stage‑3 disabled by default here
    return p.run_source(src, 0)
  }
}
