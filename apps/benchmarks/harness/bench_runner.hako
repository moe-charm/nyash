// Benchmark Runner Box - ChatGPT Pro設計準拠（DESIGN.md Phase 1最小実装）
//
// 目的: apps/benchmarks/DESIGN.mdに基づく商用レベルベンチマークシステム
// Phase 1実装: Timer/Stats/Runner Boxの最小セット

// ========================================
// Timer Box - Monotonic clock (モノトニック時計)
// ========================================
box TimerBox {
    birth() {
        // 初期化処理なし（ExternCall経由でシステム時計使用）
    }

    now_ms() {
        // 現在時刻（ミリ秒）を返す
        // 注: ExternCall("nyrt.time.now_ms")が必要
        // 暫定: 0返却（実装予定）
        return 0
    }
}

// ========================================
// Stats Box - 統計計算
// ========================================
box StatsBox {
    samples: ArrayBox

    birth() {
        me.samples = new ArrayBox()
    }

    push(value) {
        me.samples.push(value)
    }

    length() {
        return me.samples.length()
    }

    // 平均値計算
    mean() {
        local sum, count, i
        sum = 0
        count = me.samples.length()

        if count == 0 {
            return 0
        }

        i = 0
        loop(i < count) {
            sum = sum + me.samples.at(i)
            i = i + 1
        }

        return sum / count
    }

    // 中央値計算
    median() {
        local count, sorted, mid
        count = me.samples.length()

        if count == 0 {
            return 0
        }

        // 注: ArrayBox.sort()が必要
        // 暫定: meanを返す（実装予定）
        return me.mean()
    }

    // 95パーセンタイル
    p95() {
        local count, idx
        count = me.samples.length()

        if count == 0 {
            return 0
        }

        // 注: ArrayBox.sort()が必要
        // 暫定: meanを返す（実装予定）
        return me.mean()
    }

    // 最小値
    min() {
        local count, i, current_min
        count = me.samples.length()

        if count == 0 {
            return 0
        }

        current_min = me.samples.at(0)
        i = 1
        loop(i < count) {
            local val
            val = me.samples.at(i)
            if val < current_min {
                current_min = val
            }
            i = i + 1
        }

        return current_min
    }

    // 最大値
    max() {
        local count, i, current_max
        count = me.samples.length()

        if count == 0 {
            return 0
        }

        current_max = me.samples.at(0)
        i = 1
        loop(i < count) {
            local val
            val = me.samples.at(i)
            if val > current_max {
                current_max = val
            }
            i = i + 1
        }

        return current_max
    }
}

// ========================================
// Runner Box - ベンチマーク実行（最小実装）
// ========================================
box RunnerBox {
    target: StringBox
    timer: TimerBox

    birth(target) {
        me.target = target
        me.timer = new TimerBox()
    }

    // 単一実行（時間計測）
    // 注: 実際のベンチマーク実行はexecで実装予定
    run_once(file) {
        local t0, t1

        t0 = me.timer.now_ms()

        // 注: ExecBox::run(file)実装予定
        // 暫定: 固定値返却

        t1 = me.timer.now_ms()

        return t1 - t0
    }

    // 🎯 固定時間方式ベンチマーク（推奨・デフォルト）
    // duration_sec: 実行時間（秒）
    // 戻り値: { iterations, duration_ms, ops_per_sec }
    run_duration(file, duration_sec) {
        local start_time, end_time, current_time
        local iterations, elapsed_ms
        local result

        start_time = me.timer.now_ms()
        end_time = start_time + (duration_sec * 1000)  // 秒→ミリ秒変換

        iterations = 0

        print("Running for " + duration_sec + " seconds...")

        // 固定時間方式: end_timeまで繰り返し実行
        current_time = me.timer.now_ms()
        loop(current_time < end_time) {
            me.run_once(file)
            iterations = iterations + 1
            current_time = me.timer.now_ms()
        }

        elapsed_ms = current_time - start_time

        // 結果を構造化して返す（MapBoxで簡易的に実装）
        result = new MapBox()
        result.set("iterations", iterations)
        result.set("duration_ms", elapsed_ms)

        // ops/sec計算（ミリ秒→秒変換）
        local duration_sec_actual
        duration_sec_actual = elapsed_ms / 1000
        local ops_per_sec
        if duration_sec_actual > 0 {
            ops_per_sec = iterations / duration_sec_actual
        } else {
            ops_per_sec = 0
        }
        result.set("ops_per_sec", ops_per_sec)

        return result
    }

    // 🔢 固定回数方式ベンチマーク（オプション）
    // repeat: 実行回数
    run(file, warmup, repeat) {
        local i, stats

        // Warmupフェーズ（計測しない）
        print("Warmup...")
        i = 0
        loop(i < warmup) {
            me.run_once(file)
            i = i + 1
        }

        // 計測フェーズ
        print("Measuring...")
        stats = new StatsBox()
        i = 0
        loop(i < repeat) {
            local elapsed
            elapsed = me.run_once(file)
            stats.push(elapsed)
            i = i + 1
        }

        return stats
    }
}

// ========================================
// Main Entry Point
// ========================================
static box Main {
    main(args) {
        print("=== Benchmark Runner - 固定時間方式実装 ===")

        local runner, result
        runner = new RunnerBox("vm")

        // 🎯 固定時間方式テスト（1秒間）
        result = runner.run_duration("dummy.hako", 1)

        print("=== 固定時間ベンチマーク結果 ===")
        print("Iterations: " + result.get("iterations"))
        print("Duration: " + result.get("duration_ms") + " ms")
        print("Ops/sec: " + result.get("ops_per_sec"))

        return 0
    }
}
