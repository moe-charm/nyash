//! method.rs — Method dispatch
//!
//! Behavior-preserving extraction of execute_method_call from legacy.

use super::super::*;

impl MirInterpreter {
    pub(crate) fn execute_method_call(
        &mut self,
        receiver: &VMValue,
        method: &str,
        args: &[ValueId],
     ) -> Result<VMValue, VMError> {
        {
            let mut argv_vals: Vec<VMValue> = Vec::with_capacity(args.len());
            for a in args { argv_vals.push(self.reg_load(*a)?); }
            return crate::runtime::method_router_box::route(self, receiver, method, &argv_vals);
        }

        // Built-in arity validation (Fail-Fast)
        {
            let arity = args.len();
            let mut type_name: Option<&str> = None;
            match receiver {
                VMValue::String(_) => { type_name = Some("StringBox"); }
                VMValue::BoxRef(bx) => {
                    let tn = bx.type_name();
                    if matches!(tn, "ArrayBox" | "MapBox" | "StringBox") { type_name = Some(tn); }
                }
                _ => {}
            }
            if let Some(tn) = type_name {
                if method != "birth" {
                    if crate::runtime::type_registry::resolve_typebox_by_name(tn).is_some() {
                        if crate::runtime::type_registry::resolve_slot_by_name(tn, method, arity).is_none() {
                            if let Some(known) = crate::runtime::type_registry::known_arities_for(tn, method) {
                                if !known.is_empty() {
                                    return Err(VMError::InvalidInstruction(format!(
                                        "No matching method: {}.{}({} args). Available arities: {:?}", tn, method, arity, known
                                    )));
                                }
                            }
                        }
                    }
                }
            }
        }

        match receiver {
            VMValue::String(s) => match method {
                "length" | "size" => Ok(VMValue::Integer(hako_core_string::length_bytes(s) )),
                "isEmpty" => Ok(VMValue::Bool(hako_core_string::is_empty(s))),
                "concat" => {
                    if let Some(arg_id) = args.get(0) {
                        let arg_val = self.reg_load(*arg_id)?;
                        let new_str = format!("{}{}", s, arg_val.to_string());
                        Ok(VMValue::String(new_str))
                    } else {
                        Err(VMError::InvalidInstruction(
                            "concat requires 1 argument".into(),
                        ))
                    }
                }
                "indexOf" => {
                    if args.len() == 0 || args.len() > 2 {
                        return Err(VMError::InvalidInstruction(format!(
                            "No matching method: StringBox.indexOf({} args). Available arities: [1,2]",
                            args.len()
                        )));
                    }
                    let needle = if let Some(arg_id) = args.get(0) { self.reg_load(*arg_id)?.to_string() } else { String::new() };
                    let from = if let Some(arg_id) = args.get(1) { self.reg_load(*arg_id)?.as_integer().unwrap_or(0) } else { 0 };
                    let idx = hako_core_string::index_of(s, &needle, from);
                    Ok(VMValue::Integer(idx))
                }
                "substring" => {
                    let start = if let Some(a0) = args.get(0) { self.reg_load(*a0)?.as_integer().unwrap_or(0) } else { 0 };
                    let end   = if let Some(a1) = args.get(1) { self.reg_load(*a1)?.as_integer().unwrap_or(hako_core_string::length_bytes(s)) } else { hako_core_string::length_bytes(s) };
                    let sub = hako_core_string::substring_bytes(s, start, end);
                    Ok(VMValue::String(sub))
                }
                "lastIndexOf" => {
                    // Allow 1 or 2 args: (needle) or (needle, from)
                    if args.is_empty() || args.len() > 2 {
                        return Err(VMError::InvalidInstruction(format!(
                            "No matching method: StringBox.lastIndexOf({} args). Available arities: [1,2]",
                            args.len()
                        )));
                    }
                    let needle = if let Some(a0) = args.get(0) { self.reg_load(*a0)?.to_string() } else { String::new() };
                    let from = if let Some(a1) = args.get(1) { self.reg_load(*a1)?.as_integer().unwrap_or(hako_core_string::length_bytes(s)) } else { hako_core_string::length_bytes(s) };
                    Ok(VMValue::Integer(hako_core_string::last_index_of(s, &needle, from)))
                }
                "charAt" => {
                    if args.len() != 1 {
                        return Err(VMError::InvalidInstruction(format!(
                            "No matching method: StringBox.charAt({} args). Available arities: [1]",
                            args.len()
                        )));
                    }
                    let idx = if let Some(a0) = args.get(0) { self.reg_load(*a0)?.as_integer().unwrap_or(0) } else { 0 };
                    let ch = hako_core_string::char_at_byte(s, idx);
                    Ok(VMValue::String(ch))
                }
                _ => Err(VMError::InvalidInstruction(format!(
                    "Unknown String method: {}",
                    method
                ))),
            },
            VMValue::BoxRef(box_ref) => {
                if let Some(p) = box_ref
                    .as_any()
                    .downcast_ref::<crate::runtime::plugin_loader_v2::PluginBoxV2>()
                {
                    // Plugin ArrayBox: provide shim for slice(start,end) using length/get (no native slice yet)
                    if p.box_type == "ArrayBox" && method == "slice" {
                        if args.len() != 2 {
                            return Err(VMError::InvalidInstruction(format!(
                                "No matching method: ArrayBox.slice({} args). Available arities: [2]",
                                args.len()
                            )));
                        }
                        let start_i = self.reg_load(args[0])?.as_integer().unwrap_or(0);
                        let end_i = self.reg_load(args[1])?.as_integer().unwrap_or(0);
                        let host = crate::runtime::plugin_loader_unified::get_global_plugin_host();
                        let len_i = if let Ok(ro) = host.read() {
                            if let Ok(ret) = ro.invoke_instance_method("ArrayBox", "length", p.inner.instance_id, &[]) {
                                if let Some(vb) = ret { if let Some(ii)= vb.as_any().downcast_ref::<crate::box_trait::IntegerBox>() { ii.value } else { 0 } } else { 0 }
                            } else { 0 }
                        } else { 0 };
                        let (i0, i1) = hako_core_array::slice_bounds(len_i as usize, start_i, end_i);
                        let mut out_arr = crate::boxes::array::ArrayBox::new();
                        if let Ok(ro) = host.read() {
                            for i in i0..i1 {
                                let idxb: Box<dyn crate::box_trait::NyashBox> = Box::new(crate::box_trait::IntegerBox::new(i as i64));
                                if let Ok(ret) = ro.invoke_instance_method("ArrayBox", "get", p.inner.instance_id, &[idxb]) {
                                    if let Some(v) = ret { out_arr.push(v); }
                                }
                            }
                        }
                        return Ok(VMValue::from_nyash_box(Box::new(out_arr)));
                    }
                    // Host-side shim: MapBox.keys()/values() → ArrayBox (strings)
                    if p.box_type == "MapBox" {
                        if method == "keys" || method == "values" {
                            let host = crate::runtime::plugin_loader_unified::get_global_plugin_host();
                            let host = host.read().unwrap();
                            // Prefer *S variants that return newline-joined string
                            let meth = if method == "keys" { "keysS" } else { "valuesS" };
                            if let Ok(ret) = host.invoke_instance_method("MapBox", meth, p.inner.instance_id, &[]) {
                                if let Some(sbox) = ret.and_then(|b| b.as_any().downcast_ref::<crate::box_trait::StringBox>().map(|sb| sb.value.clone())) {
                                    let arr = crate::boxes::array::ArrayBox::new();
                                    for item in sbox.lines() {
                                        if !item.is_empty() {
                                            arr.push(Box::new(crate::box_trait::StringBox::new(item)));
                                        }
                                    }
                                    let v = VMValue::from_nyash_box(Box::new(arr));
                                    self.maybe_register_scope_value(&v);
                                    return Ok(v);
                                }
                            }
                            // If plugin lacks *S variants, fall-through to normal path (may error)
                        }
                    }
                    let host =
                        crate::runtime::plugin_loader_unified::get_global_plugin_host();
                    let host = host.read().unwrap();
                    let mut argv: Vec<Box<dyn crate::box_trait::NyashBox>> =
                        Vec::with_capacity(args.len());
                    for a in args {
                        argv.push(self.reg_load(*a)?.to_nyash_box());
                    }
                    let out = host.invoke_instance_method(&p.box_type, method, p.inner.instance_id, &argv);
                    match out {
                        Ok(Some(ret)) => { let v = VMValue::from_nyash_box(ret); self.maybe_register_scope_value(&v); Ok(v) },
                        Ok(None) => Ok(VMValue::Void),
                        Err(e) => Err(VMError::InvalidInstruction(format!(
                            "Plugin method {}.{} failed: {:?}",
                            p.box_type, method, e
                        ))),
                    }
                } else {
                    // Builtin core boxes (Array/Map/String) — minimal support here
                    match box_ref.type_name() {
                        "ArrayBox" => match method {
                            "length" | "size" => {
                                if let Some(arr) = box_ref.as_any().downcast_ref::<crate::boxes::array::ArrayBox>() {
                                    Ok(VMValue::Integer(arr.len() as i64))
                                } else { Err(VMError::InvalidInstruction("ArrayBox downcast failed".into())) }
                            }
                            "get" => {
                                if let Some(arr) = box_ref.as_any().downcast_ref::<crate::boxes::array::ArrayBox>() {
                                    if args.len() != 1 { return Err(VMError::InvalidInstruction(format!("No matching method: ArrayBox.get({} args). Available arities: [1]", args.len()))); }
                                    let idx = self.reg_load(args[0])?.as_integer().unwrap_or(0);
                                    let vb = arr.get(Box::new(crate::box_trait::IntegerBox::new(idx)));
                                    Ok(VMValue::from_nyash_box(vb))
                                } else { Err(VMError::InvalidInstruction("ArrayBox downcast failed".into())) }
                            }
                            "set" => {
                                if let Some(arr) = box_ref.as_any().downcast_ref::<crate::boxes::array::ArrayBox>() {
                                    if args.len() != 2 { return Err(VMError::InvalidInstruction(format!("No matching method: ArrayBox.set({} args). Available arities: [2]", args.len()))); }
                                    let idx = self.reg_load(args[0])?.as_integer().unwrap_or(0);
                                    let val = self.reg_load(args[1])?.to_nyash_box();
                                    let _ = arr.set(Box::new(crate::box_trait::IntegerBox::new(idx)), val);
                                    Ok(VMValue::Void)
                                } else { Err(VMError::InvalidInstruction("ArrayBox downcast failed".into())) }
                            }
                            "push" => {
                                if let Some(arr) = box_ref.as_any().downcast_ref::<crate::boxes::array::ArrayBox>() {
                                    if args.len() != 1 { return Err(VMError::InvalidInstruction(format!("No matching method: ArrayBox.push({} args). Available arities: [1]", args.len()))); }
                                    let val = self.reg_load(args[0])?.to_nyash_box();
                                    let _ = arr.push(val);
                                    Ok(VMValue::Void)
                                } else { Err(VMError::InvalidInstruction("ArrayBox downcast failed".into())) }
                            }
                            "slice" => {
                                if let Some(arr) = box_ref.as_any().downcast_ref::<crate::boxes::array::ArrayBox>() {
                                    if args.len() != 2 { return Err(VMError::InvalidInstruction(format!("No matching method: ArrayBox.slice({} args). Available arities: [2]", args.len()))); }
                                    let s = self.reg_load(args[0])?.as_integer().unwrap_or(0);
                                    let e = self.reg_load(args[1])?.as_integer().unwrap_or(0);
                                    let out = arr.slice(
                                        Box::new(crate::box_trait::IntegerBox::new(s)),
                                        Box::new(crate::box_trait::IntegerBox::new(e)),
                                    );
                                    Ok(VMValue::from_nyash_box(out))
                                } else { Err(VMError::InvalidInstruction("ArrayBox downcast failed".into())) }
                            }
                            "toJSON" => {
                                if let Some(arr) = box_ref.as_any().downcast_ref::<crate::boxes::array::ArrayBox>() {
                                    let s = crate::boxes::json::stringify_any(arr.clone_box());
                                    Ok(VMValue::String(s))
                                } else { Err(VMError::InvalidInstruction("ArrayBox downcast failed".into())) }
                            }
                            _ => Err(VMError::InvalidInstruction(format!("Unknown ArrayBox method: {}", method))),
                        },
                        "MapBox" => match method {
                            "size" => {
                                if let Some(mp) = box_ref.as_any().downcast_ref::<crate::boxes::map_box::MapBox>() {
                                    let ib = mp.size();
                                    if let Some(ii) = ib.as_any().downcast_ref::<crate::box_trait::IntegerBox>() {
                                        Ok(VMValue::Integer(ii.value))
                                    } else {
                                        Ok(VMValue::Integer(0))
                                    }
                                } else { Err(VMError::InvalidInstruction("MapBox downcast failed".into())) }
                            }
                            "set" => {
                                if let Some(mp) = box_ref.as_any().downcast_ref::<crate::boxes::map_box::MapBox>() {
                                    // set(key, value) -> null
                                    if args.len() != 2 {
                                        return Err(VMError::InvalidInstruction(format!("No matching method: MapBox.set({} args). Available arities: [2]", args.len())));
                                    }
                                    let key_box = self.reg_load(args[0])?.to_nyash_box();
                                    let val_box = self.reg_load(args[1])?.to_nyash_box();
                                    let _ = mp.set(key_box, val_box);
                                    Ok(VMValue::Void)
                                } else { Err(VMError::InvalidInstruction("MapBox downcast failed".into())) }
                            }
                            "get" => {
                                if let Some(mp) = box_ref.as_any().downcast_ref::<crate::boxes::map_box::MapBox>() {
                                    if args.len() != 1 {
                                        return Err(VMError::InvalidInstruction(format!("No matching method: MapBox.get({} args). Available arities: [1]", args.len())));
                                    }
                                    let key_box = self.reg_load(args[0])?.to_nyash_box();
                                    Ok(VMValue::from_nyash_box(mp.get(key_box)))
                                } else { Err(VMError::InvalidInstruction("MapBox downcast failed".into())) }
                            }
                            "has" => {
                                if let Some(mp) = box_ref.as_any().downcast_ref::<crate::boxes::map_box::MapBox>() {
                                    if args.len() != 1 {
                                        return Err(VMError::InvalidInstruction(format!("No matching method: MapBox.has({} args). Available arities: [1]", args.len())));
                                    }
                                    let key_box = self.reg_load(args[0])?.to_nyash_box();
                                    let bb = mp.has(key_box);
                                    if let Some(b) = bb.as_any().downcast_ref::<crate::box_trait::BoolBox>() {
                                        Ok(VMValue::Bool(b.value))
                                    } else { Ok(VMValue::Bool(false)) }
                                } else { Err(VMError::InvalidInstruction("MapBox downcast failed".into())) }
                            }
                            "clear" => {
                                if let Some(mp) = box_ref.as_any().downcast_ref::<crate::boxes::map_box::MapBox>() {
                                    let _ = mp.clear();
                                    Ok(VMValue::Void)
                                } else { Err(VMError::InvalidInstruction("MapBox downcast failed".into())) }
                            }
                            "delete" => {
                                if let Some(mp) = box_ref.as_any().downcast_ref::<crate::boxes::map_box::MapBox>() {
                                    if args.len() != 1 { return Err(VMError::InvalidInstruction(format!("No matching method: MapBox.delete({} args). Available arities: [1]", args.len()))); }
                                    let key_box = self.reg_load(args[0])?.to_nyash_box();
                                    let _ = mp.delete(key_box);
                                    Ok(VMValue::Void)
                                } else { Err(VMError::InvalidInstruction("MapBox downcast failed".into())) }
                            }
                            "keys" => {
                                if let Some(mp) = box_ref.as_any().downcast_ref::<crate::boxes::map_box::MapBox>() {
                                    Ok(VMValue::from_nyash_box(mp.keys()))
                                } else { Err(VMError::InvalidInstruction("MapBox downcast failed".into())) }
                            }
                        "values" => {
                            if let Some(mp) = box_ref.as_any().downcast_ref::<crate::boxes::map_box::MapBox>() {
                                Ok(VMValue::from_nyash_box(mp.values()))
                            } else { Err(VMError::InvalidInstruction("MapBox downcast failed".into())) }
                        }
                        "toJSON" => {
                            if let Some(mp) = box_ref.as_any().downcast_ref::<crate::boxes::map_box::MapBox>() {
                                let s = crate::boxes::json::stringify_any(mp.clone_box());
                                Ok(VMValue::String(s))
                            } else { Err(VMError::InvalidInstruction("MapBox downcast failed".into())) }
                        }
                        _ => Err(VMError::InvalidInstruction(format!("Unknown MapBox method: {}", method))),
                    },
                        "StringBox" => Err(VMError::InvalidInstruction("Use primitive string receiver for StringBox methods".into())),
                        other => Err(VMError::InvalidInstruction(format!(
                            "Method {} not supported on BoxRef({})",
                            method, other
                        ))),
                    }
                }
            }
            _ => Err(VMError::InvalidInstruction(format!(
                "Method {} not supported on {:?}",
                method, receiver
            ))),
        }
    }
}
