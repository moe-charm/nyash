// ExternCallHandlerBox - Handle Extern function calls
// Single Responsibility: Execute external/runtime functions

using "selfhost/vm/boxes/result_box.hako" as Result
using "selfhost/hakorune-vm/value_manager.hako" as ValueManagerBox
using "selfhost/shared/common/string_helpers.hako" as StringHelpers

static box ExternCallHandlerBox {
  // Handle extern function call
  // name: extern function name (e.g., "hostbridge.box_new")
  // args_array: ArrayBox containing argument values
  // dst_reg: destination register (null if no return value)
  // regs: register MapBox
  // mem: memory MapBox
  // Returns: Result.Ok(0) or Result.Err(message)
  handle(name, args_array, dst_reg, regs, mem) {
    // Transparent delegation: forward all externs to Rust via hostbridge.
    // Phase B: All externs route through hostbridge.box_call on HostBridge trampoline
    //   instead of direct env.extern.invoke (which requires special parser support).
    // The trampoline is implemented in Rust VM (extern_handler.rs).
    if args_array == null { args_array = new ArrayBox() }

    // Route through hostbridge: split name into iface.method format
    local ret
    ret = hostbridge.extern_invoke(name, args_array)

    if dst_reg != null { ValueManagerBox.set(regs, dst_reg, ret) }
    return Result.Ok(0)
  }
}
