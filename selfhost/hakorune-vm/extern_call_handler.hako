// ExternCallHandlerBox - Handle Extern function calls
// Single Responsibility: Execute external/runtime functions

using "selfhost/vm/boxes/result_box.hako" as Result
using "selfhost/hakorune-vm/value_manager.hako" as ValueManagerBox

static box ExternCallHandlerBox {
  // Handle extern function call
  // name: extern function name (e.g., "env.console.log")
  // args_array: ArrayBox containing argument values
  // dst_reg: destination register (null if no return value)
  // regs: register MapBox
  // mem: memory MapBox
  // Returns: Result.Ok(0) or Result.Err(message)
  // Phase 1: Minimal implementation - most externs return error
  handle(name, args_array, dst_reg, regs, mem) {
    // Phase 1: No extern functions supported yet
    // Future: Implement timer, array.size, map.size, etc.

    // For now, return error for unsupported extern
    return Result.Err("extern_call: unsupported extern function: " + name)
  }

  // Future Phase 2: Add specific extern handlers
  // _handle_timer_now_ms(args_array, dst_reg, regs) { ... }
  // _handle_array_size(args_array, dst_reg, regs, mem) { ... }
  // _handle_map_size(args_array, dst_reg, regs, mem) { ... }
}
