// EmitCallBox — Return(Call name(int_args...)) を MIR(JSON v0) に最小変換
// 仕様: 各引数を const i64 として材化し、call を発行、dst を ret する。

using "apps/lib/json_native/stringify.hako" as JSON
using "apps/selfhost-compiler/common/json_emit_box.hako" as JsonEmitBox
using "selfhost/shared/mir/block_builder_box.hako" as BlockBuilder
using "selfhost/compiler/pipeline_v2/local_ssa_box.hako" as LocalSSABox
using "selfhost/compiler/pipeline_v2/regex_flow.hako" as RegexFlow
using "selfhost/compiler/pipeline_v2/stage1_args_parser_box.hako" as Stage1ArgsParserBox
using "apps/selfhost-compiler/common/header_emit_box.hako" as HeaderEmitBox
using selfhost.common.json.mir_builder_min as MirJsonBuilderMin

static box EmitCallBox {
  emit_call_int_args(name, args) {
    name = match name { null => "", _ => name }
    args = match args { null => [], _ => args }
    // ArgsParserBoxで正規化 → BlockBuilder 直結
    local vals = Stage1ArgsParserBox.parse_ints(args)
    local mod_full = BlockBuilder.global_call_ival_ret(name, vals)
    LocalSSABox.ensure_materialize_last_ret(mod_full)
    return JsonEmitBox.to_json(mod_full)
  }

  // JSON v1 (MirCall) emission — shape equivalent（CallEmitBox + HeaderEmitBox）
  emit_call_int_args_v1(name, args) {
    name = match name { null => "", _ => name }
    args = match args { null => [], _ => args }
    // 同形出力（shared builder に一本化）
    local vals = Stage1ArgsParserBox.parse_ints(args)
    local mod_full = BlockBuilder.global_call_ival_ret(name, vals)
    LocalSSABox.ensure_materialize_last_ret(mod_full)
    return JsonEmitBox.to_json(mod_full)
  }
}

static box EmitCallStub { main(args) { return 0 } }
