// dep_tree_simple.nyash — dependency tree (include + using/module) in a single static box

using selfhost.tools.dep_tree_core as Core

static box Main {
  // ---- text utils ----
  split_lines(src) {
    // return { arr, len }
        local out = new ArrayBox()
    local len = 0
    local i = 0
    local n = src.size()
    local start = 0
    loop(true) {
      if i == n { out.push(src.substring(start, i)) len = len + 1 return map({ arr: out, len: len }) }
      local ch = src.substring(i, i+1)
      if ch == "\n" { out.push(src.substring(start, i)) len = len + 1 start = i + 1 }
      i = i + 1
    }
    return map({ arr: out, len: len })
  }

  // ---- scanners ----
  scan_includes(src) {
        local out = new ArrayBox()
    local out_len = 0
    if src == null { return map({ arr: out, len: out_len }) }
    local lp = me.split_lines(src)
    local lines = lp.get("arr")
    local lines_len = lp.get("len")
    local i = 0
    loop(i < lines_len) {
      local t = lines.get(i).trim()
      if t.startsWith("include \"") {
        local rest = t.substring(9, t.size())
        local j = 0
        local q = -1
        loop(j < rest.size()) {
          if rest.substring(j, j+1) == "\"" { q = j j = rest.size() }
          j = j + 1
        }
        if q >= 0 { out.push(rest.substring(0, q)) out_len = out_len + 1 }
      }
      i = i + 1
    }
    return map({ arr: out, len: out_len })
  }

  scan_usings(src) {
    // return { arr, len }
        local out = new ArrayBox()
    local out_len = 0
    if src == null { return map({ arr: out, len: out_len }) }
    local lp = me.split_lines(src)
    local lines = lp.get("arr")
    local lines_len = lp.get("len")
    local i = 0
    loop(i < lines_len) {
      local t0 = lines.get(i).trim()
      local matched = false
      local t = t0
      if t0.startsWith("// @using ") { t = t0.substring(10, t0.size()) matched = true } else {
        if t0.startsWith("using ") { t = t0.substring(6, t0.size()) matched = true }
      }
      if matched {
        local as_pos = t.indexOf(" as ")
        local target = t
        local alias = null
        if as_pos >= 0 { target = t.substring(0, as_pos).trim() alias = t.substring(as_pos+4, t.size()).trim() }
        local rec = map({ target: target })
        if alias != null { rec.set("alias", alias) }
        if target.startsWith("./") || target.startsWith("/") || target.endsWith(".nyash") { rec.set("kind", "path") } else { rec.set("kind", "namespace") }
        out.push(rec)
        out_len = out_len + 1
      }
      i = i + 1
    }
    return map({ arr: out, len: out_len })
  }

  scan_modules(src) {
    // return { arr, len }
        local out = new ArrayBox()
    local out_len = 0
    if src == null { return map({ arr: out, len: out_len }) }
    local lp = me.split_lines(src)
    local lines = lp.get("arr")
    local lines_len = lp.get("len")
    local i = 0
    loop(i < lines_len) {
      local t = lines.get(i).trim()
      if t.startsWith("// @module ") {
        local rest = t.substring(11, t.size())
        local eq = rest.indexOf("=")
        if eq > 0 {
          local ns = rest.substring(0, eq).trim()
          local path = rest.substring(eq+1, t.size()).trim()
          local m = map({ namespace: ns, path: path })
          out.push(m)
          out_len = out_len + 1
        }
      }
      i = i + 1
    }
    return map({ arr: out, len: out_len })
  }

  default_using_paths() {
    local a = new ArrayBox()
    a.push("apps/selfhost")
    a.push("apps")
    a.push("lib")
    a.push(".")
    return a
  }

  resolve_ns(base_dir, ns) {
    local rel = ns.replace(".", "/") + ".nyash"
    local cand0 = Core.join(base_dir, rel)
    if Core.file_exists(cand0) { return cand0 }
    local paths = me.default_using_paths()
    local paths_len = 4
    local i = 0
    loop(i < paths_len) {
      local cand = Core.join(paths.get(i), rel)
      if Core.file_exists(cand) { return cand }
      i = i + 1
    }
    return null
  }

  node_for(path, visited) {
    if visited.has(path) {
      return map({
        path: path,
        children: new ArrayBox(),
        includes: new ArrayBox(),
        uses: new ArrayBox(),
        modules: new ArrayBox(),
        note: "visited"
      })
    }
    visited.set(path, true)
    local out = map({ path: path })
    local src = Core.read_all(path)
    if src == null {
      out.set("error", "read_fail")
      out.set("includes", new ArrayBox())
      out.set("uses", new ArrayBox())
      out.set("modules", new ArrayBox())
      out.set("children", new ArrayBox())
      return out
    }
    local base = Core.dirname(path)
    local incp = me.scan_includes(src)
    local incs = incp.get("arr")
    local incs_len = incp.get("len")
    local usp = me.scan_usings(src)
    local uses = usp.get("arr")
    local uses_len = usp.get("len")
    local modp = me.scan_modules(src)
    local mods = modp.get("arr")
    local mods_len = modp.get("len")
    out.set("includes", incs)
    out.set("uses", uses)
    out.set("modules", mods)
    local mod_map = map({})
    local mi = 0
    loop(mi < mods_len) {
      local mm = mods.get(mi)
      mod_map.set(mm.get("namespace"), mm.get("path"))
      mi = mi + 1
    }
    local children = new ArrayBox()
    local i = 0
    loop(i < incs_len) {
      local child_path = Core.join(base, incs.get(i))
      children.push(me.node_for(child_path, visited))
      i = i + 1
    }
    i = 0
    loop(i < uses_len) {
      local u = uses.get(i)
      if u.get("kind") == "path" {
        local p = Core.join(base, u.get("target"))
        if Core.file_exists(p) { u.set("resolved", p) children.push(me.node_for(p, visited)) } else { u.set("unresolved", true) u.set("hint", p) }
      } else {
        local tgt = u.get("target")
        local via = mod_map.get(tgt)
        if via != null {
          if Core.file_exists(via) { u.set("resolved", via) children.push(me.node_for(via, visited)) } else { u.set("unresolved", true) u.set("hint", via) }
        } else {
          local found = me.resolve_ns(base, tgt)
          if found != null { u.set("resolved", found) children.push(me.node_for(found, visited)) } else { u.set("unresolved", true) u.set("hint", tgt) }
        }
      }
      i = i + 1
    }
    out.set("children", children)
    return out
  }

  main(args) {
    local console = new ConsoleBox()
    local entry = null
    if args != null && args.size() >= 1 { entry = args.get(0) }
    if entry == null || entry == "" { entry = "apps/selfhost/ny-parser-nyash/main.nyash" }
    local visited = map({})
    local tree = me.node_for(entry, visited)
    local root = map({ version: 1, root_path: entry, tree: tree })
    console.println(root.toJson())
    return 0
  }
}
